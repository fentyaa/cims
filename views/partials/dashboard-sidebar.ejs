            <i class="bi bi-house-door"></i>
            <span>Beranda</span>
          </a>
        </li>
        <li>
          <a href="/<%= role.toLowerCase() %>/dashboard" class="<%= pagePath.includes('dashboard') ? 'active' : '' %>">
            <i class="bi bi-speedometer2"></i>
            <span>Dashboard</span>
          </a>
        </li>


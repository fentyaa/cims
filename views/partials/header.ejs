<!-- Top Navbar Header (Clean, Modern, Single-Line, No Confusing Home Sidebar) -->
<nav class="navbar navbar-dark bg-primary shadow-sm sticky-top py-2">
  <div class="container-fluid px-3 px-md-4 d-flex align-items-center justify-content-between flex-nowrap">
    <!-- Brand Logo & Name -->
    <a class="navbar-brand fw-bold d-flex align-items-center gap-2 m-0 p-0 text-white text-decoration-none user-select-none" href="/">
      <div class="brand-logo-badge bg-white bg-opacity-20 rounded-2 d-flex align-items-center justify-content-center" style="width: 34px; height: 34px;">
        <i class="bi bi-building-gear text-white fs-5"></i>
      </div>
      <div class="d-flex flex-column" style="line-height: 1.15;">
        <span class="fw-bold fs-5 tracking-tight text-white">CIMS</span>
        <span class="d-none d-sm-inline text-white-50" style="font-size: 0.725rem;">PT Cikara Bakti Nusantara</span>
      </div>
    </a>

    <!-- Navigation Actions (Right Side) -->
    <div class="d-flex align-items-center gap-2 flex-shrink-0">
      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <!-- Logged In: Tampilkan tombol Dashboard di navbar HANYA jika TIDAK sedang di Home (di Home sudah ada tombol Hero) -->
        <% if (typeof currentPath !== 'undefined' && currentPath !== '/' && currentPath !== '') { %>
          <a
            href="/<%= currentUser.role.toLowerCase() %>/dashboard"
            class="btn btn-sm btn-light text-primary fw-semibold d-inline-flex align-items-center gap-1.5 px-3 py-1.5 rounded-pill shadow-sm"
            style="font-size: 0.825rem;"
            title="Buka Dashboard"
          >
            <i class="bi bi-speedometer2"></i>
            <span>Dashboard</span>
          </a>
        <% } %>

        <!-- Profile Avatar Link -->
        <a
          href="/<%= currentUser.role.toLowerCase() %>/profil"
          class="text-decoration-none"
          title="Profil <%= currentUser.fullName %>"
        >
          <div
            class="rounded-circle bg-white bg-opacity-20 text-white fw-bold d-flex align-items-center justify-content-center border border-white border-opacity-30"
            style="width: 34px; height: 34px; font-size: 0.85rem;"
          >
            <%= currentUser.fullName ? currentUser.fullName.charAt(0).toUpperCase() : 'U' %>
          </div>
        </a>

        <!-- Logout Button -->
        <a
          href="/auth/logout"
          class="btn btn-sm btn-outline-light rounded-circle d-flex align-items-center justify-content-center p-0"
          style="width: 34px; height: 34px;"
          title="Keluar dari Akun"
          aria-label="Keluar"
        >
          <i class="bi bi-box-arrow-right fs-6"></i>
        </a>
      <% } else { %>
        <!-- Guest: Jangan tampilkan double tombol jika sedang di Home (karena Hero sudah memilikinya) -->
        <% if (typeof currentPath !== 'undefined' && currentPath !== '/' && currentPath !== '') { %>
          <a
            href="/auth/login"
            class="btn btn-sm btn-light text-primary fw-semibold px-3 py-1.5 rounded-pill shadow-sm"
            style="font-size: 0.825rem;"
          >
            <i class="bi bi-box-arrow-in-right me-1"></i>Masuk
          </a>

          <a
            href="/auth/register"
            class="btn btn-sm btn-outline-light fw-semibold px-3 py-1.5 rounded-pill d-none d-sm-inline-flex"
            style="font-size: 0.825rem;"
          >
            <i class="bi bi-person-plus me-1"></i>Daftar
          </a>
        <% } %>
      <% } %>

      <!-- Theme Toggle Button -->
      <button
        class="theme-toggle-btn text-white btn btn-link p-0 d-flex align-items-center justify-content-center border-0 text-decoration-none ms-1"
        style="width: 34px; height: 34px;"
        type="button"
        title="Ganti Tema Terang / Gelap"
        aria-label="Toggle Dark/Light Mode"
      >
        <i class="bi bi-moon-stars fs-5 theme-icon"></i>
      </button>
    </div>
  </div>
</nav>

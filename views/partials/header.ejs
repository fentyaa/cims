<nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
  <div class="container">
    <a class="navbar-brand fw-bold" href="/">
      <i class="bi bi-building-gear me-2"></i><%= typeof appName !== 'undefined' ? appName : 'IMS' %>
    </a>
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNav"
      aria-controls="navbarNav"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto">
        <!-- Public Menu (when not logged in) -->
        <% if (!currentUser) { %>
          <li class="nav-item">
            <a class="nav-link" href="/">
              <i class="bi bi-house-door me-1"></i>Home
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/auth/login">
              <i class="bi bi-box-arrow-in-right me-1"></i>Masuk
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/auth/register">
              <i class="bi bi-person-plus me-1"></i>Daftar
            </a>
          </li>
        <% } else { %>
          <!-- Authenticated Menu -->
          <li class="nav-item">
            <a class="nav-link" href="/">
              <i class="bi bi-house-door me-1"></i>Home
            </a>
          </li>

          <!-- Mentor Specific -->
          <% if (currentUser.role === 'MENTOR') { %>
            <li class="nav-item">
              <a class="nav-link" href="/mentor/dashboard">
                <i class="bi bi-speedometer2 me-1"></i>Dashboard
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/auth/approval">
                <i class="bi bi-person-check me-1"></i>Persetujuan
              </a>
            </li>
          <% } %>

          <!-- Intern Specific -->
          <% if (currentUser.role === 'INTERN') { %>
            <li class="nav-item">
              <a class="nav-link" href="/intern/dashboard">
                <i class="bi bi-speedometer2 me-1"></i>Dashboard
              </a>
            </li>
          <% } %>

          <!-- User Dropdown -->
          <li class="nav-item dropdown">
            <a
              class="nav-link dropdown-toggle"
              href="#"
              role="button"
              data-bs-toggle="dropdown"
              aria-expanded="false"
            >
              <i class="bi bi-person-circle me-1"></i>
              <%= currentUser.fullName.split(' ')[0] %>
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm rounded-3 border-0">
              <li>
                <span class="dropdown-item-text small text-muted">
                  <i class="bi bi-shield-check me-1"></i>
                  <%= currentUser.role === 'MENTOR' ? 'Mentor' : 'Peserta Magang' %>
                </span>
              </li>
              <li><hr class="dropdown-divider" /></li>
              <li>
                <a class="dropdown-item text-danger" href="/auth/logout">
                  <i class="bi bi-box-arrow-right me-1"></i>Keluar
                </a>
              </li>
            </ul>
          </li>
        <% } %>
        <!-- Theme Toggle -->
        <li class="nav-item d-flex align-items-center ms-lg-2">
          <button class="theme-toggle-btn text-white" id="themeToggleBtn" type="button" title="Ganti Tema Terang / Gelap" aria-label="Toggle Dark/Light Mode">
            <i class="bi bi-moon-stars fs-5" id="themeIcon"></i>
          </button>
        </li>
      </ul>
    </div>
  </div>
</nav>




<!-- Reset Password Page -->
<div class="auth-page-wrapper">
  <!-- Ambient background lighting -->
  <div class="auth-bg-ambient">
    <div class="auth-bg-blob-1"></div>
    <div class="auth-bg-blob-2"></div>
  </div>

  <div class="container position-relative">
    <div class="row justify-content-center">
      <div class="col-11 col-sm-9 col-md-7 col-lg-5 col-xl-4">
        <div class="auth-card">
          <!-- Top Accent Stripe -->
          <div class="auth-card-top-accent"></div>

          <div class="auth-card-body">
            <!-- Header -->
            <div class="text-center mb-4">
              <div class="auth-icon-avatar">
                <i class="bi bi-shield-lock"></i>
              </div>
              <h4 class="auth-heading">Reset Password</h4>
              <p class="auth-subtitle">Buat password baru yang aman untuk akun Anda</p>
            </div>

            <!-- Local Errors -->
            <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
              <div class="alert alert-danger alert-dismissible fade show border-0 rounded-3 small py-2 px-3 mb-3" role="alert">
                <i class="bi bi-exclamation-triangle me-1"></i>
                <ul class="mb-0 ps-3">
                  <% errors.forEach(err => { %>
                    <li><%= err %></li>
                  <% }) %>
                </ul>
                <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
              </div>
            <% } %>

            <!-- Reset Password Form -->
            <form action="/auth/reset-password/<%= typeof token !== 'undefined' ? token : '' %>" method="POST" class="needs-validation" novalidate>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">

              <!-- New Password -->
              <div class="mb-3">
                <label for="password" class="auth-label">Password Baru <span class="text-danger">*</span></label>
                <div class="auth-input-group">
                  <span class="input-icon"><i class="bi bi-lock"></i></span>
                  <input
                    type="password"
                    class="form-control"
                    id="password"
                    name="password"
                    placeholder="Minimal 8 karakter"
                    required
                    minlength="8"
                  />
                  <button
                    class="btn-toggle-pw toggle-password"
                    type="button"
                    data-target="password"
                    aria-label="Toggle password visibility"
                  >
                    <i class="bi bi-eye"></i>
                  </button>
                </div>
                <div class="auth-helper-text">
                  <i class="bi bi-info-circle me-1"></i>Minimal 8 karakter (huruf besar, kecil, angka, dan simbol).
                </div>
                <div class="invalid-feedback">Password minimal 8 karakter.</div>
              </div>

              <!-- Confirm Password -->
              <div class="mb-4">
                <label for="confirmPassword" class="auth-label">Konfirmasi Password Baru <span class="text-danger">*</span></label>
                <div class="auth-input-group">
                  <span class="input-icon"><i class="bi bi-lock-fill"></i></span>
                  <input
                    type="password"
                    class="form-control"
                    id="confirmPassword"
                    name="confirmPassword"
                    placeholder="Ulangi password baru"
                    required
                  />
                  <button
                    class="btn-toggle-pw toggle-password"
                    type="button"
                    data-target="confirmPassword"
                    aria-label="Toggle password visibility"
                  >
                    <i class="bi bi-eye"></i>
                  </button>
                </div>
                <div class="invalid-feedback">Konfirmasi password harus sama.</div>
              </div>

              <!-- Submit Button -->
              <button type="submit" class="btn-auth-primary">
                <i class="bi bi-check-circle"></i>
                <span>Simpan Password Baru</span>
              </button>
            </form>

            <!-- Back to Login -->
            <div class="text-center mt-4 pt-3 border-top">
              <a href="/auth/login" class="auth-link small">
                <i class="bi bi-arrow-left me-1"></i>Batal dan Kembali ke Login
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

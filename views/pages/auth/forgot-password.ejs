<!-- Forgot Password Page -->
<div class="auth-page-wrapper">
  <!-- Ambient background lighting -->
  <div class="auth-bg-ambient">
    <div class="auth-bg-blob-1"></div>
    <div class="auth-bg-blob-2"></div>
  </div>

  <div class="container position-relative">
    <div class="row justify-content-center">
      <div class="col-11 col-sm-9 col-md-7 col-lg-5 col-xl-4">
        <div class="auth-card">
          <!-- Top Accent Stripe -->
          <div class="auth-card-top-accent"></div>

          <div class="auth-card-body">
            <!-- Header -->
            <div class="text-center mb-4">
              <div class="auth-icon-avatar">
                <i class="bi bi-key"></i>
              </div>
              <h4 class="auth-heading">Lupa Password</h4>
              <p class="auth-subtitle">Masukkan email terdaftar untuk pemulihan akun</p>
            </div>

            <!-- Flash Messages -->
            <% if (typeof messages !== 'undefined' && messages.length > 0) { %>
              <% messages.forEach(msg => { %>
                <div class="alert alert-<%= msg.type %> alert-dismissible fade show border-0 rounded-3 small py-2 px-3 mb-3" role="alert">
                  <i class="bi bi-<%= msg.type === 'success' ? 'check-circle' : 'exclamation-circle' %> me-1"></i>
                  <%= msg.text %>
                  <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
              <% }) %>
            <% } %>

            <!-- Local Errors -->
            <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
              <div class="alert alert-danger alert-dismissible fade show border-0 rounded-3 small py-2 px-3 mb-3" role="alert">
                <i class="bi bi-exclamation-triangle me-1"></i>
                <ul class="mb-0 ps-3">
                  <% errors.forEach(err => { %>
                    <li><%= err %></li>
                  <% }) %>
                </ul>
                <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
              </div>
            <% } %>

            <!-- Success Message -->
            <% if (typeof success !== 'undefined' && success) { %>
              <div class="p-3 bg-success bg-opacity-10 border border-success border-opacity-25 rounded-3 text-center mb-4">
                <i class="bi bi-check-circle-fill text-success fs-3"></i>
                <p class="mt-2 mb-0 small fw-semibold text-success">
                  Jika email terdaftar, instruksi reset password telah dikirimkan ke email Anda.
                </p>
              </div>
              <div>
                <a href="/auth/login" class="btn-auth-primary text-decoration-none">
                  <i class="bi bi-box-arrow-in-right"></i>
                  <span>Kembali ke Login</span>
                </a>
              </div>
            <% } else { %>
              <!-- Forgot Password Form -->
              <form action="/auth/forgot-password" method="POST" class="needs-validation" novalidate>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <!-- Email -->
                <div class="mb-4">
                  <label for="email" class="auth-label">Email Terdaftar</label>
                  <div class="auth-input-group">
                    <span class="input-icon"><i class="bi bi-envelope"></i></span>
                    <input
                      type="email"
                      class="form-control"
                      id="email"
                      name="email"
                      placeholder="nama@email.com"
                      value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>"
                      required
                      autofocus
                    />
                  </div>
                  <div class="invalid-feedback">Masukkan email yang valid.</div>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn-auth-primary">
                  <i class="bi bi-send"></i>
                  <span>Kirim Link Reset</span>
                </button>
              </form>

              <!-- Back to Login -->
              <div class="text-center mt-4 pt-3 border-top">
                <a href="/auth/login" class="auth-link small">
                  <i class="bi bi-arrow-left me-1"></i>Kembali ke Halaman Login
                </a>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Nilai & Evaluasi - Intern View -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h5 class="fw-bold mb-1 text-dark">
      <i class="bi bi-award-fill me-2 text-primary"></i>Nilai & Evaluasi
    </h5>
    <p class="text-muted small mb-0">Hasil resmi evaluasi dan penilaian kinerja magang Anda</p>
  </div>
</div>

<!-- Flash Messages -->
<% if (typeof messages !== 'undefined' && messages.length > 0) { %>
  <% messages.forEach(msg => { %>
    <div class="alert alert-<%= msg.type %> alert-dismissible fade show border-0 rounded-3 small py-2 px-3 mb-3" role="alert">
      <i class="bi bi-<%= msg.type === 'success' ? 'check-circle' : 'exclamation-circle' %> me-2"></i>
      <%= msg.text %>
      <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% }) %>
<% } %>

<% if (typeof evaluation !== 'undefined' && evaluation) { %>
  <!-- Hasil Penilaian Resmi -->
  <div class="row g-4">
    <!-- Kolom Kiri: Score Summary Card -->
    <div class="col-12 col-lg-4">
      <div class="card border-0 shadow-sm rounded-4 h-100 text-center" style="border: 1px solid #e2e8f0 !important;">
        <div class="card-body p-4 d-flex flex-column justify-content-between">
          <div>
            <!-- Badge Apresiasi -->
            <div class="mb-3">
              <span class="badge bg-warning bg-opacity-20 text-dark border border-warning border-opacity-30 rounded-pill px-3 py-1 small fw-semibold">
                <i class="bi bi-trophy-fill text-warning me-1"></i>Nilai Akhir Magang
              </span>
            </div>

            <!-- Grade Letter Circle -->
            <div class="grade-badge-circle grade-<%= (evaluation.grade || 'e').toLowerCase() %> mb-3">
              <%= evaluation.grade %>
            </div>

            <!-- Final Score Display -->
            <h2 class="fw-bold text-dark mb-1">
              <%= evaluation.finalScore %> <span class="fs-6 text-muted fw-normal">/ 100</span>
            </h2>

            <!-- Predikat Capaian -->
            <% 
              let predikatText = 'Sangat Memuaskan';
              let predikatBadge = 'bg-success bg-opacity-15 text-success border-success border-opacity-25';
              if (evaluation.grade === 'B') {
                predikatText = 'Memuaskan';
                predikatBadge = 'bg-primary bg-opacity-15 text-primary border-primary border-opacity-25';
              } else if (evaluation.grade === 'C') {
                predikatText = 'Cukup';
                predikatBadge = 'bg-warning bg-opacity-20 text-dark border-warning border-opacity-25';
              } else if (evaluation.grade === 'D') {
                predikatText = 'Kurang';
                predikatBadge = 'bg-danger bg-opacity-15 text-danger border-danger border-opacity-25';
              } else if (evaluation.grade === 'E') {
                predikatText = 'Sangat Kurang';
                predikatBadge = 'bg-danger bg-opacity-15 text-danger border-danger border-opacity-25';
              }
            %>
            <div>
              <span class="badge <%= predikatBadge %> border rounded-pill px-3 py-1 small fw-semibold">
                <%= predikatText %>
              </span>
            </div>
          </div>

          <!-- Metadata Penilaian -->
          <div class="mt-4 pt-3 border-top text-start small text-muted">
            <div class="d-flex align-items-center gap-2 mb-2">
              <i class="bi bi-calendar-check text-primary"></i>
              <span>Dipublikasikan: <strong class="text-dark"><%= evaluation.publishedAt ? new Date(evaluation.publishedAt).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' }) : '-' %></strong></span>
            </div>
            <% if (evaluation.mentor) { %>
              <div class="d-flex align-items-center gap-2">
                <i class="bi bi-person-check-fill text-success"></i>
                <span>Dinilai oleh: <strong class="text-dark"><%= evaluation.mentor.fullName %></strong></span>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Kolom Kanan: Detail Nilai, Komentar, & Rekomendasi -->
    <div class="col-12 col-lg-8">
      <!-- 6 Aspek Kompetensi Card -->
      <div class="card border-0 shadow-sm rounded-4 mb-4" style="border: 1px solid #e2e8f0 !important;">
        <div class="card-header bg-transparent py-3 border-bottom">
          <h6 class="fw-bold mb-0 text-dark">
            <i class="bi bi-bar-chart-line-fill me-2 text-primary"></i>Detail 6 Aspek Kompetensi
          </h6>
        </div>
        <div class="card-body p-3 p-md-4">
          <div class="row g-3">
            <!-- 1. Kedisiplinan -->
            <% const discColor = evaluation.discipline >= 85 ? 'bg-success' : evaluation.discipline >= 75 ? 'bg-primary' : evaluation.discipline >= 65 ? 'bg-warning' : 'bg-danger'; %>
            <div class="col-12 col-md-6">
              <div class="evaluation-metric-card">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="small fw-semibold text-dark"><i class="bi bi-clock-history me-1 text-primary"></i>Kedisiplinan</span>
                  <span class="small fw-bold text-dark"><%= evaluation.discipline %> <span class="text-muted fw-normal" style="font-size: 0.75rem;">/ 100</span></span>
                </div>
                <div class="evaluation-progress-track">
                  <div class="progress-bar <%= discColor %> rounded-pill" role="progressbar" style="width: <%= evaluation.discipline %>%; height: 100%;" aria-valuenow="<%= evaluation.discipline %>" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
              </div>
            </div>

            <!-- 2. Tanggung Jawab -->
            <% const respColor = evaluation.responsibility >= 85 ? 'bg-success' : evaluation.responsibility >= 75 ? 'bg-primary' : evaluation.responsibility >= 65 ? 'bg-warning' : 'bg-danger'; %>
            <div class="col-12 col-md-6">
              <div class="evaluation-metric-card">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="small fw-semibold text-dark"><i class="bi bi-shield-check me-1 text-success"></i>Tanggung Jawab</span>
                  <span class="small fw-bold text-dark"><%= evaluation.responsibility %> <span class="text-muted fw-normal" style="font-size: 0.75rem;">/ 100</span></span>
                </div>
                <div class="evaluation-progress-track">
                  <div class="progress-bar <%= respColor %> rounded-pill" role="progressbar" style="width: <%= evaluation.responsibility %>%; height: 100%;" aria-valuenow="<%= evaluation.responsibility %>" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
              </div>
            </div>

            <!-- 3. Komunikasi -->
            <% const commColor = evaluation.communication >= 85 ? 'bg-success' : evaluation.communication >= 75 ? 'bg-primary' : evaluation.communication >= 65 ? 'bg-warning' : 'bg-danger'; %>
            <div class="col-12 col-md-6">
              <div class="evaluation-metric-card">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="small fw-semibold text-dark"><i class="bi bi-chat-dots-fill me-1 text-info"></i>Komunikasi</span>
                  <span class="small fw-bold text-dark"><%= evaluation.communication %> <span class="text-muted fw-normal" style="font-size: 0.75rem;">/ 100</span></span>
                </div>
                <div class="evaluation-progress-track">
                  <div class="progress-bar <%= commColor %> rounded-pill" role="progressbar" style="width: <%= evaluation.communication %>%; height: 100%;" aria-valuenow="<%= evaluation.communication %>" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
              </div>
            </div>

            <!-- 4. Kerjasama Tim -->
            <% const teamColor = evaluation.teamwork >= 85 ? 'bg-success' : evaluation.teamwork >= 75 ? 'bg-primary' : evaluation.teamwork >= 65 ? 'bg-warning' : 'bg-danger'; %>
            <div class="col-12 col-md-6">
              <div class="evaluation-metric-card">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="small fw-semibold text-dark"><i class="bi bi-people-fill me-1 text-warning"></i>Kerjasama Tim</span>
                  <span class="small fw-bold text-dark"><%= evaluation.teamwork %> <span class="text-muted fw-normal" style="font-size: 0.75rem;">/ 100</span></span>
                </div>
                <div class="evaluation-progress-track">
                  <div class="progress-bar <%= teamColor %> rounded-pill" role="progressbar" style="width: <%= evaluation.teamwork %>%; height: 100%;" aria-valuenow="<%= evaluation.teamwork %>" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
              </div>
            </div>

            <!-- 5. Inisiatif -->
            <% const initColor = evaluation.initiative >= 85 ? 'bg-success' : evaluation.initiative >= 75 ? 'bg-primary' : evaluation.initiative >= 65 ? 'bg-warning' : 'bg-danger'; %>
            <div class="col-12 col-md-6">
              <div class="evaluation-metric-card">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="small fw-semibold text-dark"><i class="bi bi-lightbulb-fill me-1 text-primary"></i>Inisiatif</span>
                  <span class="small fw-bold text-dark"><%= evaluation.initiative %> <span class="text-muted fw-normal" style="font-size: 0.75rem;">/ 100</span></span>
                </div>
                <div class="evaluation-progress-track">
                  <div class="progress-bar <%= initColor %> rounded-pill" role="progressbar" style="width: <%= evaluation.initiative %>%; height: 100%;" aria-valuenow="<%= evaluation.initiative %>" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
              </div>
            </div>

            <!-- 6. Keterampilan Teknis -->
            <% const techColor = evaluation.technicalSkill >= 85 ? 'bg-success' : evaluation.technicalSkill >= 75 ? 'bg-primary' : evaluation.technicalSkill >= 65 ? 'bg-warning' : 'bg-danger'; %>
            <div class="col-12 col-md-6">
              <div class="evaluation-metric-card">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="small fw-semibold text-dark"><i class="bi bi-gear-wide-connected me-1 text-secondary"></i>Keterampilan Teknis</span>
                  <span class="small fw-bold text-dark"><%= evaluation.technicalSkill %> <span class="text-muted fw-normal" style="font-size: 0.75rem;">/ 100</span></span>
                </div>
                <div class="evaluation-progress-track">
                  <div class="progress-bar <%= techColor %> rounded-pill" role="progressbar" style="width: <%= evaluation.technicalSkill %>%; height: 100%;" aria-valuenow="<%= evaluation.technicalSkill %>" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Komentar Mentor Callout -->
      <% if (evaluation.mentorComment) { %>
        <div class="eval-comment-callout mb-3">
          <div class="d-flex align-items-center gap-2 mb-2">
            <i class="bi bi-chat-quote-fill text-primary fs-5"></i>
            <h6 class="fw-bold text-primary mb-0">Catatan & Komentar Mentor</h6>
          </div>
          <p class="small text-dark mb-1"><%= evaluation.mentorComment %></p>
          <% if (evaluation.mentor) { %>
            <small class="text-muted d-block">— <%= evaluation.mentor.fullName %></small>
          <% } %>
        </div>
      <% } %>

      <!-- Rekomendasi Mentor Callout -->
      <% if (evaluation.recommendation) { %>
        <div class="eval-rec-callout mb-3">
          <div class="d-flex align-items-center gap-2 mb-2">
            <i class="bi bi-award-fill text-success fs-5"></i>
            <h6 class="fw-bold text-success mb-0">Rekomendasi Mentor</h6>
          </div>
          <p class="small text-dark mb-0"><%= evaluation.recommendation %></p>
        </div>
      <% } %>

      <!-- Skala Standar Penilaian Card -->
      <div class="card border-0 shadow-sm rounded-4" style="border: 1px solid #e2e8f0 !important;">
        <div class="card-body p-3">
          <div class="d-flex align-items-center gap-2 mb-2">
            <i class="bi bi-info-circle-fill text-primary"></i>
            <span class="small fw-bold text-dark">Panduan Skala Standar Penilaian CIMS</span>
          </div>
          <div class="d-flex flex-wrap gap-2 small">
            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-20 px-2 py-1">
              <strong>A</strong>: &ge; 85 (Sangat Memuaskan)
            </span>
            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-20 px-2 py-1">
              <strong>B</strong>: 75–84 (Memuaskan)
            </span>
            <span class="badge bg-warning bg-opacity-10 text-dark border border-warning border-opacity-20 px-2 py-1">
              <strong>C</strong>: 65–74 (Cukup)
            </span>
            <span class="badge bg-secondary bg-opacity-10 text-secondary border px-2 py-1">
              <strong>D</strong>: 50–64 (Kurang)
            </span>
            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-20 px-2 py-1">
              <strong>E</strong>: &lt; 50 (Sangat Kurang)
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
<% } else if (typeof evalMeta !== 'undefined' && evalMeta.isLockedUntilEnd) { %>
  <!-- State: Penilaian Telah Disiapkan Tapi Terkunci Hingga Akhir Periode Magang -->
  <div class="card border-0 shadow-sm rounded-4 text-center py-5 px-3" style="border: 1px solid #e2e8f0 !important;">
    <div class="card-body py-4">
      <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-inline-flex align-items-center justify-content-center p-3 mb-3" style="width: 76px; height: 76px;">
        <i class="bi bi-lock-fill fs-1"></i>
      </div>
      <h5 class="fw-bold text-dark mb-2">Penilaian Selesai Disiapkan</h5>
      <p class="text-muted small mb-3" style="max-width: 540px; margin: 0 auto;">
        Mentor telah menyelesaikan evaluasi kinerja magang Anda. Demi objektivitas dan standar operasional, hasil nilai akhir dan sertifikasi kompetensi baru akan dapat dilihat secara otomatis setelah periode magang Anda selesai.
      </p>
      <div class="d-inline-flex align-items-center gap-2 bg-light border rounded-pill px-3 py-2 small text-dark">
        <i class="bi bi-calendar-event-fill text-primary"></i>
        <span>Jadwal Buka Nilai: <strong><%= evalMeta.endDate ? new Date(evalMeta.endDate).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) : 'Hari Terakhir Magang' %></strong></span>
      </div>
    </div>
  </div>
<% } else { %>
  <!-- Empty State (Belum Ada Penilaian / Masih Draft) -->
  <div class="card border-0 shadow-sm rounded-4 text-center py-5 px-3" style="border: 1px solid #e2e8f0 !important;">
    <div class="card-body py-4">
      <div class="rounded-circle bg-warning bg-opacity-10 d-inline-flex align-items-center justify-content-center p-3 mb-3" style="width: 72px; height: 72px;">
        <i class="bi bi-award text-warning fs-1"></i>
      </div>
      <h5 class="fw-bold text-dark mb-2">Belum Ada Penilaian Resmi</h5>
      <p class="text-muted small mb-0" style="max-width: 520px; margin: 0 auto;">
        Mentor belum mempublikasikan hasil evaluasi kinerja magang Anda. Nilai akhir dan rincian kompetensi akan otomatis muncul pada halaman ini setelah diterbitkan oleh mentor dan periode magang telah selesai.
      </p>
    </div>
  </div>
<% } %>

<!-- Intern Dashboard (Final Visual QA Fix) -->

<!-- SECTION 1: Welcome Header & Internship Progress Banner -->
<div class="card border shadow-sm rounded-4 mb-4">
  <div class="card-body p-3 p-md-4">
    <div class="row align-items-center g-3">
      <!-- Greeting & Period Info -->
      <div class="col-12 col-lg-6">
        <div class="d-flex align-items-center gap-2 mb-1">
          <h5 class="fw-bold mb-0 text-dark">
            Selamat Datang, <%= typeof userName !== 'undefined' && userName ? userName.split(' ')[0] : 'Peserta' %> 👋
          </h5>
          <span class="badge bg-success bg-opacity-10 text-success rounded-pill small px-2 py-1">
            <i class="bi bi-circle-fill me-1" style="font-size: 0.45rem;"></i>Aktif
          </span>
        </div>
        <p class="text-muted small mb-0">
          <i class="bi bi-calendar-range me-1 text-primary"></i>
          <% if (typeof gamificationStats !== 'undefined' && gamificationStats.hasStructuredDates) { %>
            Periode: <strong><%= new Date(gamificationStats.startDate).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %></strong> s.d. <strong><%= new Date(gamificationStats.endDate).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %></strong>
          <% } else { %>
            Periode Magang: <span class="text-secondary"><%= typeof user !== 'undefined' && user.internshipPeriod ? user.internshipPeriod : 'Sedang Berjalan' %></span>
          <% } %>
        </p>
      </div>

      <!-- Progress Bar & Summary -->
      <div class="col-12 col-lg-6">
        <div class="p-3 bg-light rounded-3">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <span class="small fw-semibold text-muted">
              <i class="bi bi-graph-up-arrow me-1 text-primary"></i>Progres Masa Magang
            </span>
            <span class="fw-bold text-primary small">
              <%= typeof gamificationStats !== 'undefined' && gamificationStats.progress ? gamificationStats.progress.progressPercent + '%' : '0%' %>
            </span>
          </div>
          <div class="progress rounded-pill mb-1" style="height: 7px;">
            <div
              class="progress-bar bg-primary"
              role="progressbar"
              style="width: <%= typeof gamificationStats !== 'undefined' && gamificationStats.progress ? gamificationStats.progress.progressPercent : 0 %>%;"
              aria-valuenow="<%= typeof gamificationStats !== 'undefined' && gamificationStats.progress ? gamificationStats.progress.progressPercent : 0 %>"
              aria-valuemin="0"
              aria-valuemax="100"
            ></div>
          </div>
          <div class="d-flex justify-content-between align-items-center">
            <small class="text-muted" style="font-size: 0.725rem;">
              <% if (typeof gamificationStats !== 'undefined' && gamificationStats.progress) { %>
                <%= gamificationStats.progress.elapsedWorkDays %> dari <%= gamificationStats.progress.totalWorkDays %> hari kerja terlewati
              <% } else { %>
                Tanggal magang belum ditentukan
              <% } %>
            </small>
            <a href="/intern/kalender" class="text-decoration-none small text-primary fw-semibold" style="font-size: 0.725rem;">
              Lihat Kalender <i class="bi bi-arrow-right"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- DYNAMIC CONTEXT-AWARE DAILY TIP BANNER -->
<%
  const _hasPresence = typeof presensiStats !== 'undefined' && presensiStats.hasPresence;
  const _presenceStatus = _hasPresence ? presensiStats.status : null;
  const _isRedDate = typeof presensiStats !== 'undefined' && presensiStats.isRedDate;
  const _holidayLabel = typeof presensiStats !== 'undefined' && presensiStats.holidayLabel ? presensiStats.holidayLabel : 'Hari Libur';
%>

<% if (!_hasPresence && _isRedDate) { %>
  <!-- Kondisi 0: Hari Libur / Tanggal Merah (Belum / Tidak Perlu Presensi) -->
  <div class="alert border-0 rounded-3 py-2 px-3 mb-4 d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-2 shadow-sm" style="background: rgba(239, 68, 68, 0.08); border-left: 4px solid #ef4444 !important;" role="alert">
    <div class="d-flex align-items-center gap-2 small text-dark">
      <i class="bi bi-calendar-x text-danger fs-5 flex-shrink-0"></i>
      <span><strong>🚩 Hari Libur Resmi (<%= _holidayLabel %>):</strong> Hari ini adalah tanggal merah. Peserta magang libur dan tidak diwajibkan melakukan presensi kerja.</span>
    </div>
    <a href="/intern/kalender" class="btn btn-outline-danger btn-sm rounded-3 px-3 py-1 fw-semibold text-nowrap align-self-start align-self-sm-auto" style="font-size: 0.8rem;">
      <i class="bi bi-calendar3 me-1"></i>Lihat Kalender
    </a>
  </div>
<% } else if (!_hasPresence) { %>
  <!-- Kondisi 1: Hari Kerja Biasa & Belum Presensi Hari Ini -->
  <div class="alert alert-warning border-0 bg-warning bg-opacity-10 rounded-3 py-2 px-3 mb-4 d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-2 shadow-sm" role="alert">
    <div class="d-flex align-items-center gap-2 small text-dark">
      <i class="bi bi-clock-history text-warning fs-5 flex-shrink-0"></i>
      <span><strong>Pengingat Hari Ini:</strong> Anda belum mencatat presensi kehadiran. Silakan presensi sebelum memulai aktivitas magang.</span>
    </div>
    <a href="/intern/presensi" class="btn btn-warning btn-sm rounded-3 px-3 py-1 fw-semibold text-nowrap align-self-start align-self-sm-auto" style="font-size: 0.8rem;">
      <i class="bi bi-calendar-plus me-1"></i>Presensi Sekarang
    </a>
  </div>
<% } else if (_presenceStatus === 'IZIN' || _presenceStatus === 'SAKIT') { %>
  <!-- Kondisi 2: Izin atau Sakit -->
  <div class="alert alert-info border-0 bg-info bg-opacity-10 rounded-3 py-2 px-3 mb-4 d-flex align-items-center gap-2 shadow-sm" role="alert">
    <i class="bi bi-info-circle-fill text-info fs-5 flex-shrink-0"></i>
    <span class="small text-dark">
      Presensi <strong><%= _presenceStatus %></strong> Anda hari ini telah tersimpan. Semoga lekas pulih dan urusan berjalan lancar.
    </span>
  </div>
<% } else { %>
  <!-- Kondisi 3: Sudah Presensi (WFO / WFH) -->
  <div class="alert alert-success border-0 bg-success bg-opacity-10 rounded-3 py-2 px-3 mb-4 d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-2 shadow-sm" role="alert">
    <div class="d-flex align-items-center gap-2 small text-dark">
      <i class="bi bi-check-circle-fill text-success fs-5 flex-shrink-0"></i>
      <span><strong>Kehadiran Tercatat:</strong> Presensi <%= _presenceStatus %> hari ini sudah tersimpan. Pastikan jurnal logbook Anda tetap terisi rapi.</span>
    </div>
    <a href="/intern/logbook" class="btn btn-outline-success btn-sm rounded-3 px-3 py-1 fw-semibold text-nowrap align-self-start align-self-sm-auto" style="font-size: 0.8rem;">
      <i class="bi bi-journal-text me-1"></i>Cek Logbook
    </a>
  </div>
<% } %>

<!-- SECTION 2: DAILY OPERATIONS HUB (2 Columns) -->
<div class="row g-3 mb-4">
  <!-- LEFT COLUMN: Aktivitas & Rutinitas Hari Ini -->
  <div class="col-12 col-lg-6">
    <div class="card border shadow-sm rounded-4 h-100">
      <div class="card-header bg-transparent py-3 border-bottom d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0 text-dark">
          <i class="bi bi-check2-square text-primary me-2"></i>Aktivitas Hari Ini
        </h6>
        <span class="badge bg-light text-muted border small">Rutinitas Harian</span>
      </div>
      <div class="card-body p-3 d-flex flex-column justify-content-between gap-3">
        <!-- 1. Presensi Hari Ini Item -->
        <div class="p-3 rounded-3 border bg-card-subtle d-flex align-items-center justify-content-between gap-2">
          <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle <%= _hasPresence ? 'bg-success bg-opacity-10 text-success' : 'bg-warning bg-opacity-10 text-warning' %> p-3 d-flex align-items-center justify-content-center" style="width: 46px; height: 46px; flex-shrink: 0;">
              <i class="bi bi-<%= _hasPresence ? 'calendar-check-fill' : 'clock-history' %> fs-5"></i>
            </div>
            <div>
              <div class="small text-muted fw-semibold mb-0">Presensi Kehadiran</div>
              <% if (_hasPresence) { %>
                <div class="d-flex align-items-center gap-1 mt-1">
                  <% if (_presenceStatus === 'WFO') { %>
                    <span class="badge bg-success bg-opacity-15 text-success border border-success border-opacity-25 rounded-pill px-2 py-1">🏢 WFO (Work From Office)</span>
                  <% } else if (_presenceStatus === 'WFH') { %>
                    <span class="badge bg-info bg-opacity-15 text-info border border-info border-opacity-25 rounded-pill px-2 py-1">🏠 WFH (Work From Home)</span>
                  <% } else if (_presenceStatus === 'IZIN') { %>
                    <span class="badge bg-warning bg-opacity-15 text-warning-emphasis border border-warning border-opacity-25 rounded-pill px-2 py-1">📋 Izin</span>
                  <% } else if (_presenceStatus === 'SAKIT') { %>
                    <span class="badge bg-danger bg-opacity-15 text-danger border border-danger border-opacity-25 rounded-pill px-2 py-1">🏥 Sakit</span>
                  <% } %>
                </div>
              <% } else { %>
                <span class="badge bg-secondary bg-opacity-10 text-secondary border rounded-pill px-2 py-1 mt-1">⚪ Belum Presensi Hari Ini</span>
              <% } %>
            </div>
          </div>
          <div>
            <% if (!_hasPresence) { %>
              <a href="/intern/presensi" class="btn btn-primary btn-sm rounded-3 px-3 py-1 text-nowrap fw-semibold">
                <i class="bi bi-plus-circle me-1"></i>Presensi
              </a>
            <% } else { %>
              <a href="/intern/presensi" class="btn btn-outline-secondary btn-sm rounded-3 px-2 py-1 text-nowrap" style="font-size: 0.75rem;">
                Lihat
              </a>
            <% } %>
          </div>
        </div>

        <!-- 2. Logbook Hari Ini Item -->
        <div class="p-3 rounded-3 border bg-card-subtle d-flex align-items-center justify-content-between gap-2">
          <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3 d-flex align-items-center justify-content-center" style="width: 46px; height: 46px; flex-shrink: 0;">
              <i class="bi bi-journal-text fs-5"></i>
            </div>
            <div>
              <div class="small text-muted fw-semibold mb-0">Logbook Aktivitas</div>
              <div class="mt-1">
                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-20 rounded-pill px-2 py-1">
                  📝 Jurnal Aktivitas Harian
                </span>
              </div>
            </div>
          </div>
          <div>
            <a href="/intern/logbook" class="btn btn-outline-primary btn-sm rounded-3 px-3 py-1 text-nowrap fw-semibold">
              <i class="bi bi-pencil-square me-1"></i>Tulis Logbook
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- RIGHT COLUMN: KONSISTENSI & STREAK HUB -->
  <div class="col-12 col-lg-6">
    <div class="card border shadow-sm rounded-4 h-100">
      <div class="card-header bg-transparent py-3 border-bottom d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0 text-dark">
          <i class="bi bi-fire text-warning me-2"></i>Keaktifan & Konsistensi
        </h6>
        <span class="badge bg-warning bg-opacity-15 text-dark border border-warning border-opacity-25 rounded-pill small">
          <i class="bi bi-stars me-1 text-warning"></i>Konsistensi Magang
        </span>
      </div>
      <div class="card-body p-3">
        <!-- 3 Metrics Grid -->
        <div class="row g-2 mb-3">
          <!-- Current Streak -->
          <div class="col-4">
            <div class="p-2 p-sm-3 rounded-3 text-center h-100 bg-card-subtle border">
              <small class="text-muted fw-semibold d-block" style="font-size: 0.75rem;">Streak Aktif</small>
              <h4 class="fw-bold mb-0 mt-1" style="color: #d97706;">
                🔥 <%= typeof gamificationStats !== 'undefined' ? gamificationStats.currentStreak : 0 %>
              </h4>
              <small class="text-muted" style="font-size: 0.7rem;">
                <%= typeof gamificationStats !== 'undefined' && gamificationStats.currentStreak > 0 ? 'Hari Beruntun' : 'Mulai Konsistensi' %>
              </small>
            </div>
          </div>

          <!-- Best Streak -->
          <div class="col-4">
            <div class="p-2 p-sm-3 rounded-3 text-center h-100 bg-card-subtle border">
              <small class="text-muted fw-semibold d-block" style="font-size: 0.75rem;">Rekor Streak</small>
              <h4 class="fw-bold text-dark mb-0 mt-1">
                🏆 <%= typeof gamificationStats !== 'undefined' ? gamificationStats.bestStreak : 0 %>
              </h4>
              <small class="text-muted" style="font-size: 0.7rem;">Paling Panjang</small>
            </div>
          </div>

          <!-- Total Active Days -->
          <div class="col-4">
            <div class="p-2 p-sm-3 rounded-3 text-center h-100 bg-card-subtle border">
              <small class="text-muted fw-semibold d-block" style="font-size: 0.75rem;">Hari Aktif</small>
              <h4 class="fw-bold text-success mb-0 mt-1">
                📅 <%= typeof gamificationStats !== 'undefined' ? gamificationStats.activeDays : 0 %>
              </h4>
              <small class="text-muted" style="font-size: 0.7rem;">WFO + WFH</small>
            </div>
          </div>
        </div>

        <!-- Achievements Tray -->
        <% if (typeof gamificationStats !== 'undefined' && gamificationStats.achievements && gamificationStats.achievements.length > 0) { %>
          <div class="pt-2 border-top">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <small class="text-muted fw-semibold" style="font-size: 0.775rem;">
                <i class="bi bi-award me-1 text-primary"></i>Pencapaian Magang:
              </small>
            </div>
            <div class="d-flex flex-wrap gap-1">
              <% gamificationStats.achievements.forEach(a => { %>
                <% if (a.unlocked) { %>
                  <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-2 py-1" title="<%= a.description %> (Tercapai)" style="font-size: 0.725rem;">
                    <%= a.icon %> <%= a.title %>
                  </span>
                <% } else { %>
                  <span class="badge bg-light text-muted border rounded-pill px-2 py-1" title="<%= a.description %> (Belum Tercapai)" style="font-size: 0.725rem; opacity: 0.65;">
                    <%= a.icon %> <%= a.title %>
                  </span>
                <% } %>
              <% }) %>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- SECTION 3: OVERVIEW (Logbook Summary & Evaluation) -->
<div class="row g-3 mb-4">
  <!-- Logbook Summary -->
  <div class="col-12 col-md-6">
    <div class="card border shadow-sm rounded-4 h-100">
      <div class="card-header bg-transparent py-3 border-bottom d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0 text-dark">
          <i class="bi bi-journal-check text-primary me-2"></i>Ringkasan Logbook
        </h6>
        <a href="/intern/logbook" class="btn btn-sm btn-outline-primary rounded-3 px-2 py-1" style="font-size: 0.75rem;">
          Lihat Semua
        </a>
      </div>
      <div class="card-body p-3">
        <div class="row g-2 text-center">
          <div class="col-4">
            <div class="p-2 bg-primary bg-opacity-10 rounded-3 border border-primary border-opacity-15">
              <h4 class="fw-bold text-primary mb-0"><%= typeof logbookStats !== 'undefined' ? logbookStats.total || 0 : 0 %></h4>
              <small class="text-muted" style="font-size: 0.725rem;">Total Log</small>
            </div>
          </div>
          <div class="col-4">
            <div class="p-2 bg-warning bg-opacity-10 rounded-3 border border-warning border-opacity-15">
              <h4 class="fw-bold text-warning mb-0"><%= typeof logbookStats !== 'undefined' ? logbookStats.pending || 0 : 0 %></h4>
              <small class="text-muted" style="font-size: 0.725rem;">Menunggu</small>
            </div>
          </div>
          <div class="col-4">
            <div class="p-2 bg-success bg-opacity-10 rounded-3 border border-success border-opacity-15">
              <h4 class="fw-bold text-success mb-0"><%= typeof logbookStats !== 'undefined' ? logbookStats.reviewed || 0 : 0 %></h4>
              <small class="text-muted" style="font-size: 0.725rem;">Direview</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Evaluation Status -->
  <div class="col-12 col-md-6">
    <div class="card border shadow-sm rounded-4 h-100">
      <div class="card-header bg-transparent py-3 border-bottom d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0 text-dark">
          <i class="bi bi-star-fill text-warning me-2"></i>Penilaian Mentor
        </h6>
        <a href="/intern/nilai" class="btn btn-sm btn-outline-primary rounded-3 px-2 py-1" style="font-size: 0.75rem;">
          Detail Nilai
        </a>
      </div>
      <div class="card-body p-3">
        <% if (typeof evalStatus !== 'undefined' && evalStatus.hasEvaluation && !evalStatus.isLockedUntilEnd && evalStatus.status === 'PUBLISHED') { %>
          <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle bg-<%= evalStatus.grade === 'A' ? 'success' : evalStatus.grade === 'B' ? 'primary' : evalStatus.grade === 'C' ? 'warning' : 'danger' %> bg-opacity-10 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; flex-shrink: 0;">
              <span class="fw-bold text-<%= evalStatus.grade === 'A' ? 'success' : evalStatus.grade === 'B' ? 'primary' : evalStatus.grade === 'C' ? 'warning' : 'danger' %> fs-4"><%= evalStatus.grade %></span>
            </div>
            <div>
              <h6 class="fw-bold mb-0 text-dark">Skor Akhir: <%= evalStatus.finalScore %></h6>
              <span class="badge bg-success bg-opacity-15 text-success rounded-pill px-2 py-0 mt-1" style="font-size: 0.7rem;">
                Telah Dipublikasikan
              </span>
            </div>
          </div>
        <% } else if (typeof evalStatus !== 'undefined' && evalStatus.isLockedUntilEnd) { %>
          <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; flex-shrink: 0;">
              <i class="bi bi-lock-fill fs-4"></i>
            </div>
            <div>
              <h6 class="fw-bold mb-0 text-dark" style="font-size: 0.875rem;">Penilaian Disiapkan</h6>
              <small class="text-muted d-block" style="font-size: 0.75rem;">
                Dapat dilihat setelah masa magang selesai (<%= evalStatus.endDate ? new Date(evalStatus.endDate).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : 'Akhir Periode' %>).
              </small>
            </div>
          </div>
        <% } else { %>
          <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle bg-secondary bg-opacity-10 text-muted d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; flex-shrink: 0;">
              <i class="bi bi-hourglass-split fs-4"></i>
            </div>
            <div>
              <h6 class="fw-bold mb-0 text-dark" style="font-size: 0.9rem;">Belum Ada Penilaian</h6>
              <small class="text-muted" style="font-size: 0.775rem;">Penilaian akan diberikan oleh mentor pada akhir periode magang.</small>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- SECTION 4: QUICK ACCESS -->
<div class="card border shadow-sm rounded-4">
  <div class="card-header bg-transparent py-3 border-bottom">
    <h6 class="fw-bold mb-0 text-dark">
      <i class="bi bi-grid-fill text-primary me-2"></i>Akses Cepat Modul
    </h6>
  </div>
  <div class="card-body p-3">
    <div class="d-flex flex-wrap gap-2">
      <a href="/intern/presensi" class="compact-action-pill">
        <i class="bi bi-calendar-check-fill text-primary"></i>
        <span>Presensi</span>
      </a>
      <a href="/intern/kalender" class="compact-action-pill">
        <i class="bi bi-calendar3 text-info"></i>
        <span>Kalender</span>
      </a>
      <a href="/intern/logbook" class="compact-action-pill">
        <i class="bi bi-journal-text text-warning"></i>
        <span>Logbook</span>
      </a>
      <a href="/intern/nilai" class="compact-action-pill">
        <i class="bi bi-star-fill text-danger"></i>
        <span>Nilai</span>
      </a>
      <a href="/intern/profil" class="compact-action-pill">
        <i class="bi bi-person-circle text-secondary"></i>
        <span>Profil</span>
      </a>
    </div>
  </div>
</div>

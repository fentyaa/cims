<!-- Intern Dashboard - Modern Visual Data-Driven UI (Anti-Text Heavy) -->

<%
  const _hasPresence = typeof presensiStats !== 'undefined' && presensiStats.hasPresence;
  const _presenceStatus = _hasPresence ? presensiStats.status : null;
  const _isRedDate = typeof presensiStats !== 'undefined' && presensiStats.isRedDate;
  const _holidayLabel = typeof presensiStats !== 'undefined' && presensiStats.holidayLabel ? presensiStats.holidayLabel : 'Hari Libur';

  const _progress = typeof gamificationStats !== 'undefined' && gamificationStats.progress
    ? gamificationStats.progress
    : { progressPercent: 0, elapsedWorkDays: 0, totalWorkDays: 0 };

  const _streak = typeof gamificationStats !== 'undefined' ? gamificationStats.currentStreak : 0;
  const _bestStreak = typeof gamificationStats !== 'undefined' ? gamificationStats.bestStreak : 0;
  const _activeDays = typeof gamificationStats !== 'undefined' ? gamificationStats.activeDays : 0;
  const _achievements = typeof gamificationStats !== 'undefined' && gamificationStats.achievements ? gamificationStats.achievements : [];

  const _log = typeof logbookStats !== 'undefined' ? logbookStats : { total: 0, pending: 0, reviewed: 0 };
  const _eval = typeof evalStatus !== 'undefined' ? evalStatus : { hasEvaluation: false, isLockedUntilEnd: false, status: 'NONE' };
%>

  <!-- STATUS / ABSENCE NOTIFICATION BANNERS -->
  <% if (typeof status !=='undefined' && status==='ARCHIVED' ) { %>
    <div class="alert alert-danger border-0 rounded-4 shadow-sm mb-4 d-flex align-items-start gap-3 p-3">
      <div
        class="avatar-circle bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center p-2"
        style="width: 44px; height: 44px; min-width: 44px;">
        <i class="bi bi-person-x-fill fs-4"></i>
      </div>
      <div class="flex-grow-1">
        <h6 class="fw-bold mb-1 text-danger">Status Akun: Dinonaktifkan (Archived)</h6>
        <p class="mb-0 small text-dark">
          <% if (typeof absenceInfo !=='undefined' && absenceInfo && absenceInfo.consecutiveDays>= 3) { %>
            Anda dinyatakan <strong>tidak melanjutkan magang</strong> karena tidak melakukan presensi atau memberikan
            kabar selama 3 hari kerja berturut-turut sesuai dengan kebijakan operasional magang. Silakan hubungi mentor
            atau koordinator Anda jika terdapat kekeliruan.
            <% } else { %>
              Akun magang Anda saat ini berstatus Archived (telah menyelesaikan atau tidak lagi aktif dalam program
              magang). Hubungi pihak penyelenggara/mentor untuk informasi lebih lanjut.
              <% } %>
        </p>
      </div>
    </div>
    <% } else if (typeof absenceInfo !=='undefined' && absenceInfo && absenceInfo.consecutiveDays> 0) { %>
      <div class="alert alert-warning border-0 rounded-4 shadow-sm mb-4 d-flex align-items-start gap-3 p-3">
        <div
          class="avatar-circle bg-warning bg-opacity-10 text-warning-emphasis rounded-circle d-flex align-items-center justify-content-center p-2"
          style="width: 44px; height: 44px; min-width: 44px;">
          <i class="bi bi-exclamation-triangle-fill fs-4"></i>
        </div>
        <div class="flex-grow-1">
          <h6 class="fw-bold mb-1 text-warning-emphasis">Peringatan Presensi: <%= absenceInfo.consecutiveDays %> Hari
              Kerja Tanpa Keterangan</h6>
          <p class="mb-0 small text-dark">
            Sistem mencatat Anda tidak melakukan presensi atau mengajukan izin selama <strong>
              <%= absenceInfo.consecutiveDays %> hari kerja berturut-turut
            </strong>.
            <br>
            <span class="text-danger fw-semibold">Penting:</span> Aturan magang menetapkan bahwa peserta yang tidak ada
            kabar/presensi selama <strong>3 hari kerja berturut-turut</strong> akan secara otomatis dianggap
            <strong>tidak melanjutkan magang (Drop-Out)</strong> dan akun dinonaktifkan. Segera lakukan presensi atau
            hubungi mentor Anda!
          </p>
        </div>
      </div>
      <% } %>

        <!-- 1. COMPACT HERO: GREETING, STATUS PILL & CIRCULAR PROGRESS -->
        <div class="card border shadow-sm rounded-4 mb-4 bg-white">
          <div class="card-body p-3 p-md-4">
            <div class="row align-items-center g-3">
              <!-- Greeting & Current Presence Pill -->
              <div class="col-12 col-lg-7">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                  <h4 class="fw-bold mb-0 text-dark">
                    Halo, <%= typeof userName !=='undefined' && userName ? userName.split(' ')[0] : ' Peserta' %> 👋
                  </h4>
                  <span
                    class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-2 py-1 small">
                    <%= typeof participantType !=='undefined' && participantType==='UNIVERSITY' ? 'Mahasiswa'
                      : 'Siswa SMK' %>
                  </span>
                </div>

                <!-- Inline Status Pill (Replaces Long Alert Banner) -->
                <div class="d-flex flex-wrap align-items-center gap-2">
                  <% if (_isRedDate) { %>
                    <div
                      class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 small fw-semibold">
                      <i class="bi bi-calendar-x"></i>
                      <span>Hari Libur Resmi (<%= _holidayLabel %>)</span>
                    </div>
                    <% } else if (!_hasPresence) { %>
                      <div
                        class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-warning bg-opacity-15 text-warning-emphasis border border-warning border-opacity-25 small fw-semibold">
                        <span class="spinner-grow spinner-grow-sm text-warning" role="status"
                          style="width: 8px; height: 8px;"></span>
                        <span>Belum Presensi Hari Ini</span>
                      </div>
                      <a href="/intern/presensi" class="btn btn-primary btn-sm rounded-pill px-3 py-1 fw-semibold"
                        style="font-size: 0.8rem;">
                        <i class="bi bi-calendar-check me-1"></i>Presensi Sekarang
                      </a>
                      <% } else { %>
                        <div
                          class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-success bg-opacity-15 text-success border border-success border-opacity-25 small fw-semibold">
                          <i class="bi bi-check-circle-fill"></i>
                          <span>Kehadiran Tercatat: <%= _presenceStatus %></span>
                        </div>
                        <% } %>
                </div>
              </div>

              <!-- Internship Progress Ring & Summary -->
              <div class="col-12 col-lg-5">
                <div class="p-3 bg-light rounded-4 d-flex align-items-center gap-3">
                  <!-- Circular Conic Meter -->
                  <div class="position-relative d-flex align-items-center justify-content-center flex-shrink-0"
                    style="width: 58px; height: 58px; border-radius: 50%; background: conic-gradient(#2563eb <%= _progress.progressPercent %>%, #e2e8f0 0);">
                    <div
                      class="rounded-circle bg-white d-flex align-items-center justify-content-center fw-bold text-primary small"
                      style="width: 44px; height: 44px; font-size: 0.75rem;">
                      <%= _progress.progressPercent %>%
                    </div>
                  </div>
                  <div class="flex-grow-1">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                      <span class="small fw-bold text-dark">Progres Magang</span>
                      <a href="/intern/kalender" class="small text-primary text-decoration-none fw-semibold"
                        style="font-size: 0.75rem;">
                        Kalender &rarr;
                      </a>
                    </div>
                    <div class="small text-muted" style="font-size: 0.75rem;">
                      <%= _progress.elapsedWorkDays %> dari <%= _progress.totalWorkDays %> hari kerja terlewati
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 2. DUAL OPERATION CARDS: LOGBOOK & EVALUASI -->
        <div class="row g-3 mb-4">
          <!-- Left: Logbook Summary & Action -->
          <div class="col-12 col-md-6">
            <div class="card border shadow-sm rounded-4 h-100 bg-white">
              <div
                class="card-header bg-transparent py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                  <i class="bi bi-journal-text text-warning"></i>
                  <span>Jurnal Logbook Saya</span>
                </h6>
                <a href="/intern/logbook" class="btn btn-sm btn-primary rounded-pill px-3 py-1 fw-semibold"
                  style="font-size: 0.75rem;">
                  <i class="bi bi-pencil-square me-1"></i>Tulis Logbook
                </a>
              </div>
              <div class="card-body p-3">
                <div class="row g-2 text-center mb-3">
                  <div class="col-4">
                    <div class="p-2 rounded-3 bg-light border">
                      <h4 class="fw-bold text-dark mb-0">
                        <%= _log.total %>
                      </h4>
                      <small class="text-muted" style="font-size: 0.7rem;">Total Entri</small>
                    </div>
                  </div>
                  <div class="col-4">
                    <div class="p-2 rounded-3 bg-warning bg-opacity-10 border border-warning border-opacity-25">
                      <h4 class="fw-bold text-warning-emphasis mb-0">
                        <%= _log.pending %>
                      </h4>
                      <small class="text-muted" style="font-size: 0.7rem;">Menunggu Review</small>
                    </div>
                  </div>
                  <div class="col-4">
                    <div class="p-2 rounded-3 bg-success bg-opacity-10 border border-success border-opacity-25">
                      <h4 class="fw-bold text-success mb-0">
                        <%= _log.reviewed %>
                      </h4>
                      <small class="text-muted" style="font-size: 0.7rem;">Disetujui Mentor</small>
                    </div>
                  </div>
                </div>
                <div class="d-flex justify-content-between align-items-center small text-muted px-1">
                  <span>Pastikan aktivitas harian Anda selalu dilaporkan tepat waktu.</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Right: Evaluasi Nilai Akhir -->
          <div class="col-12 col-md-6">
            <div class="card border shadow-sm rounded-4 h-100 bg-white">
              <div
                class="card-header bg-transparent py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                  <i class="bi bi-award-fill text-info"></i>
                  <span>Penilaian Akhir Magang</span>
                </h6>
                <a href="/intern/nilai" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1"
                  style="font-size: 0.75rem;">
                  Detail Nilai
                </a>
              </div>
              <div class="card-body p-3 d-flex align-items-center">
                <% if (_eval.hasEvaluation && !_eval.isLockedUntilEnd && _eval.status==='PUBLISHED' ) { %>
                  <div class="d-flex align-items-center gap-3 w-100 p-2">
                    <div
                      class="rounded-circle bg-<%= _eval.grade === 'A' ? 'success' : _eval.grade === 'B' ? 'primary' : 'warning' %> bg-opacity-15 text-<%= _eval.grade === 'A' ? 'success' : _eval.grade === 'B' ? 'primary' : 'warning' %> d-flex align-items-center justify-content-center fw-bold fs-3"
                      style="width: 58px; height: 58px; flex-shrink: 0;">
                      <%= _eval.grade %>
                    </div>
                    <div>
                      <h6 class="fw-bold mb-0 text-dark">Skor Akhir: <%= _eval.finalScore %> / 100</h6>
                      <span class="badge bg-success bg-opacity-15 text-success rounded-pill small mt-1">
                        Telah Dipublikasikan Mentor
                      </span>
                    </div>
                  </div>
                  <% } else if (_eval.isLockedUntilEnd) { %>
                    <div class="d-flex align-items-center gap-3 w-100 p-2 text-muted">
                      <div
                        class="rounded-circle bg-light border d-flex align-items-center justify-content-center text-muted"
                        style="width: 54px; height: 54px; flex-shrink: 0;">
                        <i class="bi bi-lock-fill fs-4"></i>
                      </div>
                      <div>
                        <h6 class="fw-bold mb-1 text-dark small">Penilaian Terkunci</h6>
                        <small class="text-muted">Nilai akan dibuka otomatis setelah masa magang berakhir.</small>
                      </div>
                    </div>
                    <% } else { %>
                      <div class="d-flex align-items-center gap-3 w-100 p-2 text-muted">
                        <div
                          class="rounded-circle bg-light border d-flex align-items-center justify-content-center text-muted"
                          style="width: 54px; height: 54px; flex-shrink: 0;">
                          <i class="bi bi-hourglass-split fs-4"></i>
                        </div>
                        <div>
                          <h6 class="fw-bold mb-1 text-dark small">Belum Dinilai</h6>
                          <small class="text-muted">Evaluasi akhir akan disusun oleh mentor pembimbing.</small>
                        </div>
                      </div>
                      <% } %>
              </div>
            </div>
          </div>
        </div>

        <!-- 4. GAMIFICATION STREAK & ACHIEVEMENTS -->
        <div class="card border shadow-sm rounded-4 mb-4 bg-white">
          <div class="card-body p-3 p-md-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                <i class="bi bi-fire text-danger"></i>
                <span>Konsistensi & Pencapaian</span>
              </h6>
              <span
                class="badge bg-warning bg-opacity-15 text-warning-emphasis border border-warning border-opacity-25 rounded-pill px-2 py-1 small">
                Streak Aktif: <%= _streak %> Hari
              </span>
            </div>

            <!-- 3 Mini Counters -->
            <div class="row g-2 mb-3">
              <div class="col-4">
                <div class="p-2 rounded-3 bg-light text-center border">
                  <small class="text-muted d-block" style="font-size: 0.725rem;">Streak Saat Ini</small>
                  <div class="fw-bold fs-5 text-danger">🔥 <%= _streak %>
                  </div>
                  <small class="text-muted" style="font-size: 0.65rem;">Hari Beruntun</small>
                </div>
              </div>
              <div class="col-4">
                <div class="p-2 rounded-3 bg-light text-center border">
                  <small class="text-muted d-block" style="font-size: 0.725rem;">Rekor Streak</small>
                  <div class="fw-bold fs-5 text-warning-emphasis">🏆 <%= _bestStreak %>
                  </div>
                  <small class="text-muted" style="font-size: 0.65rem;">Terpanjang</small>
                </div>
              </div>
              <div class="col-4">
                <div class="p-2 rounded-3 bg-light text-center border">
                  <small class="text-muted d-block" style="font-size: 0.725rem;">Hari Hadir</small>
                  <div class="fw-bold fs-5 text-success">📅 <%= _activeDays %>
                  </div>
                  <small class="text-muted" style="font-size: 0.65rem;">WFO + WFH</small>
                </div>
              </div>
            </div>

            <!-- Badges Tray -->
            <% if (_achievements.length> 0) { %>
              <div class="d-flex flex-wrap gap-1">
                <% _achievements.forEach(a=> { %>
                  <span
                    class="badge <%= a.unlocked ? 'bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25' : 'bg-light text-muted border opacity-50' %> rounded-pill px-2 py-1"
                    title="<%= a.description %>" style="font-size: 0.725rem;">
                    <%= a.icon %>
                      <%= a.title %>
                  </span>
                  <% }) %>
              </div>
              <% } %>
          </div>
        </div>
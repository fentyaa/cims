<!-- Intern Logbook Page -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h5 class="fw-bold mb-1 text-dark">
      <i class="bi bi-journal-text me-2 text-primary"></i>Logbook Harian
    </h5>
    <p class="text-muted small mb-0">Catat aktivitas dan progres harian Anda selama periode magang</p>
  </div>
</div>

<!-- Flash Messages -->
<% if (typeof messages !== 'undefined' && messages.length > 0) { %>
  <% messages.forEach(msg => { %>
    <div class="alert alert-<%= msg.type %> alert-dismissible fade show border-0 rounded-3 small py-2 px-3 mb-3" role="alert">
      <i class="bi bi-<%= msg.type === 'success' ? 'check-circle' : 'exclamation-circle' %> me-2"></i>
      <%= msg.text %>
      <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% }) %>
<% } %>

<div class="row g-4">
  <!-- Kolom Kiri: Form & Status Logbook Hari Ini -->
  <div class="col-12 col-lg-5">
    <div class="card border-0 shadow-sm rounded-4 h-100" style="border: 1px solid #e2e8f0 !important;">
      <div class="card-header bg-transparent py-3 border-bottom d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0 text-dark">
          <% if (typeof todayLogbook !== 'undefined' && todayLogbook && todayLogbook.status === 'REVIEWED') { %>
            <i class="bi bi-patch-check-fill text-success me-2"></i>Logbook Terverifikasi
          <% } else if (typeof todayLogbook !== 'undefined' && todayLogbook) { %>
            <i class="bi bi-pencil-square text-primary me-2"></i>Edit Logbook Hari Ini
          <% } else { %>
            <i class="bi bi-plus-circle-fill text-primary me-2"></i>Buat Logbook Hari Ini
          <% } %>
        </h6>
        <% if (typeof todayLogbook !== 'undefined' && todayLogbook && todayLogbook.status === 'REVIEWED') { %>
          <span class="badge bg-success bg-opacity-15 text-success border border-success border-opacity-25 rounded-pill px-2 py-1 small">
            ✅ Direview
          </span>
        <% } else if (typeof todayLogbook !== 'undefined' && todayLogbook) { %>
          <span class="badge bg-warning bg-opacity-20 text-dark border border-warning border-opacity-25 rounded-pill px-2 py-1 small">
            ⏳ Menunggu Review
          </span>
        <% } else { %>
          <span class="badge bg-light text-muted border rounded-pill px-2 py-1 small">
            Harian
          </span>
        <% } %>
      </div>

      <div class="card-body p-3 p-md-4 d-flex flex-column justify-content-between">
        <div>
          <!-- Tanggal Hari Ini Mini-Banner -->
          <div class="d-flex align-items-center gap-2 p-2 px-3 bg-light rounded-3 border mb-3">
            <i class="bi bi-calendar3 text-primary"></i>
            <span class="small fw-semibold text-dark">
              <%= new Date().toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %>
            </span>
          </div>

          <!-- Local Errors -->
          <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
            <div class="alert alert-danger alert-dismissible fade show border-0 rounded-3 small py-2 px-3 mb-3" role="alert">
              <i class="bi bi-exclamation-triangle me-1"></i>
              <ul class="mb-0 ps-3">
                <% errors.forEach(err => { %>
                  <li><%= err %></li>
                <% }) %>
              </ul>
              <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% } %>

          <% if (typeof todayLogbook !== 'undefined' && todayLogbook && todayLogbook.status === 'REVIEWED') { %>
            <!-- Skenario A: Sudah Direview (Readonly) -->
            <div class="p-3 bg-success bg-opacity-10 border border-success border-opacity-20 rounded-3 text-center mb-3">
              <i class="bi bi-check-circle-fill text-success fs-3"></i>
              <h6 class="fw-bold text-success mt-2 mb-1">Logbook Sudah Direview Mentor</h6>
              <p class="text-muted small mb-0">Catatan aktivitas hari ini telah diverifikasi dan terkunci.</p>
            </div>

            <!-- Aktivitas Display -->
            <div class="mb-3">
              <label class="logbook-field-label">
                <i class="bi bi-list-check text-primary"></i>Aktivitas Hari Ini
              </label>
              <div class="p-3 bg-light border rounded-3 small text-dark">
                <%= todayLogbook.activity %>
              </div>
            </div>

            <!-- Kendala Display -->
            <% if (todayLogbook.obstacle) { %>
              <div class="mb-3">
                <label class="logbook-field-label">
                  <i class="bi bi-exclamation-triangle text-warning"></i>Kendala yang Dihadapi
                </label>
                <div class="p-3 bg-light border rounded-3 small text-secondary">
                  <%= todayLogbook.obstacle %>
                </div>
              </div>
            <% } %>

            <!-- Rencana Display -->
            <% if (todayLogbook.nextPlan) { %>
              <div class="mb-3">
                <label class="logbook-field-label">
                  <i class="bi bi-calendar-range text-info"></i>Rencana Besok
                </label>
                <div class="p-3 bg-light border rounded-3 small text-secondary">
                  <%= todayLogbook.nextPlan %>
                </div>
              </div>
            <% } %>

            <!-- Komentar Mentor Callout -->
            <% if (todayLogbook.mentorComment) { %>
              <div class="mentor-comment-box mb-3">
                <div class="d-flex align-items-center gap-2 mb-1">
                  <i class="bi bi-chat-quote-fill text-success"></i>
                  <strong class="text-success small">Catatan & Komentar Mentor:</strong>
                </div>
                <p class="small text-dark mb-0"><%= todayLogbook.mentorComment %></p>
              </div>
            <% } %>

          <% } else if (typeof todayLogbook !== 'undefined' && todayLogbook) { %>
            <!-- Skenario B: Edit Form (Status: PENDING) -->
            <form action="/intern/logbook/<%= todayLogbook.id %>/update" method="POST" class="needs-validation" novalidate>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">

              <!-- Aktivitas -->
              <div class="mb-3">
                <label for="activity" class="logbook-field-label">
                  <i class="bi bi-list-check text-primary"></i>Aktivitas Hari Ini <span class="text-danger">*</span>
                </label>
                <textarea
                  class="form-control logbook-input"
                  id="activity"
                  name="activity"
                  rows="3"
                  placeholder="Jelaskan aktivitas atau tugas yang dikerjakan hari ini..."
                  required
                  minlength="5"
                ><%= typeof formData !== 'undefined' && formData.activity ? formData.activity : todayLogbook.activity %></textarea>
                <div class="text-muted small mt-1" style="font-size: 0.75rem;">
                  <i class="bi bi-info-circle me-1"></i>Minimal 5 karakter.
                </div>
                <div class="invalid-feedback">Aktivitas minimal 5 karakter.</div>
              </div>

              <!-- Kendala -->
              <div class="mb-3">
                <label for="obstacle" class="logbook-field-label">
                  <i class="bi bi-exclamation-triangle text-warning"></i>Kendala yang Dihadapi <span class="text-muted fw-normal">(Opsional)</span>
                </label>
                <textarea
                  class="form-control logbook-input"
                  id="obstacle"
                  name="obstacle"
                  rows="2"
                  placeholder="Tuliskan kendala atau tantangan jika ada..."
                ><%= typeof formData !== 'undefined' && formData.obstacle ? formData.obstacle : (todayLogbook.obstacle || '') %></textarea>
              </div>

              <!-- Rencana Besok -->
              <div class="mb-3">
                <label for="nextPlan" class="logbook-field-label">
                  <i class="bi bi-calendar-range text-info"></i>Rencana Besok <span class="text-muted fw-normal">(Opsional)</span>
                </label>
                <textarea
                  class="form-control logbook-input"
                  id="nextPlan"
                  name="nextPlan"
                  rows="2"
                  placeholder="Rencana tugas untuk hari kerja berikutnya..."
                ><%= typeof formData !== 'undefined' && formData.nextPlan ? formData.nextPlan : (todayLogbook.nextPlan || '') %></textarea>
              </div>

              <div class="d-flex flex-wrap align-items-center gap-2 mt-4">
                <button type="submit" class="btn btn-primary rounded-3 fw-semibold px-4 py-2 flex-grow-1">
                  <i class="bi bi-save me-1"></i>Simpan Perubahan
                </button>
              </div>
            </form>

          <% } else { %>
            <!-- Skenario C: Create Form -->
            <form action="/intern/logbook/create" method="POST" class="needs-validation" novalidate>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">

              <!-- Aktivitas -->
              <div class="mb-3">
                <label for="activity" class="logbook-field-label">
                  <i class="bi bi-list-check text-primary"></i>Aktivitas Hari Ini <span class="text-danger">*</span>
                </label>
                <textarea
                  class="form-control logbook-input"
                  id="activity"
                  name="activity"
                  rows="3"
                  placeholder="Jelaskan aktivitas atau tugas yang diselesaikan hari ini..."
                  required
                  minlength="5"
                ><%= typeof formData !== 'undefined' && formData.activity ? formData.activity : '' %></textarea>
                <div class="text-muted small mt-1" style="font-size: 0.75rem;">
                  <i class="bi bi-info-circle me-1"></i>Minimal 5 karakter.
                </div>
                <div class="invalid-feedback">Aktivitas minimal 5 karakter.</div>
              </div>

              <!-- Kendala -->
              <div class="mb-3">
                <label for="obstacle" class="logbook-field-label">
                  <i class="bi bi-exclamation-triangle text-warning"></i>Kendala yang Dihadapi <span class="text-muted fw-normal">(Opsional)</span>
                </label>
                <textarea
                  class="form-control logbook-input"
                  id="obstacle"
                  name="obstacle"
                  rows="2"
                  placeholder="Tuliskan kendala atau tantangan jika ada..."
                ><%= typeof formData !== 'undefined' && formData.obstacle ? formData.obstacle : '' %></textarea>
              </div>

              <!-- Rencana Besok -->
              <div class="mb-3">
                <label for="nextPlan" class="logbook-field-label">
                  <i class="bi bi-calendar-range text-info"></i>Rencana Besok <span class="text-muted fw-normal">(Opsional)</span>
                </label>
                <textarea
                  class="form-control logbook-input"
                  id="nextPlan"
                  name="nextPlan"
                  rows="2"
                  placeholder="Rencana tugas untuk hari kerja berikutnya..."
                ><%= typeof formData !== 'undefined' && formData.nextPlan ? formData.nextPlan : '' %></textarea>
              </div>

              <button type="submit" class="btn btn-primary w-100 rounded-3 fw-semibold py-2 mt-4">
                <i class="bi bi-plus-circle-fill me-2"></i>Buat Logbook
              </button>
            </form>
          <% } %>
        </div>

        <!-- Subtle Gamification Hint -->
        <div class="p-2 px-3 mt-3 rounded-3" style="background: rgba(37, 99, 235, 0.05); border: 1px solid rgba(37, 99, 235, 0.15);">
          <small class="text-primary fw-semibold d-block" style="font-size: 0.75rem;">
            💡 <strong>Tips:</strong> Pencatatan logbook harian yang konsisten mempermudah penilaian akhir oleh mentor Anda.
          </small>
        </div>
      </div>
    </div>
  </div>

  <!-- Kolom Kanan: Riwayat Logbook -->
  <div class="col-12 col-lg-7">
    <div class="card border-0 shadow-sm rounded-4 h-100" style="border: 1px solid #e2e8f0 !important;">
      <div class="card-header bg-transparent py-3 border-bottom d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0 text-dark">
          <i class="bi bi-clock-history me-2 text-primary"></i>Riwayat Logbook
        </h6>
        <% if (typeof pagination !== 'undefined' && pagination.total > 0) { %>
          <span class="badge bg-light text-muted border rounded-pill px-3 py-1 small">
            Total: <%= pagination.total %> Catatan
          </span>
        <% } %>
      </div>

      <div class="card-body p-3 p-md-4">
        <% if (typeof logbooks !== 'undefined' && logbooks.length > 0) { %>
          <!-- Desktop Table -->
          <div class="table-responsive d-none d-lg-block">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th class="ps-3 text-muted small fw-bold" style="width: 25%;">Tanggal</th>
                  <th class="text-muted small fw-bold">Aktivitas</th>
                  <th class="pe-3 text-muted small fw-bold text-end" style="width: 20%;">Status</th>
                </tr>
              </thead>
              <tbody>
                <% logbooks.forEach(log => { %>
                  <tr>
                    <td class="ps-3 text-nowrap small fw-semibold text-dark">
                      <%= new Date(log.date).toLocaleDateString('id-ID', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' }) %>
                    </td>
                    <td class="small text-dark">
                      <%= log.activity.length > 70 ? log.activity.substring(0, 70) + '...' : log.activity %>
                    </td>
                    <td class="pe-3 text-end">
                      <% if (log.status === 'REVIEWED') { %>
                        <span class="badge bg-success bg-opacity-15 text-success border border-success border-opacity-25 rounded-pill px-3 py-1" style="font-size: 0.725rem;">
                          <i class="bi bi-check-circle-fill me-1"></i>Direview
                        </span>
                      <% } else { %>
                        <span class="badge bg-warning bg-opacity-20 text-dark border border-warning border-opacity-25 rounded-pill px-3 py-1" style="font-size: 0.725rem;">
                          <i class="bi bi-hourglass-split me-1"></i>Menunggu
                        </span>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

          <!-- Mobile Card List -->
          <div class="d-lg-none">
            <% logbooks.forEach(log => { %>
              <div class="card border mb-2 rounded-3 logbook-history-card" style="background: #fbfcfe;">
                <div class="card-body p-3">
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <strong class="small text-dark">
                      <i class="bi bi-calendar3 me-1 text-primary"></i>
                      <%= new Date(log.date).toLocaleDateString('id-ID', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' }) %>
                    </strong>
                    <% if (log.status === 'REVIEWED') { %>
                      <span class="badge bg-success bg-opacity-15 text-success border border-success border-opacity-25 rounded-pill px-2 py-1" style="font-size: 0.7rem;">
                        <i class="bi bi-check-circle-fill me-1"></i>Direview
                      </span>
                    <% } else { %>
                      <span class="badge bg-warning bg-opacity-20 text-dark border border-warning border-opacity-25 rounded-pill px-2 py-1" style="font-size: 0.7rem;">
                        <i class="bi bi-hourglass-split me-1"></i>Menunggu
                      </span>
                    <% } %>
                  </div>
                  <p class="small text-secondary mb-0">
                    <%= log.activity.length > 90 ? log.activity.substring(0, 90) + '...' : log.activity %>
                  </p>
                </div>
              </div>
            <% }) %>
          </div>

          <!-- Pagination -->
          <% if (typeof pagination !== 'undefined' && pagination.totalPages > 1) { %>
            <nav class="mt-4">
              <ul class="pagination pagination-sm justify-content-center mb-0 gap-1">
                <% for (let p = 1; p <= pagination.totalPages; p++) { %>
                  <li class="page-item <%= pagination.page === p ? 'active' : '' %>">
                    <a class="page-link rounded-pill px-3 py-1" href="/intern/logbook?page=<%= p %>"><%= p %></a>
                  </li>
                <% } %>
              </ul>
            </nav>
          <% } %>
        <% } else { %>
          <div class="text-center py-5">
            <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center p-3 mb-2" style="width: 56px; height: 56px;">
              <i class="bi bi-journal-text text-muted fs-3"></i>
            </div>
            <h6 class="fw-bold text-dark mt-2 mb-1">Belum Ada Riwayat Logbook</h6>
            <p class="text-muted small mb-0">Catatan aktivitas magang harian Anda akan terdaftar di sini.</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

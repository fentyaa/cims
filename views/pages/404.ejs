<!-- 404 Error Page - Halaman Tidak Ditemukan (Phase 4 Polish) -->

<div class="row justify-content-center my-4 my-md-5">
  <div class="col-12 col-md-10 col-lg-8 text-center">
    <div class="error-card-modern">
      <!-- Status Badge -->
      <div>
        <span class="error-status-badge bg-warning bg-opacity-10 text-warning-emphasis border border-warning border-opacity-25">
          <i class="bi bi-compass"></i>
          <span>Status 404 • Halaman Tidak Ditemukan</span>
        </span>
      </div>

      <!-- Icon Visual Illustration -->
      <div class="error-icon-wrapper bg-warning bg-opacity-10 text-warning-emphasis">
        <i class="bi bi-map"></i>
      </div>

      <!-- Error Title -->
      <h2 class="fw-bold text-dark mb-2">
        Rute Tidak Ditemukan
      </h2>

      <!-- Reassuring Description -->
      <p class="text-muted small mx-auto mb-4" style="max-width: 440px; line-height: 1.6;">
        Sepertinya alamat atau halaman yang Anda tuju telah berpindah, dinonaktifkan, atau mengambil rute yang berbeda.
      </p>

      <!-- Recovery Actions -->
      <div class="d-flex flex-column flex-sm-row justify-content-center align-items-center gap-2 mb-4">
        <a href="/" class="btn btn-primary rounded-3 px-4 py-2 fw-semibold d-inline-flex align-items-center justify-content-center gap-2 shadow-sm w-100 w-sm-auto">
          <i class="bi bi-house-door"></i>
          <span>Halaman Utama</span>
        </a>
        <button type="button" onclick="if (window.history.length > 1) { window.history.back(); } else { window.location.href = '/'; }" class="btn btn-outline-secondary rounded-3 px-4 py-2 fw-semibold d-inline-flex align-items-center justify-content-center gap-2 w-100 w-sm-auto">
          <i class="bi bi-arrow-left"></i>
          <span>Kembali</span>
        </button>
      </div>

      <!-- Helpful Shortcut Links -->
      <div class="pt-3 border-top d-flex flex-wrap justify-content-center align-items-center gap-3 text-muted small">
        <span class="text-secondary">Tautan Cepat:</span>
        <a href="/auth/login" class="text-decoration-none text-primary fw-medium">Masuk Akun</a>
        <span class="text-secondary">•</span>
        <a href="/auth/register" class="text-decoration-none text-primary fw-medium">Daftar Baru</a>
        <span class="text-secondary">•</span>
        <a href="/auth/forgot-password" class="text-decoration-none text-primary fw-medium">Lupa Kata Sandi</a>
      </div>
    </div>
  </div>
</div>

<!-- Halaman Home - Internship Management System (Modern Visual SaaS Style) -->

<style>
  .hero-main-title {
    font-size: 1.5rem;
    line-height: 1.3;
    letter-spacing: -0.4px;
  }
  .hero-main-subtitle {
    font-size: 0.9rem;
    line-height: 1.55;
    max-width: 620px;
  }
  @media (min-width: 768px) {
    .hero-main-title {
      font-size: 2.2rem;
      line-height: 1.25;
      letter-spacing: -0.6px;
    }
    .hero-main-subtitle {
      font-size: 1.05rem;
    }
  }
  .home-feature-pill {
    font-size: 0.775rem;
    padding: 0.4rem 0.85rem;
  }
  @media (max-width: 576px) {
    .home-feature-pill {
      font-size: 0.725rem;
      padding: 0.35rem 0.65rem;
    }
  }
</style>

<!-- 1. HERO SECTION: VISUAL & IMPACTFUL -->
<div class="card border shadow-sm rounded-4 mb-4 bg-white overflow-hidden">
  <div class="card-body p-3 p-sm-4 p-md-5 text-center position-relative">
    <!-- Brand Badge -->
    <div class="mb-3">
      <span class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 small fw-semibold">
        <i class="bi bi-building-gear"></i>
        <span>Internship Management System</span>
      </span>
    </div>

    <!-- Main Headline (Responsive Sizing) -->
    <h1 class="hero-main-title fw-bold text-dark mb-3">
      Kelola Program Magang Lebih <span class="text-primary">Terstruktur & Transparan</span>
    </h1>

    <!-- Subtitle (Responsive Sizing) -->
    <p class="hero-main-subtitle text-muted mx-auto mb-4">
      Platform terpadu untuk Mahasiswa & Siswa PKL SMK di <strong>PT Cikara Bakti Nusantara</strong> dalam memantau presensi, menyusun logbook, dan menerbitkan evaluasi kompetensi secara otomatis.
    </p>

    <!-- Quick CTA & Action Pills -->
    <div class="d-flex flex-wrap justify-content-center gap-2 mb-4">
      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <a href="/<%= currentUser.role.toLowerCase() %>/dashboard" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm">
          <i class="bi bi-speedometer2"></i>
          <span>Buka Dashboard Saya</span>
        </a>
      <% } else { %>
        <a href="/auth/login" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm">
          <i class="bi bi-box-arrow-in-right"></i>
          <span>Masuk ke Akun</span>
        </a>
        <a href="/auth/register" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2">
          <i class="bi bi-person-plus-fill"></i>
          <span>Daftar Peserta Magang</span>
        </a>
      <% } %>
    </div>

    <!-- Feature Pills (Responsive Badges) -->
    <div class="d-flex flex-wrap justify-content-center align-items-center gap-2 gap-md-3 pt-3 border-top text-muted small">
      <span class="badge bg-light text-dark border rounded-pill home-feature-pill fw-normal d-inline-flex align-items-center gap-1">
        <i class="bi bi-lightning-charge-fill text-warning"></i> Presensi Cepat WFO / WFH
      </span>
      <span class="badge bg-light text-dark border rounded-pill home-feature-pill fw-normal d-inline-flex align-items-center gap-1">
        <i class="bi bi-journal-text text-primary"></i> Jurnal Logbook Harian
      </span>
      <span class="badge bg-light text-dark border rounded-pill home-feature-pill fw-normal d-inline-flex align-items-center gap-1">
        <i class="bi bi-calendar3 text-info"></i> Kalender Libur Nasional
      </span>
      <span class="badge bg-light text-dark border rounded-pill home-feature-pill fw-normal d-inline-flex align-items-center gap-1">
        <i class="bi bi-star-fill text-warning"></i> Penilaian Kompetensi
      </span>
    </div>
  </div>
</div>

<!-- 2. WORKFLOW STEPPER: 3 LANGKAH ALUR MAGANG (CONNECTED VISUAL PIPELINE) -->
<div class="card border shadow-sm rounded-4 mb-4 bg-white">
  <div class="card-body p-4">
    <div class="text-center mb-4">
      <h5 class="fw-bold text-dark mb-1">Alur Magang Terintegrasi</h5>
      <p class="text-muted small mb-0">Tiga tahapan operasional dari registrasi hingga evaluasi capaian akhir</p>
    </div>

    <div class="row g-3 text-center">
      <!-- Step 1 -->
      <div class="col-12 col-md-4">
        <div class="p-3 rounded-4 bg-light h-100 border">
          <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold mx-auto mb-2" style="width: 42px; height: 42px;">
            1
          </div>
          <h6 class="fw-bold text-dark mb-1">Registrasi & Verifikasi</h6>
          <p class="text-muted small mb-0">Pendaftaran akun peserta dan verifikasi berkas oleh mentor pembimbing.</p>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="col-12 col-md-4">
        <div class="p-3 rounded-4 bg-light h-100 border">
          <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center fw-bold mx-auto mb-2" style="width: 42px; height: 42px;">
            2
          </div>
          <h6 class="fw-bold text-dark mb-1">Presensi & Logbook</h6>
          <p class="text-muted small mb-0">Pencatatan presensi kerja harian dan pelaporan aktivitas logbook berkala.</p>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="col-12 col-md-4">
        <div class="p-3 rounded-4 bg-light h-100 border">
          <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center fw-bold mx-auto mb-2" style="width: 42px; height: 42px;">
            3
          </div>
          <h6 class="fw-bold text-dark mb-1">Evaluasi Capaian</h6>
          <p class="text-muted small mb-0">Penilaian kompetensi terstandar 6 parameter dan rekapitulasi nilai akhir.</p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- 3. CORE FEATURES GRID: 4 TILES (CLEAN & MODERN) -->
<div class="row g-3 mb-4">
  <!-- Tile 1 -->
  <div class="col-12 col-sm-6 col-lg-3">
    <div class="card border shadow-sm rounded-4 h-100 bg-white p-3">
      <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3 d-inline-flex align-items-center justify-content-center mb-3" style="width: 48px; height: 48px;">
        <i class="bi bi-calendar-check-fill fs-5"></i>
      </div>
      <h6 class="fw-bold text-dark mb-1">Presensi Presisi</h6>
      <p class="text-muted small mb-0">Dukungan status WFO, WFH, Izin, dan Sakit dengan sinkronisasi kalender hari libur.</p>
    </div>
  </div>

  <!-- Tile 2 -->
  <div class="col-12 col-sm-6 col-lg-3">
    <div class="card border shadow-sm rounded-4 h-100 bg-white p-3">
      <div class="rounded-circle bg-warning bg-opacity-15 text-warning-emphasis p-3 d-inline-flex align-items-center justify-content-center mb-3" style="width: 48px; height: 48px;">
        <i class="bi bi-journal-check fs-5"></i>
      </div>
      <h6 class="fw-bold text-dark mb-1">Review Logbook</h6>
      <p class="text-muted small mb-0">Umpan balik langsung dari pembimbing industri untuk memantau kualitas kerja harian.</p>
    </div>
  </div>

  <!-- Tile 3 -->
  <div class="col-12 col-sm-6 col-lg-3">
    <div class="card border shadow-sm rounded-4 h-100 bg-white p-3">
      <div class="rounded-circle bg-info bg-opacity-10 text-info p-3 d-inline-flex align-items-center justify-content-center mb-3" style="width: 48px; height: 48px;">
        <i class="bi bi-award-fill fs-5"></i>
      </div>
      <h6 class="fw-bold text-dark mb-1">Evaluasi Capaian</h6>
      <p class="text-muted small mb-0">Standarisasi lembar nilai 6 parameter kompetensi magang yang objektif dan terukur.</p>
    </div>
  </div>

  <!-- Tile 4 -->
  <div class="col-12 col-sm-6 col-lg-3">
    <div class="card border shadow-sm rounded-4 h-100 bg-white p-3">
      <div class="rounded-circle bg-success bg-opacity-10 text-success p-3 d-inline-flex align-items-center justify-content-center mb-3" style="width: 48px; height: 48px;">
        <i class="bi bi-file-earmark-bar-graph-fill fs-5"></i>
      </div>
      <h6 class="fw-bold text-dark mb-1">Laporan & Rekap</h6>
      <p class="text-muted small mb-0">Perekapan komprehensif data presensi, logbook aktivitas, dan riwayat peserta.</p>
    </div>
  </div>
</div>

<!-- 4. TRUST & SECURITY STRIP -->
<div class="card border shadow-sm rounded-4 bg-white p-3">
  <div class="d-flex flex-column flex-md-row align-items-center justify-content-between gap-2 text-center text-md-start">
    <div class="d-flex align-items-center gap-3">
      <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
        <i class="bi bi-shield-check-fill fs-5"></i>
      </div>
      <div>
        <h6 class="fw-bold mb-0 text-dark">Sistem Terlindungi & Standar Industri</h6>
        <small class="text-muted">Autentikasi sesi aman, proteksi CSRF, kontrol akses RBAC, dan penyimpanan data terenkripsi.</small>
      </div>
    </div>
    <span class="badge bg-light text-muted border rounded-pill px-3 py-2 small">
      PT Cikara Bakti Nusantara
    </span>
  </div>
</div>

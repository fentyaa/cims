<!-- Manajemen Peserta -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h5 class="fw-bold mb-1 text-dark">
      <i class="bi bi-people-fill me-2 text-primary"></i>Manajemen Peserta
    </h5>
    <p class="text-muted small mb-0">Kelola data peserta magang (Mahasiswa & PKL SMK)</p>
  </div>
</div>

<!-- Flash Messages -->
<% if (typeof messages !== 'undefined' && messages.length > 0) { %>
  <% messages.forEach(msg => { %>
    <div class="alert alert-<%= msg.type %> alert-dismissible fade show border-0 rounded-3" role="alert">
      <i class="bi bi-<%= msg.type === 'success' ? 'check-circle' : 'exclamation-circle' %> me-2"></i>
      <%= msg.text %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% }) %>
<% } %>

<!-- Search & Filter Section -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
  <div class="card-body p-3 p-md-4">
    <form method="GET" action="/mentor/peserta" class="row g-3 align-items-end" id="filterForm">
      <!-- Search -->
      <div class="col-12 col-md-4">
        <label class="form-label small fw-semibold">Cari</label>
        <div class="input-group input-group-sm">
          <span class="input-group-text bg-light border-end-0">
            <i class="bi bi-search text-muted"></i>
          </span>
          <input
            type="text"
            class="form-control bg-light border-start-0"
            name="search"
            id="searchInput"
            placeholder="Nama, Email, Universitas, Sekolah, NIM..."
            value="<%= filters.search %>"
          />
        </div>
      </div>

      <!-- Filter Jenis -->
      <div class="col-6 col-md-3">
        <label class="form-label small fw-semibold">Jenis Peserta</label>
        <select class="form-select form-select-sm" name="type" id="typeFilter">
          <option value="">Semua</option>
          <option value="UNIVERSITY" <%= filters.type === 'UNIVERSITY' ? 'selected' : '' %>>Mahasiswa</option>
          <option value="SMK" <%= filters.type === 'SMK' ? 'selected' : '' %>>PKL SMK</option>
        </select>
      </div>

      <!-- Filter Status -->
      <div class="col-6 col-md-3">
        <label class="form-label small fw-semibold">Status</label>
        <select class="form-select form-select-sm" name="status" id="statusFilter">
          <option value="">Semua</option>
          <option value="PENDING" <%= filters.status === 'PENDING' ? 'selected' : '' %>>Pending</option>
          <option value="ACTIVE" <%= filters.status === 'ACTIVE' ? 'selected' : '' %>>Active</option>
          <option value="REJECTED" <%= filters.status === 'REJECTED' ? 'selected' : '' %>>Rejected</option>
          <option value="ARCHIVED" <%= filters.status === 'ARCHIVED' ? 'selected' : '' %>>Archived</option>
        </select>
      </div>

      <!-- Buttons -->
      <div class="col-12 col-md-2">
        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-primary btn-sm w-100">
            <i class="bi bi-funnel me-1"></i>Filter
          </button>
          <a href="/mentor/peserta" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-x-lg"></i>
          </a>
        </div>
      </div>
    </form>
  </div>
</div>

<!-- Desktop Table View -->
<div class="d-none d-md-block">
  <div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-3" style="width: 50px;">Foto</th>
              <th>Nama</th>
              <th>Jenis</th>
              <th>Instansi</th>
              <th>Prodi/Jurusan</th>
              <th>Mentor</th>
              <th>Status Akun</th>
              <th>Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (participants.length === 0) { %>
              <tr>
                <td colspan="8" class="text-center py-5 text-muted">
                  <i class="bi bi-inbox" style="font-size: 2rem;"></i>
                  <p class="mt-2 mb-0">Tidak ada data peserta.</p>
                </td>
              </tr>
            <% } else { %>
              <% participants.forEach(p => { %>
                <tr>
                  <td class="ps-3">
                    <div class="avatar-circle <%= p.status === 'ACTIVE' ? 'bg-success' : p.status === 'PENDING' ? 'bg-warning' : 'bg-secondary' %> bg-opacity-10 d-flex align-items-center justify-content-center rounded-circle" style="width: 40px; height: 40px;">
                      <% if (p.profilePhoto) { %>
                        <img src="/uploads/<%= p.profilePhoto %>" alt="<%= p.fullName %>" class="rounded-circle w-100 h-100" style="object-fit: cover;" />
                      <% } else { %>
                        <i class="bi bi-person-fill <%= p.status === 'ACTIVE' ? 'text-success' : p.status === 'PENDING' ? 'text-warning' : 'text-secondary' %>"></i>
                      <% } %>
                    </div>
                  </td>
                  <td>
                    <a href="/mentor/peserta/<%= p.id %>" class="text-decoration-none fw-semibold">
                      <%= p.fullName %>
                    </a>
                    <br />
                    <small class="text-muted"><%= p.email %></small>
                  </td>
                  <td>
                    <span class="badge bg-info bg-opacity-10 text-info">
                      <%= p.participantType === 'UNIVERSITY' ? 'Mahasiswa' : 'PKL SMK' %>
                    </span>
                  </td>
                  <td>
                    <%= p.participantType === 'UNIVERSITY' ? (p.university || '-') : (p.schoolName || '-') %>
                  </td>
                  <td>
                    <%= p.participantType === 'UNIVERSITY' ? (p.studyProgram || '-') : (p.major || '-') %>
                  </td>
                  <td>
                    <small><%= p.mentor ? p.mentor.fullName : '<span class="text-muted">-</span>' %></small>
                  </td>
                  <td>
                    <% if (p.status === 'ACTIVE') { %>
                      <span class="badge bg-success">Active</span>
                    <% } else if (p.status === 'PENDING') { %>
                      <span class="badge bg-warning text-dark">Pending</span>
                    <% } else if (p.status === 'REJECTED') { %>
                      <span class="badge bg-danger">Rejected</span>
                    <% } else if (p.status === 'ARCHIVED') { %>
                      <span class="badge bg-secondary">Archived</span>
                    <% } %>
                  </td>
                  <td>
                    <div class="d-flex gap-1">
                      <a href="/mentor/peserta/<%= p.id %>" class="btn btn-sm btn-outline-primary rounded-3" title="Detail">
                        <i class="bi bi-eye"></i>
                      </a>
                      <a href="/mentor/peserta/<%= p.id %>/edit" class="btn btn-sm btn-outline-warning rounded-3" title="Edit">
                        <i class="bi bi-pencil"></i>
                      </a>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Mobile Card View -->
<div class="d-md-none">
  <% if (participants.length === 0) { %>
    <div class="text-center py-5">
      <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
      <p class="text-muted mt-2">Tidak ada data peserta.</p>
    </div>
  <% } else { %>
    <div class="row g-3">
      <% participants.forEach(p => { %>
        <div class="col-12">
          <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body p-3">
              <div class="d-flex align-items-center mb-3">
                <div class="avatar-circle <%= p.status === 'ACTIVE' ? 'bg-success' : p.status === 'PENDING' ? 'bg-warning' : 'bg-secondary' %> bg-opacity-10 d-flex align-items-center justify-content-center rounded-circle me-3" style="width: 48px; height: 48px; min-width: 48px;">
                  <% if (p.profilePhoto) { %>
                    <img src="/uploads/<%= p.profilePhoto %>" alt="<%= p.fullName %>" class="rounded-circle w-100 h-100" style="object-fit: cover;" />
                  <% } else { %>
                    <i class="bi bi-person-fill fs-4 <%= p.status === 'ACTIVE' ? 'text-success' : p.status === 'PENDING' ? 'text-warning' : 'text-secondary' %>"></i>
                  <% } %>
                </div>
                <div>
                  <h6 class="fw-bold mb-0"><%= p.fullName %></h6>
                  <small class="text-muted"><%= p.email %></small>
                </div>
              </div>
              <div class="row g-1 small text-muted mb-3">
                <div class="col-6">
                  <span class="badge bg-info bg-opacity-10 text-info">
                    <%= p.participantType === 'UNIVERSITY' ? 'Mahasiswa' : 'PKL SMK' %>
                  </span>
                </div>
                <div class="col-6 text-end">
                  <% if (p.status === 'ACTIVE') { %>
                    <span class="badge bg-success">Active</span>
                  <% } else if (p.status === 'PENDING') { %>
                    <span class="badge bg-warning text-dark">Pending</span>
                  <% } else if (p.status === 'REJECTED') { %>
                    <span class="badge bg-danger">Rejected</span>
                  <% } else if (p.status === 'ARCHIVED') { %>
                    <span class="badge bg-secondary">Archived</span>
                  <% } %>
                </div>
                <div class="col-12 mt-1">
                  <i class="bi bi-building me-1"></i><%= p.participantType === 'UNIVERSITY' ? (p.university || '-') : (p.schoolName || '-') %>
                </div>
                <div class="col-12">
                  <i class="bi bi-book me-1"></i><%= p.participantType === 'UNIVERSITY' ? (p.studyProgram || '-') : (p.major || '-') %>
                </div>
                <div class="col-12">
                  <i class="bi bi-person-badge me-1"></i>Mentor: <%= p.mentor ? p.mentor.fullName : '-' %>
                </div>
              </div>
              <div class="d-flex gap-2">
                <a href="/mentor/peserta/<%= p.id %>" class="btn btn-sm btn-outline-primary flex-fill rounded-3">
                  <i class="bi bi-eye me-1"></i>Detail
                </a>
                <a href="/mentor/peserta/<%= p.id %>/edit" class="btn btn-sm btn-outline-warning flex-fill rounded-3">
                  <i class="bi bi-pencil me-1"></i>Edit
                </a>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<!-- Pagination -->
<% if (pagination.totalPages > 0) { %>
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mt-4 gap-2">
    <small class="text-muted">
      Menampilkan <%= ((pagination.page - 1) * pagination.limit) + 1 %> - 
      <%= Math.min(pagination.page * pagination.limit, pagination.total) %> 
      dari <%= pagination.total %> peserta
    </small>
    <nav>
      <ul class="pagination pagination-sm mb-0">
        <li class="page-item <%= pagination.hasPrev ? '' : 'disabled' %>">
          <a class="page-link" href="?page=<%= pagination.page - 1 %><%= filters.search ? '&search=' + filters.search : '' %><%= filters.type ? '&type=' + filters.type : '' %><%= filters.status ? '&status=' + filters.status : '' %>">
            <i class="bi bi-chevron-left"></i>
          </a>
        </li>
        <% for (let i = 1; i <= pagination.totalPages; i++) { %>
          <li class="page-item <%= i === pagination.page ? 'active' : '' %>">
            <a class="page-link" href="?page=<%= i %><%= filters.search ? '&search=' + filters.search : '' %><%= filters.type ? '&type=' + filters.type : '' %><%= filters.status ? '&status=' + filters.status : '' %>">
              <%= i %>
            </a>
          </li>
        <% } %>
        <li class="page-item <%= pagination.hasNext ? '' : 'disabled' %>">
          <a class="page-link" href="?page=<%= pagination.page + 1 %><%= filters.search ? '&search=' + filters.search : '' %><%= filters.type ? '&type=' + filters.type : '' %><%= filters.status ? '&status=' + filters.status : '' %>">
            <i class="bi bi-chevron-right"></i>
          </a>
        </li>
      </ul>
    </nav>
  </div>
<% } %>

<script>
// Real-time search with debounce
let searchTimeout;
document.getElementById('searchInput')?.addEventListener('input', function() {
  clearTimeout(searchTimeout);
  searchTimeout = setTimeout(() => {
    document.getElementById('filterForm').submit();
  }, 600);
});

// Auto-submit on filter change
document.getElementById('typeFilter')?.addEventListener('change', function() {
  document.getElementById('filterForm').submit();
});
document.getElementById('statusFilter')?.addEventListener('change', function() {
  document.getElementById('filterForm').submit();
});
</script>

<!-- Mentor Presensi Page (FASE 2) -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h5 class="fw-bold mb-1 text-dark">
      <i class="bi bi-calendar-check-fill me-2 text-primary"></i>Rekap Presensi Peserta
    </h5>
    <p class="text-muted small mb-0">Pantau kehadiran harian seluruh peserta magang (WFO, WFH, Izin, Sakit)</p>
  </div>
  <div class="d-flex align-items-center gap-2">
    <button type="button" class="btn btn-outline-secondary btn-sm rounded-3 d-flex align-items-center gap-1" onclick="window.print()">
      <i class="bi bi-printer"></i>
      <span class="d-none d-sm-inline">Cetak Rekap</span>
    </button>
  </div>
</div>

<!-- Flash Messages -->
<% if (typeof messages !== 'undefined' && messages.length > 0) { %>
  <% messages.forEach(msg => { %>
    <div class="alert alert-<%= msg.type %> alert-dismissible fade show border-0 rounded-3 small py-2 px-3 mb-3" role="alert">
      <i class="bi bi-<%= msg.type === 'success' ? 'check-circle' : 'exclamation-circle' %> me-2"></i>
      <%= msg.text %>
      <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% }) %>
<% } %>

<!-- Summary Statistics Cards -->
<% if (typeof stats !== 'undefined') { %>
  <div class="row g-3 mb-4">
    <!-- Total Data Terpilih -->
    <div class="col-6 col-md-4 col-lg-2">
      <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white">
        <div class="text-muted small mb-1" style="font-size: 0.75rem;">Total Presensi</div>
        <div class="d-flex align-items-center justify-content-between">
          <h4 class="fw-bold mb-0 text-dark"><%= stats.total %></h4>
          <span class="badge bg-light text-muted rounded-pill px-2 py-1"><i class="bi bi-list-check"></i></span>
        </div>
      </div>
    </div>

    <!-- WFO -->
    <div class="col-6 col-md-4 col-lg-2">
      <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white border-start border-3 border-success">
        <div class="text-success small fw-semibold mb-1" style="font-size: 0.75rem;">🏢 WFO</div>
        <div class="d-flex align-items-center justify-content-between">
          <h4 class="fw-bold mb-0 text-success"><%= stats.wfoCount %></h4>
          <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2 py-1">Aktif</span>
        </div>
      </div>
    </div>

    <!-- WFH -->
    <div class="col-6 col-md-4 col-lg-2">
      <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white border-start border-3 border-info">
        <div class="text-info small fw-semibold mb-1" style="font-size: 0.75rem;">🏠 WFH</div>
        <div class="d-flex align-items-center justify-content-between">
          <h4 class="fw-bold mb-0 text-info"><%= stats.wfhCount %></h4>
          <span class="badge bg-info bg-opacity-10 text-info rounded-pill px-2 py-1">Aktif</span>
        </div>
      </div>
    </div>

    <!-- IZIN -->
    <div class="col-6 col-md-4 col-lg-2">
      <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white border-start border-3 border-warning">
        <div class="text-warning small fw-semibold mb-1" style="font-size: 0.75rem;">📋 Izin</div>
        <div class="d-flex align-items-center justify-content-between">
          <h4 class="fw-bold mb-0 text-warning"><%= stats.izinCount %></h4>
          <span class="badge bg-warning bg-opacity-20 text-dark rounded-pill px-2 py-1">Izin</span>
        </div>
      </div>
    </div>

    <!-- SAKIT -->
    <div class="col-6 col-md-4 col-lg-2">
      <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white border-start border-3 border-danger">
        <div class="text-danger small fw-semibold mb-1" style="font-size: 0.75rem;">🏥 Sakit</div>
        <div class="d-flex align-items-center justify-content-between">
          <h4 class="fw-bold mb-0 text-danger"><%= stats.sakitCount %></h4>
          <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-2 py-1">Sakit</span>
        </div>
      </div>
    </div>

    <!-- Total Hari Aktif -->
    <div class="col-6 col-md-4 col-lg-2">
      <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white border-start border-3 border-primary">
        <div class="text-primary small fw-semibold mb-1" style="font-size: 0.75rem;">⭐ Hari Aktif</div>
        <div class="d-flex align-items-center justify-content-between">
          <h4 class="fw-bold mb-0 text-primary"><%= stats.activeDaysCount %></h4>
          <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-2 py-1">WFO+WFH</span>
        </div>
      </div>
    </div>
  </div>
<% } %>

<!-- Filter Bar -->
<div class="card border-0 shadow-sm mb-4 rounded-3">
  <div class="card-body p-3">
    <form method="GET" action="/mentor/presensi" class="row g-2 align-items-end">
      <!-- Tanggal -->
      <div class="col-12 col-md-3">
        <label class="form-label small fw-semibold mb-1 text-dark">Pilih Tanggal</label>
        <input 
          type="date" 
          class="form-control form-control-sm" 
          name="date" 
          value="<%= filters.date === 'all' ? '' : (filters.date || '') %>" 
        />
      </div>

      <!-- Quick Preset Tanggal -->
      <div class="col-12 col-md-2">
        <label class="form-label small fw-semibold mb-1 text-dark">Preset Cepat</label>
        <div class="btn-group btn-group-sm w-100" role="group">
          <a href="/mentor/presensi?date=<%= typeof todayStr !== 'undefined' ? todayStr : '' %>" class="btn btn-outline-secondary <%= filters.date !== 'all' && filters.date ? 'active' : '' %>">Hari Ini</a>
          <a href="/mentor/presensi?date=all" class="btn btn-outline-secondary <%= filters.date === 'all' ? 'active' : '' %>">Semua</a>
        </div>
      </div>

      <!-- Jenis Peserta -->
      <div class="col-12 col-md-3">
        <label class="form-label small fw-semibold mb-1 text-dark">Jenis Peserta</label>
        <select class="form-select form-select-sm" name="type">
          <option value="">Semua Jenis (Mahasiswa & SMK)</option>
          <option value="UNIVERSITY" <%= filters.type === 'UNIVERSITY' ? 'selected' : '' %>>🎓 Mahasiswa Universitas</option>
          <option value="SMK" <%= filters.type === 'SMK' ? 'selected' : '' %>>🏫 Siswa PKL SMK</option>
        </select>
      </div>

      <!-- Status Presensi -->
      <div class="col-12 col-md-2">
        <label class="form-label small fw-semibold mb-1 text-dark">Status Presensi</label>
        <select class="form-select form-select-sm" name="status">
          <option value="">Semua Status</option>
          <option value="WFO" <%= filters.status === 'WFO' ? 'selected' : '' %>>🏢 WFO (Hari Aktif)</option>
          <option value="WFH" <%= filters.status === 'WFH' ? 'selected' : '' %>>🏠 WFH (Hari Aktif)</option>
          <option value="IZIN" <%= filters.status === 'IZIN' ? 'selected' : '' %>>📋 Izin</option>
          <option value="SAKIT" <%= filters.status === 'SAKIT' ? 'selected' : '' %>>🏥 Sakit</option>
        </select>
      </div>

      <!-- Tombol Aksi -->
      <div class="col-12 col-md-2 d-flex gap-1">
        <button type="submit" class="btn btn-primary btn-sm flex-grow-1 rounded-3">
          <i class="bi bi-funnel me-1"></i>Filter
        </button>
        <a href="/mentor/presensi" class="btn btn-light btn-sm border rounded-3" title="Reset Filter">
          <i class="bi bi-arrow-clockwise"></i>
        </a>
      </div>
    </form>
  </div>
</div>

<!-- Table Presensi -->
<div class="card border-0 shadow-sm rounded-3">
  <div class="card-body p-0">
    <% if (presences.length === 0) { %>
      <div class="text-center py-5">
        <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center p-3 mb-3" style="width: 64px; height: 64px;">
          <i class="bi bi-calendar-x text-muted fs-3"></i>
        </div>
        <h6 class="fw-bold text-dark mb-1">Tidak Ada Data Presensi</h6>
        <p class="text-muted small mb-3">Tidak ditemukan catatan presensi untuk kriteria filter yang dipilih.</p>
        <a href="/mentor/presensi?date=all" class="btn btn-outline-primary btn-sm rounded-3">
          <i class="bi bi-eye me-1"></i>Lihat Semua Presensi
        </a>
      </div>
    <% } else { %>
      <!-- Desktop: Table View -->
      <div class="d-none d-md-block">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-4" style="width: 50px;">#</th>
                <th>Nama Peserta</th>
                <th>Jenis / Instansi</th>
                <th>Tanggal Presensi</th>
                <th>Status</th>
                <th>Kategori Hari</th>
                <th class="pe-4">Keterangan / Catatan</th>
              </tr>
            </thead>
            <tbody>
              <% presences.forEach((p, idx) => { %>
                <tr>
                  <td class="ps-4 text-muted small"><%= idx + 1 %></td>
                  <td>
                    <div class="d-flex align-items-center gap-2">
                      <% if (p.user.profilePhoto) { %>
                        <img src="/uploads/<%= p.user.profilePhoto %>" alt="<%= p.user.fullName %>" class="rounded-circle" style="width: 34px; height: 34px; object-fit: cover;" />
                      <% } else { %>
                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-bold small" style="width: 34px; height: 34px; font-size: 13px;">
                          <%= p.user.fullName.charAt(0).toUpperCase() %>
                        </div>
                      <% } %>
                      <div>
                        <div class="fw-semibold text-dark"><%= p.user.fullName %></div>
                        <small class="text-muted"><%= p.user.email %></small>
                      </div>
                    </div>
                  </td>
                  <td>
                    <span class="badge <%= p.user.participantType === 'UNIVERSITY' ? 'bg-primary' : 'bg-success' %> bg-opacity-10 text-<%= p.user.participantType === 'UNIVERSITY' ? 'primary' : 'success' %> rounded-pill px-2 py-0 mb-1" style="font-size: 0.7rem;">
                      <%= p.user.participantType === 'UNIVERSITY' ? 'Mahasiswa' : 'PKL SMK' %>
                    </span>
                    <div class="small text-muted text-truncate" style="max-width: 220px;">
                      <%= p.user.participantType === 'UNIVERSITY' ? (p.user.university || '-') : (p.user.schoolName || '-') %>
                    </div>
                  </td>
                  <td>
                    <div class="small fw-semibold text-dark">
                      <%= new Date(p.date).toLocaleDateString('id-ID', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' }) %>
                    </div>
                  </td>
                  <td>
                    <% if (p.status === 'WFO') { %>
                      <span class="badge bg-success bg-opacity-15 text-success border border-success border-opacity-25 rounded-pill px-3 py-1 fw-semibold">🏢 WFO</span>
                    <% } else if (p.status === 'WFH') { %>
                      <span class="badge bg-info bg-opacity-15 text-info border border-info border-opacity-25 rounded-pill px-3 py-1 fw-semibold">🏠 WFH</span>
                    <% } else if (p.status === 'IZIN') { %>
                      <span class="badge bg-warning bg-opacity-20 text-dark border border-warning border-opacity-30 rounded-pill px-3 py-1 fw-semibold">📋 Izin</span>
                    <% } else if (p.status === 'SAKIT') { %>
                      <span class="badge bg-danger bg-opacity-15 text-danger border border-danger border-opacity-25 rounded-pill px-3 py-1 fw-semibold">🏥 Sakit</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (p.status === 'WFO' || p.status === 'WFH') { %>
                      <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2 py-1 small">
                        <i class="bi bi-check-circle me-1"></i>Hari Aktif
                      </span>
                    <% } else { %>
                      <span class="badge bg-secondary bg-opacity-10 text-muted rounded-pill px-2 py-1 small">
                        <i class="bi bi-dash-circle me-1"></i>Bukan Hari Aktif
                      </span>
                    <% } %>
                  </td>
                  <td class="pe-4 text-muted small">
                    <%= p.notes || '-' %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Mobile: Card View -->
      <div class="d-md-none p-3">
        <% presences.forEach(p => { %>
          <div class="card border-0 shadow-sm mb-3 rounded-3" style="border: 1px solid #f1f5f9 !important;">
            <div class="card-body p-3">
              <div class="d-flex align-items-center justify-content-between mb-2">
                <div class="d-flex align-items-center gap-2">
                  <% if (p.user.profilePhoto) { %>
                    <img src="/uploads/<%= p.user.profilePhoto %>" alt="<%= p.user.fullName %>" class="rounded-circle" style="width: 32px; height: 32px; object-fit: cover;" />
                  <% } else { %>
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-bold small" style="width: 32px; height: 32px;">
                      <%= p.user.fullName.charAt(0).toUpperCase() %>
                    </div>
                  <% } %>
                  <div>
                    <h6 class="fw-bold mb-0 text-dark small"><%= p.user.fullName %></h6>
                    <span class="text-muted" style="font-size: 0.7rem;">
                      <%= p.user.participantType === 'UNIVERSITY' ? (p.user.university || '-') : (p.user.schoolName || '-') %>
                    </span>
                  </div>
                </div>
                <div>
                  <% if (p.status === 'WFO') { %>
                    <span class="badge bg-success bg-opacity-15 text-success rounded-pill px-2 py-1 small">🏢 WFO</span>
                  <% } else if (p.status === 'WFH') { %>
                    <span class="badge bg-info bg-opacity-15 text-info rounded-pill px-2 py-1 small">🏠 WFH</span>
                  <% } else if (p.status === 'IZIN') { %>
                    <span class="badge bg-warning bg-opacity-20 text-dark rounded-pill px-2 py-1 small">📋 Izin</span>
                  <% } else if (p.status === 'SAKIT') { %>
                    <span class="badge bg-danger bg-opacity-15 text-danger rounded-pill px-2 py-1 small">🏥 Sakit</span>
                  <% } %>
                </div>
              </div>

              <div class="d-flex justify-content-between align-items-center small text-muted pt-2 border-top">
                <span><i class="bi bi-calendar3 me-1"></i><%= new Date(p.date).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
                <span>
                  <% if (p.status === 'WFO' || p.status === 'WFH') { %>
                    <span class="text-success"><i class="bi bi-check-circle me-1"></i>Hari Aktif</span>
                  <% } else { %>
                    <span class="text-muted"><i class="bi bi-dash-circle me-1"></i>Bukan Hari Aktif</span>
                  <% } %>
                </span>
              </div>

              <% if (p.notes) { %>
                <div class="small text-muted mt-2 bg-light p-2 rounded-2">
                  <strong>Catatan:</strong> <%= p.notes %>
                </div>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

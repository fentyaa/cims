<!-- Detail Peserta -->
<div class="row mb-4">
  <div class="col-12">
    <div class="d-flex align-items-center gap-3 mb-3">
      <a href="/mentor/peserta" class="btn btn-outline-primary btn-sm rounded-3">
        <i class="bi bi-arrow-left me-1"></i>Kembali
      </a>
      <div>
        <h4 class="fw-bold text-primary mb-0">
          <i class="bi bi-person-fill me-2"></i>Detail Peserta
        </h4>
      </div>
    </div>
  </div>
</div>

<!-- Flash Messages -->
<% if (typeof messages !== 'undefined' && messages.length > 0) { %>
  <% messages.forEach(msg => { %>
    <div class="alert alert-<%= msg.type %> alert-dismissible fade show border-0 rounded-3" role="alert">
      <i class="bi bi-<%= msg.type === 'success' ? 'check-circle' : 'exclamation-circle' %> me-2"></i>
      <%= msg.text %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% }) %>
<% } %>

<div class="row g-4">
  <!-- Profile Card -->
  <div class="col-12 col-lg-4">
    <div class="card border-0 shadow-sm rounded-3 mb-4">
      <div class="card-body text-center p-4">
        <!-- Foto Profil -->
        <div class="mb-3">
          <div class="avatar-circle mx-auto d-flex align-items-center justify-content-center rounded-circle border" style="width: 120px; height: 120px; overflow: hidden;">
            <% if (participant.profilePhoto) { %>
              <img src="/uploads/<%= participant.profilePhoto %>" alt="<%= participant.fullName %>" class="w-100 h-100" style="object-fit: cover;" />
            <% } else { %>
              <i class="bi bi-person-fill text-muted" style="font-size: 3rem;"></i>
            <% } %>
          </div>
        </div>
        <h5 class="fw-bold mb-1"><%= participant.fullName %></h5>
        <p class="text-muted small mb-2"><%= participant.email %></p>

        <!-- Status Badge -->
        <div class="mb-3">
          <% if (participant.status === 'ACTIVE') { %>
            <span class="badge bg-success fs-6">Active</span>
          <% } else if (participant.status === 'PENDING') { %>
            <span class="badge bg-warning text-dark fs-6">Pending</span>
          <% } else if (participant.status === 'REJECTED') { %>
            <span class="badge bg-danger fs-6">Rejected</span>
          <% } else if (participant.status === 'ARCHIVED') { %>
            <span class="badge bg-secondary fs-6">Archived</span>
          <% } %>
        </div>

        <!-- Action Buttons -->
        <div class="d-flex gap-2 justify-content-center">
          <a href="/mentor/peserta/<%= participant.id %>/edit" class="btn btn-warning btn-sm rounded-3">
            <i class="bi bi-pencil me-1"></i>Edit
          </a>
          <% if (participant.status === 'ACTIVE') { %>
            <form method="POST" action="/mentor/peserta/<%= participant.id %>/status" class="d-inline" onsubmit="return confirm('Arsipkan peserta ini?')">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="status" value="ARCHIVED" />
              <button type="submit" class="btn btn-secondary btn-sm rounded-3">
                <i class="bi bi-archive me-1"></i>Arsipkan
              </button>
            </form>
          <% } else if (participant.status === 'ARCHIVED') { %>
            <form method="POST" action="/mentor/peserta/<%= participant.id %>/status" class="d-inline" onsubmit="return confirm('Aktifkan kembali peserta ini?')">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="status" value="ACTIVE" />
              <button type="submit" class="btn btn-success btn-sm rounded-3">
                <i class="bi bi-check-circle me-1"></i>Aktifkan
              </button>
            </form>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Gamification & Streak Hub (Mentor Monitoring) -->
    <% if (typeof gamificationStats !== 'undefined' && gamificationStats) { %>
      <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-transparent border-bottom-0 pt-3 px-3">
          <h6 class="fw-bold mb-0 text-dark">
            <i class="bi bi-fire text-danger me-2"></i>Konsistensi & Streak
          </h6>
        </div>
        <div class="card-body p-3">
          <div class="row g-2 text-center mb-3">
            <div class="col-6">
              <div class="p-2 rounded-3 bg-light border">
                <small class="text-muted d-block" style="font-size: 0.75rem;">Streak Aktif</small>
                <span class="fw-bold text-danger fs-5">🔥 <%= gamificationStats.currentStreak %></span>
                <small class="text-muted d-block" style="font-size: 0.7rem;">Hari Beruntun</small>
              </div>
            </div>
            <div class="col-6">
              <div class="p-2 rounded-3 bg-light border">
                <small class="text-muted d-block" style="font-size: 0.75rem;">Rekor Streak</small>
                <span class="fw-bold text-warning fs-5">🏆 <%= gamificationStats.bestStreak %></span>
                <small class="text-muted d-block" style="font-size: 0.7rem;">Hari Puncak</small>
              </div>
            </div>
            <div class="col-6">
              <div class="p-2 rounded-3 bg-light border">
                <small class="text-muted d-block" style="font-size: 0.75rem;">Hari Aktif</small>
                <span class="fw-bold text-primary fs-5">📅 <%= gamificationStats.activeDays %></span>
                <small class="text-muted d-block" style="font-size: 0.7rem;">WFO / WFH</small>
              </div>
            </div>
            <div class="col-6">
              <div class="p-2 rounded-3 bg-light border">
                <small class="text-muted d-block" style="font-size: 0.75rem;">Logbook</small>
                <span class="fw-bold text-success fs-5">📝 <%= gamificationStats.totalLogbooks %></span>
                <small class="text-muted d-block" style="font-size: 0.7rem;">Tercatat</small>
              </div>
            </div>
          </div>

          <% if (gamificationStats.achievements && gamificationStats.achievements.length > 0) { %>
            <div class="border-top pt-2">
              <small class="fw-semibold text-muted d-block mb-2">Lencana Pencapaian:</small>
              <div class="d-flex flex-wrap gap-1">
                <% gamificationStats.achievements.forEach(a => { %>
                  <span class="badge <%= a.unlocked ? 'bg-primary bg-opacity-10 text-primary border border-primary' : 'bg-light text-muted border' %> rounded-pill py-1 px-2" style="font-size: 0.75rem;" title="<%= a.description %>">
                    <%= a.icon %> <%= a.title %>
                  </span>
                <% }) %>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>

  <!-- Detail Info -->
  <div class="col-12 col-lg-8">
    <div class="card border-0 shadow-sm rounded-3">
      <div class="card-header bg-transparent border-bottom-0 pt-3 px-4">
        <h5 class="fw-bold mb-0">
          <i class="bi bi-info-circle me-2"></i>Informasi Peserta
        </h5>
      </div>
      <div class="card-body p-4">
        <div class="row g-3">
          <!-- Nama -->
          <div class="col-12 col-md-6">
            <label class="small text-muted fw-semibold">Nama Lengkap</label>
            <p class="fw-semibold mb-0"><%= participant.fullName %></p>
          </div>

          <!-- Email -->
          <div class="col-12 col-md-6">
            <label class="small text-muted fw-semibold">Email</label>
            <p class="mb-0"><%= participant.email %></p>
          </div>

          <!-- Nomor HP -->
          <div class="col-12 col-md-6">
            <label class="small text-muted fw-semibold">Nomor HP</label>
            <p class="mb-0"><%= participant.phoneNumber %></p>
          </div>

          <!-- Jenis Peserta -->
          <div class="col-12 col-md-6">
            <label class="small text-muted fw-semibold">Jenis Peserta</label>
            <p class="mb-0">
              <span class="badge bg-info bg-opacity-10 text-info">
                <%= participant.participantType === 'UNIVERSITY' ? 'Mahasiswa' : 'PKL SMK' %>
              </span>
            </p>
          </div>

          <!-- Field berdasarkan jenis -->
          <% if (participant.participantType === 'UNIVERSITY') { %>
            <div class="col-12 col-md-6">
              <label class="small text-muted fw-semibold">Universitas</label>
              <p class="mb-0"><%= participant.university || '-' %></p>
            </div>
            <div class="col-12 col-md-6">
              <label class="small text-muted fw-semibold">Program Studi</label>
              <p class="mb-0"><%= participant.studyProgram || '-' %></p>
            </div>
            <div class="col-12 col-md-6">
              <label class="small text-muted fw-semibold">NIM</label>
              <p class="mb-0"><%= participant.studentId || '-' %></p>
            </div>
          <% } else { %>
            <div class="col-12 col-md-6">
              <label class="small text-muted fw-semibold">Sekolah</label>
              <p class="mb-0"><%= participant.schoolName || '-' %></p>
            </div>
            <div class="col-12 col-md-6">
              <label class="small text-muted fw-semibold">Jurusan</label>
              <p class="mb-0"><%= participant.major || '-' %></p>
            </div>
            <div class="col-12 col-md-6">
              <label class="small text-muted fw-semibold">Kelas</label>
              <p class="mb-0"><%= participant.classGrade || '-' %></p>
            </div>
          <% } %>

          <!-- Informasi Magang -->
          <div class="col-12">
            <hr class="my-2" />
            <h6 class="fw-bold text-primary mb-3">
              <i class="bi bi-briefcase me-2"></i>Informasi Magang
            </h6>
          </div>

          <div class="col-12 col-md-6">
            <label class="small text-muted fw-semibold">Mentor</label>
            <p class="mb-0"><%= participant.mentor ? participant.mentor.fullName : '<span class="text-muted">Belum ditentukan</span>' %></p>
          </div>

          <div class="col-12 col-md-6">
            <label class="small text-muted fw-semibold">Periode Magang</label>
            <p class="mb-0">
              <%= participant.internshipPeriod %>
              <% if (participant.internshipStartDate && participant.internshipEndDate) { %>
                <br />
                <small class="text-primary">
                  <i class="bi bi-calendar-check me-1"></i>
                  <%= new Date(participant.internshipStartDate).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %> s.d. <%= new Date(participant.internshipEndDate).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                </small>
              <% } %>
            </p>
          </div>

          <div class="col-12 col-md-6">
            <label class="small text-muted fw-semibold">Status Akun</label>
            <p class="mb-0">
              <% if (participant.status === 'ACTIVE') { %>
                <span class="badge bg-success">Active</span>
              <% } else if (participant.status === 'PENDING') { %>
                <span class="badge bg-warning text-dark">Pending</span>
              <% } else if (participant.status === 'REJECTED') { %>
                <span class="badge bg-danger">Rejected</span>
              <% } else if (participant.status === 'ARCHIVED') { %>
                <span class="badge bg-secondary">Archived</span>
              <% } %>
            </p>
          </div>

          <div class="col-12 col-md-6">
            <label class="small text-muted fw-semibold">Tanggal Daftar</label>
            <p class="mb-0"><%= new Date(participant.createdAt).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

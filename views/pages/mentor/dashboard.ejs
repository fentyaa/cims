<!-- Mentor Dashboard - Modern Visual Data-Driven UI (Anti-Text Heavy) -->

<%
  const _totalInterns = typeof totalInterns !== 'undefined' ? totalInterns : 0;
  const _activeInterns = typeof activeInterns !== 'undefined' ? activeInterns : 0;
  const _pendingApprovals = typeof pendingApprovals !== 'undefined' ? pendingApprovals : 0;
  const _archivedInterns = typeof archivedInterns !== 'undefined' ? archivedInterns : 0;

  const _presensi = typeof presensiStats !== 'undefined' ? presensiStats : {
    wfoCount: 0, wfhCount: 0, izinCount: 0, sakitCount: 0,
    activeDaysCount: 0, inactiveDaysCount: 0, totalSubmitted: 0,
    totalActiveInterns: 0, belumAbsen: 0
  };

  const _logbook = typeof logbookStats !== 'undefined' ? logbookStats : {
    total: 0, pending: 0, reviewed: 0, today: 0
  };

  const _eval = typeof evalStats !== 'undefined' ? evalStats : {
    total: 0, draft: 0, published: 0, archived: 0, unevaluated: 0, totalInterns: 0
  };

  const pendingAttentionTotal = _pendingApprovals + _logbook.pending;

  const presencePercent = _presensi.totalActiveInterns > 0
    ? Math.min(100, Math.round((_presensi.totalSubmitted / _presensi.totalActiveInterns) * 100))
    : 0;

  const logbookPercent = _logbook.total > 0
    ? Math.min(100, Math.round((_logbook.reviewed / _logbook.total) * 100))
    : (_logbook.pending === 0 ? 100 : 0);

  const evalPercent = _eval.totalInterns > 0
    ? Math.min(100, Math.round((_eval.published / _eval.totalInterns) * 100))
    : 0;

  // Visual Donut Chart Calculation (Circumference = 314.16)
  const totalBase = _presensi.totalActiveInterns || 1;
  const wfoPct = (_presensi.wfoCount / totalBase) * 100;
  const wfhPct = (_presensi.wfhCount / totalBase) * 100;
  const izinPct = (_presensi.izinCount / totalBase) * 100;
  const sakitPct = (_presensi.sakitCount / totalBase) * 100;
  const belumPct = (_presensi.belumAbsen / totalBase) * 100;

  const circumference = 314.16;
  const wfoDash = (wfoPct / 100) * circumference;
  const wfhDash = (wfhPct / 100) * circumference;
  const izinDash = (izinPct / 100) * circumference;
  const sakitDash = (sakitPct / 100) * circumference;
  const belumDash = (belumPct / 100) * circumference;

  let offset = 0;
  const wfoOffset = offset;
  offset -= wfoDash;
  const wfhOffset = offset;
  offset -= wfhDash;
  const izinOffset = offset;
  offset -= izinDash;
  const sakitOffset = offset;
  offset -= sakitDash;
  const belumOffset = offset;
%>

<!-- 1. HERO HEADER: PROMINENT & ICON-RICH -->
<div class="card border shadow-sm rounded-4 mb-4 bg-white">
  <div class="card-body p-3 p-md-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
      <div class="d-flex align-items-center gap-3">
        <!-- Prominent Mentor Avatar Icon Badge -->
        <div class="rounded-4 bg-primary bg-opacity-10 text-primary p-3 d-flex align-items-center justify-content-center shadow-sm flex-shrink-0" style="width: 54px; height: 54px;">
          <i class="bi bi-person-badge-fill fs-2"></i>
        </div>
        <div>
          <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
            <h4 class="fw-bold mb-0 text-dark">
              Selamat Datang, <%= typeof userName !== 'undefined' && userName ? userName.split(' ')[0] : 'Mentor' %> 👋
            </h4>
            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-20 rounded-pill px-2.5 py-1 small fw-semibold">
              <i class="bi bi-shield-check me-1"></i>Mentor Pembimbing
            </span>
          </div>
          <div class="text-muted small d-flex align-items-center gap-2 flex-wrap">
            <span><i class="bi bi-calendar3 me-1 text-primary"></i><span id="mentorHeroDate">Memuat tanggal...</span></span>
            <span>•</span>
            <span><i class="bi bi-people-fill me-1 text-primary"></i><strong><%= _activeInterns %></strong> Peserta Aktif</span>
            <span>•</span>
            <span><i class="bi bi-person-lines-fill me-1 text-primary"></i><strong><%= _totalInterns %></strong> Terdaftar</span>
          </div>
        </div>
      </div>

      <!-- Session Info Indicator -->
      <div class="d-flex align-items-center gap-2 flex-wrap">
        <span class="badge bg-light text-secondary border px-3 py-2 rounded-3 small fw-medium">
          <i class="bi bi-shield-lock me-1 text-primary"></i>Sesi Mentor Aktif
        </span>
      </div>
    </div>
  </div>
</div>

<!-- 2. QUICK ACTION & WORKLOAD STRIP (CLEAN TILES, NO TEXT WALLS) -->
<div class="d-flex align-items-center justify-content-between mb-3">
  <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
    <i class="bi bi-lightning-charge-fill text-warning"></i>
    <span>Fokus & Tindakan Utama</span>
  </h6>
  <span class="badge bg-light text-muted border small">
    <i class="bi bi-shield-check text-primary me-1"></i>Panel Mentor
  </span>
</div>
<div class="row g-3 mb-4">
  <!-- Item 1: Review Logbook -->
  <div class="col-6 col-lg-3">
    <div class="card border shadow-sm rounded-4 h-100 p-3 bg-white">
      <div class="d-flex justify-content-between align-items-start mb-2">
        <div class="rounded-circle p-2 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 42px; height: 42px; background-color: rgba(245, 158, 11, 0.16); color: #f59e0b;">
          <i class="bi bi-journal-check fs-5"></i>
        </div>
        <span class="badge rounded-pill px-2.5 py-1 fw-semibold" style="background-color: rgba(245, 158, 11, 0.16); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.35);">
          <%= _logbook.pending > 0 ? _logbook.pending + ' Menunggu' : 'Beres ✓' %>
        </span>
      </div>
      <div class="fw-bold text-dark mb-0">Review Logbook</div>
      <div class="d-flex justify-content-between align-items-center mt-2">
        <span class="text-muted small"><%= _logbook.reviewed %> / <%= _logbook.total %> Selesai</span>
        <a href="/mentor/logbook" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-0" style="font-size: 0.75rem;">
          Buka <i class="bi bi-chevron-right"></i>
        </a>
      </div>
    </div>
  </div>

  <!-- Item 2: Verifikasi Pendaftaran -->
  <div class="col-6 col-lg-3">
    <div class="card border shadow-sm rounded-4 h-100 p-3 bg-white">
      <div class="d-flex justify-content-between align-items-start mb-2">
        <div class="rounded-circle p-2 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 42px; height: 42px; background-color: <%= _pendingApprovals > 0 ? 'rgba(239, 68, 68, 0.16)' : 'rgba(16, 185, 129, 0.16)' %>; color: <%= _pendingApprovals > 0 ? '#ef4444' : '#10b981' %>;">
          <i class="bi bi-person-check-fill fs-5"></i>
        </div>
        <span class="badge rounded-pill px-2.5 py-1 fw-semibold" style="background-color: <%= _pendingApprovals > 0 ? 'rgba(239, 68, 68, 0.16)' : 'rgba(16, 185, 129, 0.16)' %>; color: <%= _pendingApprovals > 0 ? '#ef4444' : '#10b981' %>; border: 1px solid <%= _pendingApprovals > 0 ? 'rgba(239, 68, 68, 0.35)' : 'rgba(16, 185, 129, 0.35)' %>;">
          <%= _pendingApprovals > 0 ? _pendingApprovals + ' Baru' : 'Lengkap ✓' %>
        </span>
      </div>
      <div class="fw-bold text-dark mb-0">Persetujuan Akun</div>
      <div class="d-flex justify-content-between align-items-center mt-2">
        <span class="text-muted small"><%= _activeInterns %> Aktif</span>
        <a href="/auth/approval" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-0" style="font-size: 0.75rem;">
          Tinjau <i class="bi bi-chevron-right"></i>
        </a>
      </div>
    </div>
  </div>

  <!-- Item 3: Presensi Hari Ini -->
  <div class="col-6 col-lg-3">
    <div class="card border shadow-sm rounded-4 h-100 p-3 bg-white">
      <div class="d-flex justify-content-between align-items-start mb-2">
        <div class="rounded-circle p-2 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 42px; height: 42px; background-color: rgba(37, 99, 235, 0.16); color: #3b82f6;">
          <i class="bi bi-calendar-check-fill fs-5"></i>
        </div>
        <span class="badge rounded-pill px-2.5 py-1 fw-semibold" style="background-color: rgba(37, 99, 235, 0.16); color: #3b82f6; border: 1px solid rgba(37, 99, 235, 0.35);">
          <%= presencePercent %>% Hadir
        </span>
      </div>
      <div class="fw-bold text-dark mb-0">Presensi Hari Ini</div>
      <div class="d-flex justify-content-between align-items-center mt-2">
        <span class="text-muted small"><%= _presensi.totalSubmitted %> / <%= _presensi.totalActiveInterns %> Peserta</span>
        <a href="/mentor/presensi" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-0" style="font-size: 0.75rem;">
          Rekap <i class="bi bi-chevron-right"></i>
        </a>
      </div>
    </div>
  </div>

  <!-- Item 4: Penilaian Akhir -->
  <div class="col-6 col-lg-3">
    <div class="card border shadow-sm rounded-4 h-100 p-3 bg-white">
      <div class="d-flex justify-content-between align-items-start mb-2">
        <div class="rounded-circle p-2 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 42px; height: 42px; background-color: rgba(14, 165, 233, 0.16); color: #0ea5e9;">
          <i class="bi bi-award-fill fs-5"></i>
        </div>
        <span class="badge rounded-pill px-2.5 py-1 fw-semibold" style="background-color: rgba(14, 165, 233, 0.16); color: #0ea5e9; border: 1px solid rgba(14, 165, 233, 0.35);">
          <%= _eval.published %> Terbit
        </span>
      </div>
      <div class="fw-bold text-dark mb-0">Penilaian Akhir</div>
      <div class="d-flex justify-content-between align-items-center mt-2">
        <span class="text-muted small"><%= _eval.draft %> Draft</span>
        <a href="/mentor/penilaian" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-0" style="font-size: 0.75rem;">
          Kelola <i class="bi bi-chevron-right"></i>
        </a>
      </div>
    </div>
  </div>
</div>

<!-- 3. VISUAL ANALYTICS HUB: DONUT CHART & LOGBOOK PROGRESS (ZERO TEXT WALLS) -->
<div class="row g-3 mb-4">
  <!-- Left: Visual Attendance Donut Chart -->
  <div class="col-12 col-lg-7">
    <div class="card border shadow-sm rounded-4 h-100 bg-white">
      <div class="card-header bg-transparent py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
        <div>
          <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
            <i class="bi bi-pie-chart-fill text-primary"></i>
            <span>Distribusi Kehadiran Hari Ini</span>
          </h6>
          <small class="text-muted">Komposisi status peserta magang aktif</small>
        </div>
        <a href="/mentor/presensi" class="btn btn-sm btn-link text-primary text-decoration-none fw-semibold p-0">
          Detail Rekap <i class="bi bi-arrow-right"></i>
        </a>
      </div>

      <div class="card-body p-4">
        <% if (_presensi.isRedDate) { %>
          <div class="text-center py-4">
            <i class="bi bi-calendar-x text-danger fs-1"></i>
            <h6 class="fw-bold text-danger mt-2 mb-1">Hari Libur Resmi</h6>
            <p class="text-muted small mb-0">Hari ini tidak ada aktivitas presensi kerja yang dijadwalkan.</p>
          </div>
        <% } else { %>
          <div class="row align-items-center g-4">
            <!-- Donut Chart SVG -->
            <div class="col-12 col-sm-5 text-center position-relative">
              <svg width="150" height="150" viewBox="0 0 120 120" class="mx-auto d-block">
                <!-- Background Circle -->
                <circle cx="60" cy="60" r="50" fill="none" stroke="#f1f5f9" stroke-width="14" />
                <!-- WFO Segment (Green) -->
                <% if (wfoDash > 0) { %>
                  <circle cx="60" cy="60" r="50" fill="none" stroke="#10b981" stroke-width="14"
                    stroke-dasharray="<%= wfoDash %> <%= circumference %>" stroke-dashoffset="<%= wfoOffset %>" stroke-linecap="round" />
                <% } %>
                <!-- WFH Segment (Teal/Blue) -->
                <% if (wfhDash > 0) { %>
                  <circle cx="60" cy="60" r="50" fill="none" stroke="#0ea5e9" stroke-width="14"
                    stroke-dasharray="<%= wfhDash %> <%= circumference %>" stroke-dashoffset="<%= wfhOffset %>" stroke-linecap="round" />
                <% } %>
                <!-- Izin Segment (Amber) -->
                <% if (izinDash > 0) { %>
                  <circle cx="60" cy="60" r="50" fill="none" stroke="#f59e0b" stroke-width="14"
                    stroke-dasharray="<%= izinDash %> <%= circumference %>" stroke-dashoffset="<%= izinOffset %>" stroke-linecap="round" />
                <% } %>
                <!-- Sakit Segment (Red) -->
                <% if (sakitDash > 0) { %>
                  <circle cx="60" cy="60" r="50" fill="none" stroke="#ef4444" stroke-width="14"
                    stroke-dasharray="<%= sakitDash %> <%= circumference %>" stroke-dashoffset="<%= sakitOffset %>" stroke-linecap="round" />
                <% } %>
                <!-- Belum Absen Segment (Gray) -->
                <% if (belumDash > 0) { %>
                  <circle cx="60" cy="60" r="50" fill="none" stroke="#cbd5e1" stroke-width="14"
                    stroke-dasharray="<%= belumDash %> <%= circumference %>" stroke-dashoffset="<%= belumOffset %>" />
                <% } %>
              </svg>
              <!-- Center Metric Text -->
              <div class="position-absolute top-50 start-50 translate-middle text-center" style="pointer-events: none;">
                <div class="fw-bold fs-4 text-dark mb-0"><%= presencePercent %>%</div>
                <small class="text-muted" style="font-size: 0.65rem;">Hadir</small>
              </div>
            </div>

            <!-- Visual Legend Badges -->
            <div class="col-12 col-sm-7">
              <div class="d-flex flex-column gap-2">
                <!-- WFO -->
                <div class="d-flex align-items-center justify-content-between p-2 rounded-3 bg-light">
                  <div class="d-flex align-items-center gap-2 small">
                    <i class="bi bi-building text-success fs-6"></i>
                    <span class="fw-semibold text-dark">WFO (Kantor)</span>
                  </div>
                  <span class="badge rounded-pill fw-bold px-2.5 py-1" style="background-color: rgba(16, 185, 129, 0.16); color: #10b981;"><%= _presensi.wfoCount %> Peserta</span>
                </div>

                <!-- WFH -->
                <div class="d-flex align-items-center justify-content-between p-2 rounded-3 bg-light">
                  <div class="d-flex align-items-center gap-2 small">
                    <i class="bi bi-house-door text-info fs-6"></i>
                    <span class="fw-semibold text-dark">WFH (Rumah)</span>
                  </div>
                  <span class="badge rounded-pill fw-bold px-2.5 py-1" style="background-color: rgba(14, 165, 233, 0.16); color: #0ea5e9;"><%= _presensi.wfhCount %> Peserta</span>
                </div>

                <!-- Izin / Sakit -->
                <div class="d-flex align-items-center justify-content-between p-2 rounded-3 bg-light">
                  <div class="d-flex align-items-center gap-2 small">
                    <i class="bi bi-heart-pulse text-warning fs-6"></i>
                    <span class="fw-semibold text-dark">Izin / Sakit</span>
                  </div>
                  <span class="badge rounded-pill fw-bold px-2.5 py-1" style="background-color: rgba(245, 158, 11, 0.16); color: #f59e0b;"><%= _presensi.izinCount + _presensi.sakitCount %> Peserta</span>
                </div>

                <!-- Belum Presensi -->
                <div class="d-flex align-items-center justify-content-between p-2 rounded-3 bg-light">
                  <div class="d-flex align-items-center gap-2 small">
                    <i class="bi bi-clock-history text-muted fs-6"></i>
                    <span class="fw-semibold text-muted">Belum Presensi</span>
                  </div>
                  <span class="badge rounded-pill fw-bold px-2.5 py-1" style="background-color: rgba(100, 116, 139, 0.16); color: #94a3b8;"><%= _presensi.belumAbsen %> Peserta</span>
                </div>
              </div>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Right: Review Logbook & Penilaian Gauges -->
  <div class="col-12 col-lg-5">
    <div class="card border shadow-sm rounded-4 h-100 bg-white">
      <div class="card-header bg-transparent py-3 px-4 border-bottom">
        <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
          <i class="bi bi-speedometer2 text-primary"></i>
          <span>Indikator Capaian Evaluasi</span>
        </h6>
      </div>
      <div class="card-body p-4 d-flex flex-column justify-content-between gap-3">
        <!-- Logbook Gauge Card -->
        <div class="p-3 rounded-4 border bg-card-subtle">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <span class="small fw-bold text-dark d-flex align-items-center gap-2">
              <i class="bi bi-journal-text text-warning"></i>
              <span>Pemeriksaan Jurnal Logbook</span>
            </span>
            <span class="badge <%= _logbook.pending > 0 ? 'bg-warning text-dark' : 'bg-success text-white' %> rounded-pill small">
              <%= logbookPercent %>% Selesai
            </span>
          </div>
          <div class="progress rounded-pill my-2" style="height: 6px;">
            <div class="progress-bar <%= _logbook.pending > 0 ? 'bg-warning' : 'bg-success' %>" style="width: <%= logbookPercent %>%;"></div>
          </div>
          <div class="d-flex justify-content-between align-items-center small text-muted">
            <span><%= _logbook.reviewed %> dari <%= _logbook.total %> diperiksa</span>
            <a href="/mentor/logbook" class="text-primary text-decoration-none fw-semibold">Review &rarr;</a>
          </div>
        </div>

        <!-- Penilaian Gauge Card -->
        <div class="p-3 rounded-4 border bg-card-subtle">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <span class="small fw-bold text-dark d-flex align-items-center gap-2">
              <i class="bi bi-star-fill text-info"></i>
              <span>Publikasi Nilai Akhir Peserta</span>
            </span>
            <span class="badge bg-info text-dark rounded-pill small">
              <%= evalPercent %>% Selesai
            </span>
          </div>
          <div class="progress rounded-pill my-2" style="height: 6px;">
            <div class="progress-bar bg-info" style="width: <%= evalPercent %>%;"></div>
          </div>
          <div class="d-flex justify-content-between align-items-center small text-muted">
            <span><%= _eval.published %> dari <%= _eval.totalInterns %> dipublikasi</span>
            <a href="/mentor/penilaian" class="text-info text-decoration-none fw-semibold">Kelola &rarr;</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>



<!-- CLIENT-SIDE DATE FORMATTER -->
<script>
  (function() {
    const dateEl = document.getElementById('mentorHeroDate');
    if (dateEl) {
      try {
        const today = new Date();
        const options = { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' };
        dateEl.textContent = today.toLocaleDateString('id-ID', options);
      } catch (e) {
        dateEl.textContent = new Date().toDateString();
      }
    }
  })();
</script>

<!-- Buat Penilaian Baru -->
<div class="row mb-4">
  <div class="col-12">
    <div class="d-flex align-items-center gap-3 mb-3">
      <a href="/mentor/penilaian" class="btn btn-outline-primary btn-sm rounded-3">
        <i class="bi bi-arrow-left me-1"></i>Kembali
      </a>
      <div>
        <h5 class="fw-bold text-primary mb-0">
          <i class="bi bi-star-fill me-2"></i>Buat Penilaian
        </h5>
        <p class="text-muted small mb-0">
          Penilaian untuk: <strong><%= typeof participant !== 'undefined' ? participant.fullName : '-' %></strong>
        </p>
      </div>
    </div>
  </div>
</div>

<!-- Participant Info Card -->
<% if (typeof participant !== 'undefined') { %>
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
      <div class="row g-3">
        <div class="col-12 col-md-6">
          <small class="text-muted d-block">Nama Lengkap</small>
          <span class="fw-semibold"><%= participant.fullName %></span>
        </div>
        <div class="col-12 col-md-6">
          <small class="text-muted d-block">Email</small>
          <span class="fw-semibold"><%= participant.email %></span>
        </div>
        <div class="col-12 col-md-6">
          <small class="text-muted d-block">Jenis Peserta</small>
          <span class="badge bg-info bg-opacity-10 text-info rounded-pill">
            <%= participant.participantType === 'UNIVERSITY' ? 'Mahasiswa' : 'PKL SMK' %>
          </span>
        </div>
        <div class="col-12 col-md-6">
          <small class="text-muted d-block">Periode Magang</small>
          <span class="fw-semibold"><%= participant.internshipPeriod %></span>
        </div>
        <% if (participant.participantType === 'UNIVERSITY') { %>
          <div class="col-12 col-md-6">
            <small class="text-muted d-block">Universitas</small>
            <span class="fw-semibold"><%= participant.university || '-' %></span>
          </div>
          <div class="col-12 col-md-6">
            <small class="text-muted d-block">Program Studi</small>
            <span class="fw-semibold"><%= participant.studyProgram || '-' %></span>
          </div>
        <% } else { %>
          <div class="col-12 col-md-6">
            <small class="text-muted d-block">Sekolah</small>
            <span class="fw-semibold"><%= participant.schoolName || '-' %></span>
          </div>
          <div class="col-12 col-md-6">
            <small class="text-muted d-block">Jurusan</small>
            <span class="fw-semibold"><%= participant.major || '-' %></span>
          </div>
        <% } %>
      </div>
    </div>
  </div>
<% } %>

<!-- Error Messages -->
<% if (typeof errors !== 'undefined' && errors.length > 0) { %>
  <div class="alert alert-danger alert-dismissible fade show border-0 rounded-3" role="alert">
    <i class="bi bi-exclamation-triangle me-2"></i>
    <ul class="mb-0 ps-3 small">
      <% errors.forEach(err => { %>
        <li><%= err %></li>
      <% }) %>
    </ul>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<!-- Evaluation Form -->
<div class="card border-0 shadow-sm">
  <div class="card-body p-4">
    <form action="/mentor/penilaian/buat/<%= participant.id %>" method="POST" class="needs-validation" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <!-- Nilai Kategori -->
      <h6 class="fw-bold mb-3"><i class="bi bi-sliders me-2 text-primary"></i>Nilai Kategori (0-100)</h6>

      <div class="row g-4 mb-4">
        <div class="col-12 col-md-6 col-lg-4">
          <label class="form-label fw-semibold small">Kedisiplinan <span class="text-danger">*</span></label>
          <input
            type="text"
            inputmode="decimal"
            class="form-control form-control-lg bg-light score-input"
            name="discipline"
            value="<%= typeof formData !== 'undefined' && formData.discipline !== undefined ? formData.discipline : '' %>"
            required
            placeholder="0-100 (misal: 85 atau 85,5)"
          />
          <div class="invalid-feedback">Nilai harus antara 0-100.</div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
          <label class="form-label fw-semibold small">Tanggung Jawab <span class="text-danger">*</span></label>
          <input
            type="text"
            inputmode="decimal"
            class="form-control form-control-lg bg-light score-input"
            name="responsibility"
            value="<%= typeof formData !== 'undefined' && formData.responsibility !== undefined ? formData.responsibility : '' %>"
            required
            placeholder="0-100 (misal: 85 atau 85,5)"
          />
          <div class="invalid-feedback">Nilai harus antara 0-100.</div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
          <label class="form-label fw-semibold small">Komunikasi <span class="text-danger">*</span></label>
          <input
            type="text"
            inputmode="decimal"
            class="form-control form-control-lg bg-light score-input"
            name="communication"
            value="<%= typeof formData !== 'undefined' && formData.communication !== undefined ? formData.communication : '' %>"
            required
            placeholder="0-100 (misal: 85 atau 85,5)"
          />
          <div class="invalid-feedback">Nilai harus antara 0-100.</div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
          <label class="form-label fw-semibold small">Kerjasama Tim <span class="text-danger">*</span></label>
          <input
            type="text"
            inputmode="decimal"
            class="form-control form-control-lg bg-light score-input"
            name="teamwork"
            value="<%= typeof formData !== 'undefined' && formData.teamwork !== undefined ? formData.teamwork : '' %>"
            required
            placeholder="0-100 (misal: 85 atau 85,5)"
          />
          <div class="invalid-feedback">Nilai harus antara 0-100.</div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
          <label class="form-label fw-semibold small">Inisiatif <span class="text-danger">*</span></label>
          <input
            type="text"
            inputmode="decimal"
            class="form-control form-control-lg bg-light score-input"
            name="initiative"
            value="<%= typeof formData !== 'undefined' && formData.initiative !== undefined ? formData.initiative : '' %>"
            required
            placeholder="0-100 (misal: 85 atau 85,5)"
          />
          <div class="invalid-feedback">Nilai harus antara 0-100.</div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
          <label class="form-label fw-semibold small">Keterampilan Teknis <span class="text-danger">*</span></label>
          <input
            type="text"
            inputmode="decimal"
            class="form-control form-control-lg bg-light score-input"
            name="technicalSkill"
            value="<%= typeof formData !== 'undefined' && formData.technicalSkill !== undefined ? formData.technicalSkill : '' %>"
            required
            placeholder="0-100 (misal: 85 atau 85,5)"
          />
          <div class="invalid-feedback">Nilai harus antara 0-100.</div>
        </div>
      </div>

      <!-- Live Score Calculation Preview -->
      <div class="alert alert-info border-0 rounded-3 mb-4">
        <div class="d-flex align-items-center gap-3">
          <i class="bi bi-calculator fs-4"></i>
          <div>
            <small class="text-muted d-block">Simulasi Nilai Akhir & Grade</small>
            <strong>Final Score: <span id="liveFinalScore">-</span> | Grade: <span id="liveGrade">-</span></strong>
            <small class="text-muted d-block" id="scoreHelpText">Rentang nilai 0 s.d. 100 untuk setiap aspek kompetensi.</small>
          </div>
        </div>
      </div>

      <!-- Catatan Mentor -->
      <h6 class="fw-bold mb-3"><i class="bi bi-chat-dots me-2 text-primary"></i>Catatan & Rekomendasi</h6>

      <div class="row g-4 mb-4">
        <div class="col-12">
          <label class="form-label fw-semibold small">Komentar Mentor</label>
          <textarea
            class="form-control bg-light"
            name="mentorComment"
            rows="3"
            placeholder="Masukkan komentar dan evaluasi untuk peserta..."
          ><%= typeof formData !== 'undefined' && formData.mentorComment ? formData.mentorComment : '' %></textarea>
        </div>
        <div class="col-12">
          <label class="form-label fw-semibold small">Rekomendasi</label>
          <textarea
            class="form-control bg-light"
            name="recommendation"
            rows="2"
            placeholder="Rekomendasi untuk pengembangan peserta (opsional)"
          ><%= typeof formData !== 'undefined' && formData.recommendation ? formData.recommendation : '' %></textarea>
        </div>
      </div>

      <!-- Submit Buttons -->
      <div class="d-flex gap-2 justify-content-end">
        <a href="/mentor/penilaian" class="btn btn-outline-secondary rounded-3">
          <i class="bi bi-x-lg me-1"></i>Batal
        </a>
        <button type="submit" class="btn btn-primary rounded-3">
          <i class="bi bi-save me-1"></i>Simpan sebagai Draft
        </button>
      </div>
    </form>
  </div>
</div>


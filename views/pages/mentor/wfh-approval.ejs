<!-- Mentor WFH Approval Page -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h5 class="fw-bold mb-1">
      <i class="bi bi-clock me-2 text-warning"></i>Persetujuan WFH
    </h5>
    <p class="text-muted small mb-0">Setujui atau tolak pengajuan WFH peserta magang</p>
  </div>
  <div>
    <a href="/mentor/presensi" class="btn btn-outline-primary btn-sm rounded-3">
      <i class="bi bi-calendar-check me-1"></i>Presensi
    </a>
  </div>
</div>

<!-- Flash Messages -->
<% if (typeof messages !== 'undefined' && messages.length > 0) { %>
  <% messages.forEach(msg => { %>
    <div class="alert alert-<%= msg.type %> alert-dismissible fade show border-0 rounded-3" role="alert">
      <i class="bi bi-<%= msg.type === 'success' ? 'check-circle' : msg.type === 'warning' ? 'exclamation-triangle' : 'exclamation-circle' %> me-2"></i>
      <%= msg.text %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% }) %>
<% } %>

<!-- Daftar Pengajuan WFH -->
<div class="card border-0 shadow-sm">
  <div class="card-header bg-transparent py-3">
    <h6 class="fw-bold mb-0">
      <i class="bi bi-hourglass me-2 text-warning"></i>Menunggu Persetujuan
      <% if (requests.length > 0) { %>
        <span class="badge bg-warning text-dark ms-2"><%= requests.length %></span>
      <% } %>
    </h6>
  </div>
  <div class="card-body p-0">
    <% if (requests.length === 0) { %>
      <div class="text-center py-5">
        <i class="bi bi-check-all text-success" style="font-size: 3rem;"></i>
        <p class="text-muted mt-3">Tidak ada pengajuan WFH yang menunggu persetujuan.</p>
      </div>
    <% } else { %>
      <!-- Desktop: Table -->
      <div class="d-none d-md-block">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-4">Nama</th>
                <th>Tanggal</th>
                <th>Alasan</th>
                <th>Status</th>
                <th class="pe-4">Aksi</th>
              </tr>
            </thead>
            <tbody>
              <% requests.forEach(r => { %>
                <tr>
                  <td class="ps-4 fw-semibold"><%= r.user.fullName %></td>
                  <td><%= new Date(r.date).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %></td>
                  <td class="text-muted" style="max-width: 300px;">
                    <span class="d-inline-block text-truncate" style="max-width: 250px;" title="<%= r.wfhReason %>">
                      <%= r.wfhReason %>
                    </span>
                  </td>
                  <td>
                    <span class="badge bg-info bg-opacity-10 text-info">⏳ Pending</span>
                  </td>
                  <td class="pe-4">
                    <div class="d-flex gap-2">
                      <form action="/mentor/wfh-approve/<%= r.id %>" method="POST" class="d-inline">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-success btn-sm rounded-3">
                          <i class="bi bi-check-lg me-1"></i>Setujui
                        </button>
                      </form>
                      <form action="/mentor/wfh-reject/<%= r.id %>" method="POST" class="d-inline">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-3">
                          <i class="bi bi-x-lg me-1"></i>Tolak
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Mobile: Card Layout -->
      <div class="d-md-none p-3">
        <% requests.forEach(r => { %>
          <div class="card border-0 bg-light mb-2 rounded-3">
            <div class="card-body p-3">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <strong class="small"><%= r.user.fullName %></strong>
                <span class="badge bg-info bg-opacity-10 text-info">⏳ Pending</span>
              </div>
              <div class="small text-muted mb-2">
                <div><i class="bi bi-calendar me-1"></i><%= new Date(r.date).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %></div>
                <div class="mt-1"><i class="bi bi-chat-text me-1"></i><%= r.wfhReason %></div>
              </div>
              <div class="d-flex gap-2">
                <form action="/mentor/wfh-approve/<%= r.id %>" method="POST" class="flex-grow-1">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-success btn-sm w-100 rounded-3">
                    <i class="bi bi-check-lg me-1"></i>Setujui
                  </button>
                </form>
                <form action="/mentor/wfh-reject/<%= r.id %>" method="POST" class="flex-grow-1">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-outline-danger btn-sm w-100 rounded-3">
                    <i class="bi bi-x-lg me-1"></i>Tolak
                  </button>
                </form>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

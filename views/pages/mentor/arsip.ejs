<!-- Arsip Peserta -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h5 class="fw-bold mb-1 text-dark">
      <i class="bi bi-archive-fill me-2 text-primary"></i>Arsip Peserta
    </h5>
    <p class="text-muted small mb-0">Peserta magang yang telah diarsipkan</p>
  </div>
</div>

<!-- Flash Messages -->
<% if (typeof messages !== 'undefined' && messages.length > 0) { %>
  <% messages.forEach(msg => { %>
    <div class="alert alert-<%= msg.type %> alert-dismissible fade show border-0 rounded-3" role="alert">
      <i class="bi bi-<%= msg.type === 'success' ? 'check-circle' : 'exclamation-circle' %> me-2"></i>
      <%= msg.text %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% }) %>
<% } %>

<!-- Search -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
  <div class="card-body p-3">
    <form method="GET" action="/mentor/arsip" class="row g-2 align-items-end">
      <div class="col-12 col-md-8">
        <label class="form-label small fw-semibold">Cari</label>
        <div class="input-group input-group-sm">
          <span class="input-group-text bg-light border-end-0">
            <i class="bi bi-search text-muted"></i>
          </span>
          <input
            type="text"
            class="form-control bg-light border-start-0"
            name="search"
            placeholder="Nama atau Email..."
            value="<%= filters.search %>"
          />
        </div>
      </div>
      <div class="col-6 col-md-2">
        <button type="submit" class="btn btn-primary btn-sm w-100">
          <i class="bi bi-search me-1"></i>Cari
        </button>
      </div>
      <div class="col-6 col-md-2">
        <a href="/mentor/arsip" class="btn btn-outline-secondary btn-sm w-100">
          <i class="bi bi-x-lg me-1"></i>Reset
        </a>
      </div>
    </form>
  </div>
</div>

<!-- Desktop Table -->
<div class="d-none d-md-block">
  <div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-3">Nama</th>
              <th>Email</th>
              <th>Jenis</th>
              <th>Instansi</th>
              <th>Periode</th>
              <th>Diarsipkan</th>
              <th>Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (participants.length === 0) { %>
              <tr>
                <td colspan="7" class="text-center py-5 text-muted">
                  <i class="bi bi-archive" style="font-size: 2rem;"></i>
                  <p class="mt-2 mb-0">Tidak ada data arsip.</p>
                </td>
              </tr>
            <% } else { %>
              <% participants.forEach(p => { %>
                <tr>
                  <td class="ps-3">
                    <div class="d-flex align-items-center gap-2">
                      <div class="avatar-circle bg-secondary bg-opacity-10 d-flex align-items-center justify-content-center rounded-circle" style="width: 36px; height: 36px; min-width: 36px;">
                        <i class="bi bi-person-fill text-secondary"></i>
                      </div>
                      <span class="fw-semibold"><%= p.fullName %></span>
                    </div>
                  </td>
                  <td><small><%= p.email %></small></td>
                  <td>
                    <span class="badge bg-info bg-opacity-10 text-info">
                      <%= p.participantType === 'UNIVERSITY' ? 'Mahasiswa' : 'PKL SMK' %>
                    </span>
                  </td>
                  <td><%= p.participantType === 'UNIVERSITY' ? (p.university || '-') : (p.schoolName || '-') %></td>
                  <td><small><%= p.internshipPeriod %></small></td>
                  <td><small class="text-muted"><%= new Date(p.updatedAt).toLocaleDateString('id-ID') %></small></td>
                  <td>
                    <div class="d-flex gap-1">
                      <a href="/mentor/peserta/<%= p.id %>" class="btn btn-sm btn-outline-primary rounded-3" title="Detail">
                        <i class="bi bi-eye"></i>
                      </a>
                      <form method="POST" action="/mentor/arsip/<%= p.id %>/restore" class="d-inline" onsubmit="return confirm('Kembalikan peserta ini ke status Active?')">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-sm btn-outline-success rounded-3" title="Restore">
                          <i class="bi bi-arrow-counterclockwise"></i>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Mobile Card View -->
<div class="d-md-none">
  <% if (participants.length === 0) { %>
    <div class="text-center py-5">
      <i class="bi bi-archive text-muted" style="font-size: 3rem;"></i>
      <p class="text-muted mt-2">Tidak ada data arsip.</p>
    </div>
  <% } else { %>
    <div class="row g-3">
      <% participants.forEach(p => { %>
        <div class="col-12">
          <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-3">
              <div class="d-flex align-items-center mb-2">
                <div class="avatar-circle bg-secondary bg-opacity-10 d-flex align-items-center justify-content-center rounded-circle me-2" style="width: 40px; height: 40px; min-width: 40px;">
                  <i class="bi bi-person-fill text-secondary"></i>
                </div>
                <div>
                  <h6 class="fw-bold mb-0"><%= p.fullName %></h6>
                  <small class="text-muted"><%= p.email %></small>
                </div>
              </div>
              <div class="small text-muted mb-2">
                <div><%= p.participantType === 'UNIVERSITY' ? (p.university || '-') : (p.schoolName || '-') %></div>
                <div>Periode: <%= p.internshipPeriod %></div>
              </div>
              <div class="d-flex gap-2">
                <a href="/mentor/peserta/<%= p.id %>" class="btn btn-sm btn-outline-primary flex-fill rounded-3">
                  <i class="bi bi-eye me-1"></i>Detail
                </a>
                <form method="POST" action="/mentor/arsip/<%= p.id %>/restore" class="flex-fill" onsubmit="return confirm('Kembalikan peserta ini ke status Active?')">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-sm btn-outline-success w-100 rounded-3">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Restore
                  </button>
                </form>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<!-- Pagination -->
<% if (pagination.totalPages > 0) { %>
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mt-4 gap-2">
    <small class="text-muted">
      Menampilkan <%= ((pagination.page - 1) * pagination.limit) + 1 %> - 
      <%= Math.min(pagination.page * pagination.limit, pagination.total) %> 
      dari <%= pagination.total %> arsip
    </small>
    <nav>
      <ul class="pagination pagination-sm mb-0">
        <li class="page-item <%= pagination.hasPrev ? '' : 'disabled' %>">
          <a class="page-link" href="?page=<%= pagination.page - 1 %><%= filters.search ? '&search=' + filters.search : '' %>">
            <i class="bi bi-chevron-left"></i>
          </a>
        </li>
        <% for (let i = 1; i <= pagination.totalPages; i++) { %>
          <li class="page-item <%= i === pagination.page ? 'active' : '' %>">
            <a class="page-link" href="?page=<%= i %><%= filters.search ? '&search=' + filters.search : '' %>"><%= i %></a>
          </li>
        <% } %>
        <li class="page-item <%= pagination.hasNext ? '' : 'disabled' %>">
          <a class="page-link" href="?page=<%= pagination.page + 1 %><%= filters.search ? '&search=' + filters.search : '' %>">
            <i class="bi bi-chevron-right"></i>
          </a>
        </li>
      </ul>
    </nav>
  </div>
<% } %>

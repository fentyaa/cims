<!-- Template Management -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h5 class="fw-bold mb-1 text-dark">
      <i class="bi bi-file-earmark-code-fill me-2 text-primary"></i>Kelola Template Dokumen
    </h5>
    <p class="text-muted small mb-0">Simpan dan atur format template resmi untuk pembuatan Sertifikat dan Surat Magang otomatis</p>
  </div>
  <div class="d-flex gap-2">
    <a href="/mentor/dokumen/buat" class="btn btn-success btn-sm rounded-3 fw-semibold">
      <i class="bi bi-magic me-1"></i>Buat Dokumen Otomatis
    </a>
    <a href="/mentor/dokumen/template/upload" class="btn btn-primary btn-sm rounded-3">
      <i class="bi bi-plus-circle me-1"></i>Buat / Upload Template
    </a>
  </div>
</div>

<!-- Flash Messages -->
<% if (typeof messages !== 'undefined' && messages.length > 0) { %>
  <% messages.forEach(msg => { %>
    <div class="alert alert-<%= msg.type %> alert-dismissible fade show border-0 rounded-3 small py-2 px-3 mb-3" role="alert">
      <i class="bi bi-<%= msg.type === 'success' ? 'check-circle' : 'exclamation-circle' %> me-2"></i>
      <%= msg.text %>
      <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% }) %>
<% } %>

<!-- Navigasi Cepat Modul Dokumen -->
<ul class="nav nav-pills mb-4 bg-white p-2 rounded-3 shadow-sm border gap-2">
  <li class="nav-item flex-fill">
    <a class="nav-link text-center fw-semibold rounded-3 py-2 text-dark" href="/mentor/dokumen/buat">
      <i class="bi bi-lightning-charge-fill me-1"></i>Form Buat Dokumen
    </a>
  </li>
  <li class="nav-item flex-fill">
    <a class="nav-link text-center fw-semibold rounded-3 py-2 active shadow-sm" href="/mentor/dokumen/template">
      <i class="bi bi-file-earmark-code me-1"></i>Daftar Template
    </a>
  </li>
  <li class="nav-item flex-fill">
    <a class="nav-link text-center fw-semibold rounded-3 py-2 text-dark" href="/mentor/dokumen/sertifikat">
      <i class="bi bi-patch-check me-1"></i>Sertifikat Magang
    </a>
  </li>
  <li class="nav-item flex-fill">
    <a class="nav-link text-center fw-semibold rounded-3 py-2 text-dark" href="/mentor/dokumen/surat">
      <i class="bi bi-envelope-paper me-1"></i>Surat Keterangan
    </a>
  </li>
  <li class="nav-item flex-fill">
    <a class="nav-link text-center fw-semibold rounded-3 py-2 text-dark" href="/mentor/dokumen/riwayat">
      <i class="bi bi-clock-history me-1"></i>Riwayat Terbit
    </a>
  </li>
</ul>

<!-- Placeholders Reference Guide Accordion -->
<div class="card border-0 shadow-sm mb-4 rounded-3 bg-light border">
  <div class="card-body p-3">
    <div class="d-flex align-items-center justify-content-between cursor-pointer" data-bs-toggle="collapse" data-bs-target="#placeholderGuide">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-info-circle-fill text-primary fs-5"></i>
        <div>
          <h6 class="fw-bold mb-0 text-dark">Panduan Variabel Placeholder Otomatis Database</h6>
          <small class="text-muted">Gunakan placeholder berikut dalam template, sistem akan otomatis mengisinya dari database.</small>
        </div>
      </div>
      <i class="bi bi-chevron-down text-muted"></i>
    </div>
    <div class="collapse mt-3 pt-3 border-top" id="placeholderGuide">
      <div class="row g-2 small">
        <div class="col-12 col-md-4">
          <div class="p-2 bg-white rounded border">
            <code>{{NAMA_LENGKAP}}</code> / <code>{{NAMA_PESERTA}}</code> : Nama lengkap peserta
          </div>
        </div>
        <div class="col-12 col-md-4">
          <div class="p-2 bg-white rounded border">
            <code>{{INSTANSI}}</code> : Nama Universitas / Sekolah SMK
          </div>
        </div>
        <div class="col-12 col-md-4">
          <div class="p-2 bg-white rounded border">
            <code>{{JURUSAN}}</code> / <code>{{PROGRAM_STUDI}}</code> : Program studi / Jurusan
          </div>
        </div>
        <div class="col-12 col-md-4">
          <div class="p-2 bg-white rounded border">
            <code>{{NIM_NIS}}</code> : Nomor Induk Mahasiswa / Siswa
          </div>
        </div>
        <div class="col-12 col-md-4">
          <div class="p-2 bg-white rounded border">
            <code>{{PERIODE_MAGANG}}</code> : Rentang waktu magang
          </div>
        </div>
        <div class="col-12 col-md-4">
          <div class="p-2 bg-white rounded border">
            <code>{{NILAI_AKHIR}}</code> / <code>{{GRADE}}</code> : Nilai angka & huruf
          </div>
        </div>
        <div class="col-12 col-md-4">
          <div class="p-2 bg-white rounded border">
            <code>{{PREDIKAT}}</code> : Memuaskan / Sangat Memuaskan
          </div>
        </div>
        <div class="col-12 col-md-4">
          <div class="p-2 bg-white rounded border">
            <code>{{NAMA_MENTOR}}</code> : Nama mentor pembimbing
          </div>
        </div>
        <div class="col-12 col-md-4">
          <div class="p-2 bg-white rounded border">
            <code>{{TANGGAL_CETAK}}</code> : Tanggal penerbitan dokumen
          </div>
        </div>
        <div class="col-12 col-md-4">
          <div class="p-2 bg-white rounded border">
            <code>{{NOMOR_SURAT}}</code> : Nomor registrasi resmi dokumen
          </div>
        </div>
        <div class="col-12 col-md-4">
          <div class="p-2 bg-white rounded border">
            <code>{{KOMENTAR_MENTOR}}</code> : Catatan hasil evaluasi
          </div>
        </div>
        <div class="col-12 col-md-4">
          <div class="p-2 bg-white rounded border">
            <code>{{REKOMENDASI}}</code> : Rekomendasi karir profesional
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Filter Bar -->
<div class="card border-0 shadow-sm mb-4 rounded-3">
  <div class="card-body p-3">
    <form method="GET" action="/mentor/dokumen/template" class="row g-2 align-items-end">
      <div class="col-12 col-md-4">
        <label class="form-label small fw-semibold mb-1 text-dark">Filter Jenis Dokumen</label>
        <select class="form-select form-select-sm" name="type">
          <option value="">Semua Jenis Template</option>
          <option value="CERTIFICATE" <%= activeFilter === 'CERTIFICATE' ? 'selected' : '' %>>Sertifikat Kelulusan</option>
          <option value="LETTER" <%= activeFilter === 'LETTER' ? 'selected' : '' %>>Surat Keterangan Magang</option>
        </select>
      </div>
      <div class="col-12 col-md-2">
        <button type="submit" class="btn btn-primary btn-sm w-100 rounded-3">
          <i class="bi bi-funnel me-1"></i>Filter
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Desktop Table View -->
<div class="d-none d-md-block">
  <div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-4">Nama Template</th>
              <th>Jenis Dokumen</th>
              <th>Versi</th>
              <th>Status</th>
              <th>Pembuat / Mentor</th>
              <th class="pe-4 text-end">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (templates.length === 0) { %>
              <tr>
                <td colspan="6" class="text-center py-5 text-muted">
                  <i class="bi bi-inbox fs-2"></i>
                  <p class="mt-2 mb-0">Belum ada template dokumen yang tersimpan.</p>
                  <a href="/mentor/dokumen/template/upload" class="btn btn-primary btn-sm rounded-3 mt-2">Buat Template Baru</a>
                </td>
              </tr>
            <% } else { %>
              <% templates.forEach(t => { %>
                <tr>
                  <td class="ps-4">
                    <div class="fw-semibold text-dark"><%= t.name %></div>
                    <small class="text-muted"><%= t.filePath %></small>
                  </td>
                  <td>
                    <span class="badge <%= t.documentType === 'CERTIFICATE' ? 'bg-success' : 'bg-primary' %> bg-opacity-15 text-<%= t.documentType === 'CERTIFICATE' ? 'success' : 'primary' %> rounded-pill px-2 py-1">
                      <i class="bi bi-<%= t.documentType === 'CERTIFICATE' ? 'patch-check' : 'file-text' %> me-1"></i>
                      <%= t.documentType === 'CERTIFICATE' ? 'Sertifikat' : 'Surat Magang' %>
                    </span>
                  </td>
                  <td><span class="badge bg-light text-dark border">v<%= t.version %></span></td>
                  <td>
                    <% if (t.status === 'ACTIVE') { %>
                      <span class="badge bg-success bg-opacity-15 text-success rounded-pill px-2 py-1">Aktif</span>
                    <% } else { %>
                      <span class="badge bg-secondary bg-opacity-15 text-secondary rounded-pill px-2 py-1">Nonaktif</span>
                    <% } %>
                  </td>
                  <td><small class="text-muted"><%= t.uploadedBy ? t.uploadedBy.fullName : 'Sistem' %></small></td>
                  <td class="pe-4 text-end">
                    <div class="d-inline-flex gap-1">
                      <!-- Gunakan Template Ini -->
                      <a href="/mentor/dokumen/buat?templateId=<%= t.id %>" class="btn btn-sm btn-success rounded-3" title="Gunakan Template Ini">
                        <i class="bi bi-magic me-1"></i>Gunakan
                      </a>

                      <!-- Pratinjau -->
                      <a href="/mentor/dokumen/template/preview/<%= t.id %>" target="_blank" class="btn btn-sm btn-outline-primary rounded-3" title="Pratinjau Format Template">
                        <i class="bi bi-eye"></i>
                      </a>

                      <!-- Edit -->
                      <a href="/mentor/dokumen/template/edit/<%= t.id %>" class="btn btn-sm btn-outline-secondary rounded-3" title="Edit Template">
                        <i class="bi bi-pencil"></i>
                      </a>

                      <!-- Toggle Status -->
                      <form method="POST" action="/mentor/dokumen/template/<%= t.id %>/deactivate" style="display:inline;">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-sm <%= t.status === 'ACTIVE' ? 'btn-outline-warning' : 'btn-outline-success' %> rounded-3" title="<%= t.status === 'ACTIVE' ? 'Nonaktifkan' : 'Aktifkan' %>" onclick="return confirm('Ubah status aktif template ini?')">
                          <i class="bi bi-<%= t.status === 'ACTIVE' ? 'pause-fill' : 'play-fill' %>"></i>
                        </button>
                      </form>

                      <!-- Delete -->
                      <form method="POST" action="/mentor/dokumen/template/<%= t.id %>/delete" style="display:inline;">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-3" title="Hapus Template" onclick="return confirm('Hapus template ini secara permanen?')">
                          <i class="bi bi-trash"></i>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Mobile Cards View -->
<div class="d-md-none">
  <div class="row g-3">
    <% templates.forEach(t => { %>
      <div class="col-12">
        <div class="card border-0 shadow-sm rounded-3">
          <div class="card-body p-3">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <div>
                <h6 class="fw-bold mb-0 text-dark"><%= t.name %></h6>
                <small class="text-muted">Versi <%= t.version %></small>
              </div>
              <span class="badge <%= t.status === 'ACTIVE' ? 'bg-success' : 'bg-secondary' %> rounded-pill">
                <%= t.status %>
              </span>
            </div>
            <p class="small text-muted mb-3">
              <i class="bi bi-tag me-1"></i><%= t.documentType === 'CERTIFICATE' ? 'Sertifikat Kelulusan' : 'Surat Magang' %>
            </p>
            <div class="d-grid gap-2">
              <a href="/mentor/dokumen/buat?templateId=<%= t.id %>" class="btn btn-sm btn-success rounded-3">
                <i class="bi bi-magic me-1"></i>Gunakan Template
              </a>
              <div class="d-flex gap-2">
                <a href="/mentor/dokumen/template/preview/<%= t.id %>" target="_blank" class="btn btn-sm btn-outline-primary rounded-3 flex-fill text-center">
                  <i class="bi bi-eye me-1"></i>Preview
                </a>
                <a href="/mentor/dokumen/template/edit/<%= t.id %>" class="btn btn-sm btn-outline-secondary rounded-3 flex-fill text-center">
                  <i class="bi bi-pencil me-1"></i>Edit
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</div>

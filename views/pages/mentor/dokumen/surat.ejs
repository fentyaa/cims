<!-- Generate Surat Magang (Selesai, Penerimaan, Rekomendasi) -->
<%
  const currentSubtype = typeof filters !== 'undefined' && filters.subtype ? filters.subtype : 'SELESAI';
  const subtypeTitles = {
    SELESAI: 'Surat Keterangan Selesai Magang',
    PENERIMAAN: 'Surat Penerimaan Magang (Acceptance Letter)',
    REKOMENDASI: 'Surat Rekomendasi Kerja Magang',
  };
  const activeTitle = subtypeTitles[currentSubtype] || 'Surat Magang';
%>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h5 class="fw-bold mb-1 text-dark">
      <i class="bi bi-file-earmark-text-fill me-2 text-primary"></i>Generate <%= activeTitle %>
    </h5>
    <p class="text-muted small mb-0">Cetak surat dinamis resmi berbasis data database tanpa perlu input manual</p>
  </div>
  <div class="d-flex gap-2">
    <a href="/mentor/dokumen/template" class="btn btn-outline-primary btn-sm rounded-3">
      <i class="bi bi-file-earmark-code me-1"></i>Kelola Template
    </a>
    <a href="/mentor/dokumen/riwayat" class="btn btn-outline-secondary btn-sm rounded-3">
      <i class="bi bi-clock-history me-1"></i>Riwayat Generate
    </a>
  </div>
</div>

<!-- Flash Messages -->
<% if (typeof messages !== 'undefined' && messages.length > 0) { %>
  <% messages.forEach(msg => { %>
    <div class="alert alert-<%= msg.type %> alert-dismissible fade show border-0 rounded-3 small py-2 px-3 mb-3" role="alert">
      <i class="bi bi-<%= msg.type === 'success' ? 'check-circle' : 'exclamation-circle' %> me-2"></i>
      <%= msg.text %>
      <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% }) %>
<% } %>

<!-- Navigasi Cepat Modul Dokumen -->
<ul class="nav nav-pills mb-4 bg-white p-2 rounded-3 shadow-sm border gap-2">
  <li class="nav-item flex-fill">
    <a class="nav-link text-center fw-semibold rounded-3 py-2 text-dark" href="/mentor/dokumen/buat">
      <i class="bi bi-lightning-charge-fill me-1"></i>Form Buat Dokumen
    </a>
  </li>
  <li class="nav-item flex-fill">
    <a class="nav-link text-center fw-semibold rounded-3 py-2 text-dark" href="/mentor/dokumen/template">
      <i class="bi bi-file-earmark-code me-1"></i>Daftar Template
    </a>
  </li>
  <li class="nav-item flex-fill">
    <a class="nav-link text-center fw-semibold rounded-3 py-2 text-dark" href="/mentor/dokumen/sertifikat">
      <i class="bi bi-patch-check me-1"></i>Sertifikat Magang
    </a>
  </li>
  <li class="nav-item flex-fill">
    <a class="nav-link text-center fw-semibold rounded-3 py-2 active shadow-sm" href="/mentor/dokumen/surat">
      <i class="bi bi-envelope-paper me-1"></i>Surat Keterangan
    </a>
  </li>
  <li class="nav-item flex-fill">
    <a class="nav-link text-center fw-semibold rounded-3 py-2 text-dark" href="/mentor/dokumen/riwayat">
      <i class="bi bi-clock-history me-1"></i>Riwayat Terbit
    </a>
  </li>
</ul>

<!-- Subtype Selector Tabs -->
<ul class="nav nav-pills mb-4 bg-white p-2 rounded-3 shadow-sm border gap-2">
  <li class="nav-item flex-fill">
    <a class="nav-link text-center fw-semibold rounded-3 py-2 <%= currentSubtype === 'SELESAI' ? 'active shadow-sm' : 'text-dark' %>" href="/mentor/dokumen/surat?subtype=SELESAI">
      <i class="bi bi-patch-check me-1"></i>Selesai Magang
    </a>
  </li>
  <li class="nav-item flex-fill">
    <a class="nav-link text-center fw-semibold rounded-3 py-2 <%= currentSubtype === 'PENERIMAAN' ? 'active shadow-sm' : 'text-dark' %>" href="/mentor/dokumen/surat?subtype=PENERIMAAN">
      <i class="bi bi-envelope-check me-1"></i>Penerimaan Magang
    </a>
  </li>
  <li class="nav-item flex-fill">
    <a class="nav-link text-center fw-semibold rounded-3 py-2 <%= currentSubtype === 'REKOMENDASI' ? 'active shadow-sm' : 'text-dark' %>" href="/mentor/dokumen/surat?subtype=REKOMENDASI">
      <i class="bi bi-award me-1"></i>Rekomendasi Kerja
    </a>
  </li>
</ul>

<!-- Search & Filter Bar -->
<div class="card border-0 shadow-sm mb-4 rounded-3">
  <div class="card-body p-3">
    <form method="GET" action="/mentor/dokumen/surat" class="row g-2 align-items-end">
      <input type="hidden" name="subtype" value="<%= currentSubtype %>">
      
      <div class="col-12 col-md-4">
        <label class="form-label small fw-semibold mb-1 text-dark">Cari Peserta</label>
        <div class="input-group input-group-sm">
          <span class="input-group-text bg-light border-0"><i class="bi bi-search text-primary"></i></span>
          <input
            type="text"
            class="form-control form-control-sm bg-light border-0"
            name="search"
            placeholder="Ketik nama / email / kampus..."
            value="<%= typeof filters !== 'undefined' && filters.search ? filters.search : '' %>"
          />
        </div>
      </div>

      <div class="col-6 col-md-3">
        <label class="form-label small fw-semibold mb-1 text-dark">Jenis Peserta</label>
        <select class="form-select form-select-sm" name="type">
          <option value="">Semua Jenis</option>
          <option value="UNIVERSITY" <%= typeof filters !== 'undefined' && filters.type === 'UNIVERSITY' ? 'selected' : '' %>>🎓 Mahasiswa</option>
          <option value="SMK" <%= typeof filters !== 'undefined' && filters.type === 'SMK' ? 'selected' : '' %>>🏫 PKL SMK</option>
        </select>
      </div>

      <div class="col-6 col-md-3">
        <label class="form-label small fw-semibold mb-1 text-dark">Status Akun</label>
        <select class="form-select form-select-sm" name="status">
          <option value="ACTIVE" <%= typeof filters !== 'undefined' && filters.status === 'ACTIVE' ? 'selected' : '' %>>Peserta Aktif</option>
          <option value="PENDING" <%= typeof filters !== 'undefined' && filters.status === 'PENDING' ? 'selected' : '' %>>Menunggu Persetujuan (Pending)</option>
          <option value="ARCHIVED" <%= typeof filters !== 'undefined' && filters.status === 'ARCHIVED' ? 'selected' : '' %>>Peserta Selesai / Arsip</option>
          <option value="ALL" <%= typeof filters !== 'undefined' && filters.status === 'ALL' ? 'selected' : '' %>>Semua Status</option>
        </select>
      </div>

      <div class="col-12 col-md-2 d-flex gap-1">
        <button type="submit" class="btn btn-primary btn-sm flex-grow-1 rounded-3">
          <i class="bi bi-funnel me-1"></i>Filter
        </button>
        <a href="/mentor/dokumen/surat?subtype=<%= currentSubtype %>" class="btn btn-light btn-sm border rounded-3" title="Reset">
          <i class="bi bi-arrow-clockwise"></i>
        </a>
      </div>
    </form>
  </div>
</div>

<!-- Bulk Selection Form & Table -->
<% if (typeof participants !== 'undefined' && participants.length > 0) { %>
  <form method="POST" action="/mentor/dokumen/surat/generate-bulk" id="bulkSuratForm">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="subtype" value="<%= currentSubtype %>">

    <!-- Bulk Action Bar -->
    <div class="d-flex justify-content-between align-items-center mb-3 bg-light p-2 rounded-3 border flex-wrap gap-2">
      <div class="d-flex align-items-center gap-2">
        <input type="checkbox" id="selectAllCheckbox" class="form-check-input ms-2" />
        <label for="selectAllCheckbox" class="small fw-semibold text-dark mb-0 cursor-pointer">Pilih Semua Peserta (<%= participants.length %>)</label>
      </div>
      <div class="d-flex align-items-center gap-2 flex-wrap">
        <% if (typeof templates !== 'undefined' && templates.length > 0) { %>
          <div class="d-flex align-items-center gap-1">
            <span class="small text-muted">Template:</span>
            <select class="form-select form-select-sm rounded-3" name="templateId" id="bulkTemplateSelect" style="max-width: 250px;">
              <% templates.forEach(t => { %>
                <option value="<%= t.id %>"><%= t.name %> (v<%= t.version %>)</option>
              <% }) %>
            </select>
          </div>
        <% } %>
        <button type="submit" class="btn btn-primary btn-sm rounded-3 px-3 shadow-sm" id="bulkSubmitBtn" disabled>
          <i class="bi bi-files me-1"></i>Generate <%= activeTitle %> (<span id="selectedCount">0</span> Dipilih)
        </button>
      </div>
    </div>

    <!-- Desktop Table View -->
    <div class="d-none d-md-block">
      <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th style="width: 40px;" class="ps-3">#</th>
                  <th>Peserta</th>
                  <th>Jenis / Institusi</th>
                  <th>NIM / NIS</th>
                  <th>Periode Magang</th>
                  <th>Status Akun</th>
                  <th class="pe-3 text-end" style="min-width: 140px;">Aksi</th>
                </tr>
              </thead>
              <tbody>
                <% participants.forEach(p => { %>
                  <tr>
                    <td class="ps-3">
                      <input type="checkbox" name="participantIds" value="<%= p.id %>" class="form-check-input surat-checkbox" />
                    </td>
                    <td>
                      <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-bold small" style="width: 34px; height: 34px;">
                          <%= p.fullName.charAt(0).toUpperCase() %>
                        </div>
                        <div>
                          <div class="fw-semibold text-dark"><%= p.fullName %></div>
                          <small class="text-muted"><%= p.email %></small>
                        </div>
                      </div>
                    </td>
                    <td>
                      <span class="badge <%= p.participantType === 'UNIVERSITY' ? 'bg-primary' : 'bg-success' %> bg-opacity-10 text-<%= p.participantType === 'UNIVERSITY' ? 'primary' : 'success' %> rounded-pill px-2 py-0 mb-1" style="font-size: 0.7rem;">
                        <%= p.participantType === 'UNIVERSITY' ? 'Mahasiswa' : 'PKL SMK' %>
                      </span>
                      <div class="small text-muted text-truncate" style="max-width: 200px;">
                        <%= p.participantType === 'UNIVERSITY' ? (p.university || '-') : (p.schoolName || '-') %>
                      </div>
                    </td>
                    <td><small class="text-dark"><%= p.studentId || '-' %></small></td>
                    <td><small class="text-dark"><%= p.internshipPeriod %></small></td>
                    <td>
                      <span class="badge <%= p.status === 'ACTIVE' ? 'bg-success' : p.status === 'PENDING' ? 'bg-warning text-dark' : 'bg-secondary' %> bg-opacity-15 text-<%= p.status === 'ACTIVE' ? 'success' : p.status === 'PENDING' ? 'warning' : 'secondary' %> rounded-pill px-2 py-1 small">
                        <%= p.status %>
                      </span>
                    </td>
                    <td class="pe-3 text-end">
                      <button type="button" class="btn btn-sm btn-success rounded-3 single-generate-btn" data-id="<%= p.id %>" data-name="<%= p.fullName %>">
                        <i class="bi bi-file-earmark-plus me-1"></i>Generate
                      </button>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- Mobile Card View -->
    <div class="d-md-none">
      <div class="row g-3">
        <% participants.forEach(p => { %>
          <div class="col-12">
            <div class="card border-0 shadow-sm rounded-3">
              <div class="card-body p-3">
                <div class="d-flex align-items-start gap-2 mb-2">
                  <input type="checkbox" name="participantIds" value="<%= p.id %>" class="form-check-input surat-checkbox mt-1" />
                  <div class="flex-grow-1">
                    <h6 class="fw-bold mb-0 text-dark"><%= p.fullName %></h6>
                    <small class="text-muted"><%= p.email %></small>
                  </div>
                  <span class="badge bg-light text-dark rounded-pill small"><%= p.status %></span>
                </div>
                <div class="small text-muted mb-3">
                  <div><i class="bi bi-building me-1"></i><%= p.participantType === 'UNIVERSITY' ? (p.university || '-') : (p.schoolName || '-') %></div>
                  <div><i class="bi bi-calendar3 me-1"></i><%= p.internshipPeriod %></div>
                  <div><i class="bi bi-card-text me-1"></i>NIM/NIS: <%= p.studentId || '-' %></div>
                </div>
                <div>
                  <button type="button" class="btn btn-sm btn-success rounded-3 w-100 single-generate-btn" data-id="<%= p.id %>" data-name="<%= p.fullName %>">
                    <i class="bi bi-file-earmark-plus me-1"></i>Generate <%= activeTitle %>
                  </button>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </form>
<% } else { %>
  <div class="card border-0 shadow-sm rounded-3 p-5 text-center">
    <i class="bi bi-file-earmark-excel text-muted" style="font-size: 3rem;"></i>
    <h6 class="fw-bold mt-3 text-dark">Tidak Ada Peserta</h6>
    <p class="text-muted small">Tidak ditemukan data peserta untuk filter yang dipilih.</p>
    <a href="/mentor/dokumen/surat?subtype=<%= currentSubtype %>" class="btn btn-outline-primary btn-sm mx-auto rounded-3">Reset Filter</a>
  </div>
<% } %>

<!-- Form Hidden untuk Single Generate -->
<form id="singleGenerateForm" method="POST" action="/mentor/dokumen/surat/generate" style="display: none;">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="subtype" value="<%= currentSubtype %>">
  <input type="hidden" name="participantId" id="singleParticipantId">
</form>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const selectAll = document.getElementById('selectAllCheckbox');
    const checkboxes = document.querySelectorAll('.surat-checkbox');
    const submitBtn = document.getElementById('bulkSubmitBtn');
    const countSpan = document.getElementById('selectedCount');
    const singleForm = document.getElementById('singleGenerateForm');
    const singleInput = document.getElementById('singleParticipantId');

    function updateCount() {
      const checked = document.querySelectorAll('.surat-checkbox:checked');
      if (countSpan) countSpan.textContent = checked.length;
      if (submitBtn) submitBtn.disabled = checked.length === 0;
      if (selectAll) selectAll.checked = checked.length > 0 && checked.length === checkboxes.length;
    }

    if (selectAll) {
      selectAll.addEventListener('change', function() {
        checkboxes.forEach(cb => cb.checked = selectAll.checked);
        updateCount();
      });
    }

    checkboxes.forEach(cb => {
      cb.addEventListener('change', updateCount);
    });

    document.querySelectorAll('.single-generate-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        const id = this.getAttribute('data-id');
        const name = this.getAttribute('data-name');
        if (confirm(`Generate <%= activeTitle %> untuk ${name}?`)) {
          singleInput.value = id;
          singleForm.submit();
        }
      });
    });
  });
</script>

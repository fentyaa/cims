<!-- Riwayat Generate Dokumen -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h5 class="fw-bold mb-1 text-dark">
      <i class="bi bi-clock-history me-2 text-primary"></i>Riwayat Generate Dokumen
    </h5>
    <p class="text-muted small mb-0">Arsip dan riwayat seluruh penerbitan sertifikat dan surat resmi peserta</p>
  </div>
  <div class="d-flex gap-2">
    <a href="/mentor/dokumen/sertifikat" class="btn btn-outline-primary btn-sm rounded-3">
      <i class="bi bi-patch-check me-1"></i>Sertifikat
    </a>
    <a href="/mentor/dokumen/surat" class="btn btn-outline-primary btn-sm rounded-3">
      <i class="bi bi-file-earmark-text me-1"></i>Surat Magang
    </a>
  </div>
</div>

<!-- Flash Messages -->
<% if (typeof messages !== 'undefined' && messages.length > 0) { %>
  <% messages.forEach(msg => { %>
    <div class="alert alert-<%= msg.type %> alert-dismissible fade show border-0 rounded-3 small py-2 px-3 mb-3" role="alert">
      <i class="bi bi-<%= msg.type === 'success' ? 'check-circle' : 'exclamation-circle' %> me-2"></i>
      <%= msg.text %>
      <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% }) %>
<% } %>

<!-- Navigasi Cepat Modul Dokumen -->
<ul class="nav nav-pills mb-4 bg-white p-2 rounded-3 shadow-sm border gap-2">
  <li class="nav-item flex-fill">
    <a class="nav-link text-center fw-semibold rounded-3 py-2 text-dark" href="/mentor/dokumen/buat">
      <i class="bi bi-lightning-charge-fill me-1"></i>Form Buat Dokumen
    </a>
  </li>
  <li class="nav-item flex-fill">
    <a class="nav-link text-center fw-semibold rounded-3 py-2 text-dark" href="/mentor/dokumen/template">
      <i class="bi bi-file-earmark-code me-1"></i>Daftar Template
    </a>
  </li>
  <li class="nav-item flex-fill">
    <a class="nav-link text-center fw-semibold rounded-3 py-2 text-dark" href="/mentor/dokumen/sertifikat">
      <i class="bi bi-patch-check me-1"></i>Sertifikat Magang
    </a>
  </li>
  <li class="nav-item flex-fill">
    <a class="nav-link text-center fw-semibold rounded-3 py-2 text-dark" href="/mentor/dokumen/surat">
      <i class="bi bi-envelope-paper me-1"></i>Surat Keterangan
    </a>
  </li>
  <li class="nav-item flex-fill">
    <a class="nav-link text-center fw-semibold rounded-3 py-2 active shadow-sm" href="/mentor/dokumen/riwayat">
      <i class="bi bi-clock-history me-1"></i>Riwayat Terbit
    </a>
  </li>
</ul>

<!-- Filter -->
<div class="card border-0 shadow-sm mb-4 rounded-3">
  <div class="card-body p-3">
    <form method="GET" action="/mentor/dokumen/riwayat" class="row g-2 align-items-end">
      <div class="col-12 col-md-4">
        <label class="form-label small fw-semibold mb-1 text-dark">Cari Peserta</label>
        <div class="input-group input-group-sm">
          <span class="input-group-text bg-light border-0"><i class="bi bi-search text-primary"></i></span>
          <input
            type="text"
            class="form-control form-control-sm bg-light border-0"
            name="search"
            placeholder="Cari nama peserta..."
            value="<%= typeof filters !== 'undefined' && filters.search ? filters.search : '' %>"
          />
        </div>
      </div>
      <div class="col-6 col-md-3">
        <label class="form-label small fw-semibold mb-1 text-dark">Jenis Dokumen</label>
        <select class="form-select form-select-sm" name="documentType">
          <option value="">Semua Dokumen</option>
          <option value="CERTIFICATE" <%= typeof filters !== 'undefined' && filters.documentType === 'CERTIFICATE' ? 'selected' : '' %>>Sertifikat</option>
          <option value="LETTER" <%= typeof filters !== 'undefined' && filters.documentType === 'LETTER' ? 'selected' : '' %>>Surat Magang</option>
        </select>
      </div>
      <div class="col-6 col-md-2">
        <button type="submit" class="btn btn-primary btn-sm w-100 rounded-3">
          <i class="bi bi-funnel me-1"></i>Filter
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Desktop Table -->
<div class="d-none d-md-block">
  <div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-4">Peserta</th>
              <th>Jenis Dokumen</th>
              <th>Template Digunakan</th>
              <th>Tanggal Diterbitkan</th>
              <th>Diterbitkan Oleh</th>
              <th>Status</th>
              <th class="pe-4 text-end">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (histories.length === 0) { %>
              <tr>
                <td colspan="7" class="text-center py-5 text-muted">
                  <i class="bi bi-inbox fs-2"></i>
                  <p class="mt-2 mb-0">Belum ada riwayat penerbitan dokumen.</p>
                </td>
              </tr>
            <% } else { %>
              <% histories.forEach(h => { %>
                <tr>
                  <td class="ps-4">
                    <span class="fw-semibold text-dark"><%= h.user ? h.user.fullName : '-' %></span>
                    <br />
                    <small class="text-muted"><%= h.user ? h.user.email : '-' %></small>
                  </td>
                  <td>
                    <span class="badge <%= h.documentType === 'CERTIFICATE' ? 'bg-success' : 'bg-info' %> bg-opacity-10 text-<%= h.documentType === 'CERTIFICATE' ? 'success' : 'info' %> rounded-pill px-2 py-1">
                      <%= h.documentType === 'CERTIFICATE' ? 'Sertifikat' : 'Surat Magang' %>
                    </span>
                  </td>
                  <td><small class="text-dark"><%= h.template ? h.template.name : 'Template Standar' %> v<%= h.template ? h.template.version : '1.0' %></small></td>
                  <td><small class="text-dark"><%= new Date(h.createdAt).toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></small></td>
                  <td><small class="text-muted"><%= h.generatedBy ? h.generatedBy.fullName : 'Mentor' %></small></td>
                  <td>
                    <% if (h.status === 'SUCCESS') { %>
                      <span class="badge bg-success bg-opacity-15 text-success rounded-pill px-2 py-1">Berhasil</span>
                    <% } else { %>
                      <span class="badge bg-danger bg-opacity-15 text-danger rounded-pill px-2 py-1">Gagal</span>
                    <% } %>
                  </td>
                  <td class="pe-4 text-end">
                    <div class="d-inline-flex gap-1">
                      <a href="/mentor/dokumen/view/<%= h.id %>" target="_blank" class="btn btn-sm btn-outline-primary rounded-3" title="Lihat & Cetak">
                        <i class="bi bi-printer"></i>
                      </a>
                      <a href="/mentor/dokumen/download/<%= h.id %>" class="btn btn-sm btn-outline-secondary rounded-3" title="Download">
                        <i class="bi bi-download"></i>
                      </a>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Mobile Cards -->
<div class="d-md-none">
  <% if (histories.length === 0) { %>
    <div class="text-center py-5">
      <i class="bi bi-inbox text-muted fs-2"></i>
      <p class="text-muted mt-2">Belum ada riwayat generate.</p>
    </div>
  <% } else { %>
    <div class="row g-3">
      <% histories.forEach(h => { %>
        <div class="col-12">
          <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-3">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                  <h6 class="fw-bold mb-0 text-dark"><%= h.user ? h.user.fullName : '-' %></h6>
                  <small class="text-muted"><%= h.user ? h.user.email : '-' %></small>
                </div>
                <span class="badge bg-<%= h.status === 'SUCCESS' ? 'success' : 'danger' %> bg-opacity-15 text-<%= h.status === 'SUCCESS' ? 'success' : 'danger' %> rounded-pill">
                  <%= h.status === 'SUCCESS' ? 'Berhasil' : 'Gagal' %>
                </span>
              </div>
              <div class="small text-muted mb-3">
                <div><i class="bi bi-file-earmark me-1"></i><%= h.documentType === 'CERTIFICATE' ? 'Sertifikat' : 'Surat Magang' %></div>
                <div><i class="bi bi-calendar me-1"></i><%= new Date(h.createdAt).toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></div>
              </div>
              <div class="d-flex gap-2">
                <a href="/mentor/dokumen/view/<%= h.id %>" target="_blank" class="btn btn-sm btn-outline-primary rounded-3 flex-grow-1 text-center">
                  <i class="bi bi-printer me-1"></i>Cetak
                </a>
                <a href="/mentor/dokumen/download/<%= h.id %>" class="btn btn-sm btn-outline-secondary rounded-3 flex-grow-1 text-center">
                  <i class="bi bi-download me-1"></i>Download
                </a>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<!-- Pagination -->
<% if (typeof pagination !== 'undefined' && pagination.totalPages > 1) { %>
  <nav class="mt-4">
    <ul class="pagination justify-content-center">
      <li class="page-item <%= !pagination.hasPrev ? 'disabled' : '' %>">
        <a class="page-link" href="?page=<%= pagination.page - 1 %>&search=<%= filters.search %>&documentType=<%= filters.documentType %>">
          <i class="bi bi-chevron-left"></i>
        </a>
      </li>
      <% for (let p = 1; p <= pagination.totalPages; p++) { %>
        <li class="page-item <%= p === pagination.page ? 'active' : '' %>">
          <a class="page-link" href="?page=<%= p %>&search=<%= filters.search %>&documentType=<%= filters.documentType %>"><%= p %></a>
        </li>
      <% } %>
      <li class="page-item <%= !pagination.hasNext ? 'disabled' : '' %>">
        <a class="page-link" href="?page=<%= pagination.page + 1 %>&search=<%= filters.search %>&documentType=<%= filters.documentType %>">
          <i class="bi bi-chevron-right"></i>
        </a>
      </li>
    </ul>
  </nav>
<% } %>

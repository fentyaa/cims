<!DOCTYPE html>
<html lang="id" data-bs-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Internship Management System - Kelola peserta magang dengan mudah" />
  <meta name="theme-color" content="#2563EB" />

  <!-- Theme Initializer (Prevents White Flash) -->
  <script>
    (function() {
      try {
        const savedTheme = localStorage.getItem('cims_theme');
        const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = savedTheme ? savedTheme : (systemDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-bs-theme', theme);
      } catch (e) {}
    })();
  </script>

  <!-- Preconnect & DNS-Prefetch for Fast CDN Handshake -->
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
  <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <!-- Bootstrap 5 CSS (CDN) -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
    crossorigin="anonymous"
  />

  <!-- Bootstrap Icons -->
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
  />

  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css?v=2.1" />
  <link rel="stylesheet" href="/css/auth.css?v=2.1" />

  <title><%= typeof title !== 'undefined' ? title : 'Internship Management System' %></title>
</head>
<body class="d-flex flex-column min-vh-100">
  <!-- Navbar -->
  <%- include('../partials/header', { appName: typeof appName !== 'undefined' ? appName : 'IMS' }) %>

  <!-- Main Content -->
  <main class="flex-shrink-0">
    <div class="container py-4">
      <%- body %>
    </div>
  </main>

  <!-- Footer -->
  <%- include('../partials/footer', { currentYear: typeof currentYear !== 'undefined' ? currentYear : new Date().getFullYear() }) %>

  <!-- Bootstrap 5 JS Bundle (CDN) -->
  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
    crossorigin="anonymous"
  ></script>

  <!-- Custom JS -->
  <script src="/js/main.js"></script>
</body>
</html>
